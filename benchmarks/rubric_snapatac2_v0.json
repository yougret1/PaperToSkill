{
  "schema_version": "0.1",
  "created": "2026-07-03",
  "purpose": "Deterministic v0 scoring rubric for SnapATAC2 paper-derived skills.",
  "max_score": 20,
  "criteria": [
    {
      "id": "structure",
      "description": "Required skill sections are present.",
      "max_points": 6,
      "required_sections": [
        "Source",
        "Paper Snapshot",
        "Central Contribution",
        "Inputs",
        "Workflow",
        "Validation",
        "Failure Cases",
        "Transfer Notes"
      ]
    },
    {
      "id": "source_anchoring",
      "description": "Workflow, validation, and failure sections preserve source anchors.",
      "max_points": 3,
      "anchor_pattern": "Source anchors:"
    },
    {
      "id": "workflow_coverage",
      "description": "Key SnapATAC2 workflow and algorithm concepts are present.",
      "max_points": 5,
      "keywords": [
        "matrix-free spectral embedding",
        "Lanczos",
        "preprocessing",
        "embedding/clustering",
        "IDF",
        "Nystrom",
        "multi-view spectral embedding",
        "eigenvectors",
        "runtime",
        "memory"
      ]
    },
    {
      "id": "failure_coverage",
      "description": "Known SnapATAC2 limitations, metric boundaries, and reproduction constraints are present.",
      "max_points": 4,
      "keywords": [
        "cosine",
        "memory",
        "A100 GPU",
        "ARI",
        "AMI",
        "ASW",
        "data availability",
        "code availability"
      ]
    },
    {
      "id": "compactness",
      "description": "Skill is compact enough for practical agent context.",
      "max_points": 2,
      "max_words": 1200
    }
  ]
}
