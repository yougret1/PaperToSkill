      "response_text": "{\n  \"action\": \"edit\",\n  \"path\": \"toolformer_filter.py\",\n  \"old_text\": \"\",\n  \"new_text\": \"import numpy as np\\n\\ndef filter_api_calls(with_result, call_only, no_call, tau_filter):\\n    \\\"\\\"\\\"Filter API calls based on log-probability margins.\\n\\n    Parameters\\n    ----------\\n    with_result: np.ndarray, shape (n_candidates, future_horizon), finite nonpositive log probs\\n    call_only: np.ndarray, same shape, finite nonpositive log probs\\n    no_call: np.ndarray, same shape, finite nonpositive log probs\\n    tau_filter: float, finite nonnegative threshold\\n\\n    Returns\\n    -------\\n    keep: np.ndarray of bool, shape (n_candidates,)\\n    margins: np.ndarray of float, shape (n_candidates,)\\n    \\\"\\\"\\\"\\n    # Input validation\\n    for name, arr in [('with_result', with_result), ('call_only', call_only), ('no_call', no_call)]:\\n        if not isinstance(arr, np.ndarray):\\n            raise ValueError(f'{name} must be a numpy array')\\n        if arr.ndim != 2:\\n            raise ValueError(f'{name} must be two-dimensional')\\n        if arr.shape[0] == 0 or arr.shape[1] == 0:\\n            raise ValueError(f'{name} must not be empty')\\n        if not np.issubdtype(arr.dtype, np.floating):\\n            raise ValueError(f'{name} must be floating point')\\n        if not np.all(np.isfinite(arr)):\\n            raise ValueError(f'{name} contains nonfinite values')\\n        if np.any(arr > 0):\\n            raise ValueError(f'{name} contains positive values')\\n    # Shape consistency\\n    if not (with_result.shape == call_only.shape == no_call.shape):\\n        raise ValueError('Input matrices must have the same shape')\\n    # tau_filter validation\\n    if isinstance(tau_filter, bool):\\n        raise ValueError('tau_filter must not be a boolean')\\n    if not np.isscalar(tau_filter) or not np.isfinite(tau_filter) or tau_filter < 0:\\n        raise ValueError('tau_filter must be a finite nonnegative scalar')\\n    # Compute total log probability per candidate (sum over future horizon)\\n    log_p_with = np.sum(with_result, axis=1)\\n    log_p_call = np.sum(call_only, axis=1)\\n    log_p_no = np.sum(no_call, axis=1)\\n    # Margin = improvement over best alternative (no_call or call_only)\\n    margin = log_p_with - np.maximum(log_p_call, log_p_no)\\n    # Keep if margin exceeds threshold\\n    keep = margin > tau_filter\\n    return keep, margin\\n\"\n}",
