      "response_text": "{\"action\":\"edit\",\"path\":\"toolformer_filter.py\",\"old_text\":\"\",\"new_text\":\"import numpy as np\\n\\ndef filter_api_calls(with_result, call_only, no_call, tau_filter):\\n    # Input validation\\n    for name, arr in [(\\\"with_result\\\", with_result), (\\\"call_only\\\", call_only), (\\\"no_call\\\", no_call)]:\\n        if not isinstance(arr, np.ndarray):\\n            raise ValueError(f\\\"{name} must be a numpy array\\\")\\n        if arr.ndim != 2:\\n            raise ValueError(f\\\"{name} must be a 2D matrix\\\")\\n        if arr.size == 0:\\n            raise ValueError(f\\\"{name} must not be empty\\\")\\n        if arr.shape != with_result.shape:\\n            raise ValueError(\\\"Input matrices must have the same shape\\\")\\n        if not np.all(np.isfinite(arr)):\\n            raise ValueError(f\\\"{name} contains non-finite values\\\")\\n        if np.any(arr > 0):\\n            raise ValueError(f\\\"{name} contains positive values\\\")\\n    if not isinstance(tau_filter, (int, float)) or isinstance(tau_filter, bool):\\n        raise ValueError(\\\"tau_filter must be a nonnegative numeric threshold, not boolean\\\")\\n    if tau_filter < 0:\\n        raise ValueError(\\\"tau_filter must be nonnegative\\\")\\n\\n    n, horizon = with_result.shape\\n    # Weights: linear decay with offset, clip at 0, normalize\\n    raw_weights = np.maximum(0, 1 - 0.2 * np.arange(horizon))\\n    weights = raw_weights / raw_weights.sum()  # shape (horizon,)\\n\\n    # Compute weighted negative log probability losses\\n    # Loss = - sum(weights * log_prob)\\n    loss_with = -np.sum(weights * with_result, axis=1)\\n    loss_call = -np.sum(weights * call_only, axis=1)\\n    loss_empty = -np.sum(weights * no_call, axis=1)\\n\\n    # Stronger counterfactual: min of empty and call-only\\n    L_minus = np.minimum(loss_empty, loss_call)\\n\\n    margins = L_minus - loss_with\\n    keep = margins >= tau_filter\\n\\n    return keep, margins\\n\"}",
