 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validation
+    if not isinstance(tau_filter, (int, float)) or isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must be a finite nonnegative float, not boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+    for arr, name in [(logp_with_result, 'logp_with_result'), (logp_call_only, 'logp_call_only'), (logp_no_call, 'logp_no_call')]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be 2D")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} must contain only finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} must be nonpositive")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("all input arrays must have the same shape")
+
+    # Procedure T01: normalized future-token weights
+    n_candidates, horizon = logp_with_result.shape
+    t = np.arange(horizon)
+    raw = np.maximum(0.0, 1.0 - 0.2 * t)
+    weights = raw / np.sum(raw)  # shape (horizon,)
+
+    # T02: weighted future-token loss for each scenario
+    def weighted_loss(logp):
+        return -np.sum(logp * weights, axis=1)  # shape (n_candidates,)
+
+    L_plus = weighted_loss(logp_with_result)
+    L_call_only = weighted_loss(logp_call_only)
+    L_empty = weighted_loss(logp_no_call)
+
+    # T03: stronger counterfactual baseline
+    L_minus = np.minimum(L_empty, L_call_only)
+
+    # T04: margins and keep mask
+    margins = L_minus - L_plus
+    keep = margins >= tau_filter
+
+    return keep, margins.astype(np.float64)
