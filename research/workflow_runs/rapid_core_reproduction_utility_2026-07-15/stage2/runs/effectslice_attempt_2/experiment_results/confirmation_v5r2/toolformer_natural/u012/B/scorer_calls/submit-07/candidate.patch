--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -12,5 +12,44 @@
     tau_filter: float,
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
-
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate threshold
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    try:
+        tau_filter = float(tau_filter)
+    except (TypeError, ValueError):
+        raise ValueError("tau_filter must be numeric")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite nonnegative")
+    # Validate arrays
+    for name, arr in [("logp_with_result", logp_with_result),
+                      ("logp_call_only", logp_call_only),
+                      ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be 2-dimensional")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} must contain only finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} must contain only nonpositive values")
+    shape = logp_with_result.shape
+    if logp_call_only.shape != shape or logp_no_call.shape != shape:
+        raise ValueError("All input arrays must have the same shape")
+    # Compute losses (negative log prob sum over future horizon)
+    loss_no_call = -logp_no_call
+    loss_call_only = -logp_call_only
+    loss_with_result = -logp_with_result
+    total_loss_no_call = np.sum(loss_no_call, axis=1)
+    total_loss_call_only = np.sum(loss_call_only, axis=1)
+    total_loss_with_result = np.sum(loss_with_result, axis=1)
+    # Improvement over baselines
+    imp_no_call = total_loss_no_call - total_loss_with_result
+    imp_call_only = total_loss_call_only - total_loss_with_result
+    margin = np.minimum(imp_no_call, imp_call_only)
+    keep = margin > tau_filter
+    keep = np.asarray(keep, dtype=np.bool_)
+    margin = np.asarray(margin, dtype=np.float64)
+    return keep, margin
