+    if total_raw == 0:
+        normalized_weights = np.full(future_horizon, 1.0 / future_horizon)
+    else:
+        normalized_weights = raw_weights / total_raw
+    L_plus = -np.sum(normalized_weights * logp_with_result, axis=1)
