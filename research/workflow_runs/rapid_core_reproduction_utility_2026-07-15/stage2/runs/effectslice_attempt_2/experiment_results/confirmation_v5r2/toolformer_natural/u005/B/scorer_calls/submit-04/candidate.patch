     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if not all(isinstance(arr, np.ndarray) for arr in [logp_with_result, logp_call_only, logp_no_call]):
+        raise ValueError("Inputs must be numpy arrays")
+    for arr in [logp_with_result, logp_call_only, logp_no_call]:
+        if arr.ndim != 2:
+            raise ValueError("Each input must be a two-dimensional matrix")
+        if arr.size == 0:
+            raise ValueError("Input matrices cannot be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError("All values must be finite")
+        if np.any(arr > 0):
+            raise ValueError("All values must be nonpositive")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+    # Validate threshold
+    if isinstance(tau_filter, bool):
+        raise ValueError("Boolean values are invalid thresholds")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    # Compute total log probabilities per candidate (sum over horizon)
+    total_with_result = np.sum(logp_with_result, axis=1)
+    total_call_only = np.sum(logp_call_only, axis=1)
+    total_no_call = np.sum(logp_no_call, axis=1)
+
+    # Compute margin: logp_with_result - max(logp_call_only, logp_no_call)
+    max_alternative = np.maximum(total_call_only, total_no_call)
+    margins = total_with_result - max_alternative
+
+    # Keep candidates where margin exceeds threshold
+    keep_mask = margins > tau_filter
+
+    return (keep_mask, margins)
