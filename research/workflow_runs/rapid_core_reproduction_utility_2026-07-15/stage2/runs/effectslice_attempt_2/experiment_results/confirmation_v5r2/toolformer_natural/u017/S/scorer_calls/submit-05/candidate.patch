@@ -13,4 +13,49 @@
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be boolean")
+    if not isinstance(tau_filter, (int, float)):
+        raise ValueError("tau_filter must be a finite nonnegative number")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite nonnegative")
+
+    # Validate input arrays
+    for name, arr in [
+        ("logp_with_result", logp_with_result),
+        ("logp_call_only", logp_call_only),
+        ("logp_no_call", logp_no_call),
+    ]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("Input arrays must have the same shape")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Compute normalized weights
+    t = np.arange(future_horizon, dtype=float)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    normalized_weights = raw_weights / np.sum(raw_weights)
+
+    # Compute losses: negative weighted log probability
+    L_plus = -np.sum(normalized_weights * logp_with_result, axis=1)
+    L_empty = -np.sum(normalized_weights * logp_no_call, axis=1)
+    L_call_only = -np.sum(normalized_weights * logp_call_only, axis=1)
+
+    L_minus = np.minimum(L_empty, L_call_only)
+    margin = L_minus - L_plus
+
+    keep_mask = margin >= tau_filter
+
+    return keep_mask, margin
