        "new_text": "    # Validate inputs\n    for arr in [logp_with_result, logp_call_only, logp_no_call]:\n        if not isinstance(arr, np.ndarray) or arr.ndim != 2:\n            raise ValueError(\"Input must be a 2D numpy array\")\n        if arr.size == 0:\n            raise ValueError(\"Input array must not be empty\")\n        if not np.isfinite(arr).all():\n            raise ValueError(\"Input array contains non-finite values\")\n        if (arr > 0).any():\n            raise ValueError(\"Input array contains positive values (must be nonpositive log probabilities)\")\n    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):\n        raise ValueError(\"Input arrays must have the same shape\")\n    if isinstance(tau_filter, (bool, np.bool_)):\n        raise ValueError(\"tau_filter must not be a boolean value\")\n    if not (isinstance(tau_filter, (int, float, np.floating, np.integer)) and np.isfinite(tau_filter) and tau_filter >= 0):\n        raise ValueError(\"tau_filter must be a finite nonnegative number\")\n    \n    n_candidates, future_horizon = logp_with_result.shape\n    t = np.arange(future_horizon)\n    raw_weights = np.maximum(0, 1 - 0.2 * t)\n    normalized_weights = raw_weights / raw_weights.sum()\n    \n    L_plus = -np.dot(logp_with_result, normalized_weights)\n    L_call_only = -np.dot(logp_call_only, normalized_weights)\n    L_no_call = -np.dot(logp_no_call, normalized_weights)\n    \n    L_minus = np.minimum(L_no_call, L_call_only)\n    margins = L_minus - L_plus\n    keep = margins >= tau_filter\n    return keep, margins"
