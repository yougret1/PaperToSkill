      "response_text": "{\n  \"action\": \"edit\",\n  \"path\": \"toolformer_filter.py\",\n  \"old_text\": \"    raise NotImplementedError(\\\"implement the paper-core reproduction task\\\")\",\n  \"new_text\": \"    # Validation\\n    if not isinstance(tau_filter, (int, float)) or isinstance(tau_filter, bool):\\n        raise ValueError(\\\"tau_filter must be a finite nonnegative float, not boolean\\\")\\n    if not np.isfinite(tau_filter) or tau_filter < 0:\\n        raise ValueError(\\\"tau_filter must be finite and nonnegative\\\")\\n    for arr, name in [(logp_with_result, 'logp_with_result'), (logp_call_only, 'logp_call_only'), (logp_no_call, 'logp_no_call')]:\\n        if not isinstance(arr, np.ndarray):\\n            raise ValueError(f\\\"{name} must be a numpy array\\\")\\n        if arr.ndim != 2:\\n            raise ValueError(f\\\"{name} must be 2D\\\")\\n        if arr.size == 0:\\n            raise ValueError(f\\\"{name} must not be empty\\\")\\n        if not np.isfinite(arr).all():\\n            raise ValueError(f\\\"{name} must contain only finite values\\\")\\n        if np.any(arr > 0):\\n            raise ValueError(f\\\"{name} must be nonpositive\\\")\\n    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):\\n        raise ValueError(\\\"all input arrays must have the same shape\\\")\\n\\n    # Procedure T01: normalized future-token weights\\n    n_candidates, horizon = logp_with_result.shape\\n    t = np.arange(horizon)\\n    raw = np.maximum(0.0, 1.0 - 0.2 * t)\\n    weights = raw / np.sum(raw)  # shape (horizon,)\\n\\n    # T02: weighted future-token loss for each scenario\\n    def weighted_loss(logp):\\n        return -np.sum(logp * weights, axis=1)  # shape (n_candidates,)\\n\\n    L_plus = weighted_loss(logp_with_result)\\n    L_call_only = weighted_loss(logp_call_only)\\n    L_empty = weighted_loss(logp_no_call)\\n\\n    # T03: stronger counterfactual baseline\\n    L_minus = np.minimum(L_empty, L_call_only)\\n\\n    # T04: margins and keep mask\\n    margins = L_minus - L_plus\\n    keep = margins >= tau_filter\\n\\n    return keep, margins.astype(np.float64)\"\n}",
      "action": {
