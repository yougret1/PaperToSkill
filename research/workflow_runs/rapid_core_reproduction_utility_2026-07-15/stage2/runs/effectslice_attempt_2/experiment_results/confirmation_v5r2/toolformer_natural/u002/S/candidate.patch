 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr in [logp_with_result, logp_call_only, logp_no_call]:
+        if not isinstance(arr, np.ndarray) or arr.ndim != 2:
+            raise ValueError("Input must be a 2D numpy array")
+        if arr.size == 0:
+            raise ValueError("Input array must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError("Input array contains non-finite values")
+        if (arr > 0).any():
+            raise ValueError("Input array contains positive values (must be nonpositive log probabilities)")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("Input arrays must have the same shape")
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be a boolean value")
+    if not (isinstance(tau_filter, (int, float, np.floating, np.integer)) and np.isfinite(tau_filter) and tau_filter >= 0):
+        raise ValueError("tau_filter must be a finite nonnegative number")
+    
+    n_candidates, future_horizon = logp_with_result.shape
+    t = np.arange(future_horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    normalized_weights = raw_weights / raw_weights.sum()
+    
+    L_plus = -np.dot(logp_with_result, normalized_weights)
+    L_call_only = -np.dot(logp_call_only, normalized_weights)
+    L_no_call = -np.dot(logp_no_call, normalized_weights)
+    
+    L_minus = np.minimum(L_no_call, L_call_only)
+    margins = L_minus - L_plus
+    keep = margins >= tau_filter
+    return keep, margins
