 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter cannot be boolean")
+    # Check threshold finite nonnegative
+    if not np.isscalar(tau_filter) or not np.isreal(tau_filter):
+        raise ValueError("tau_filter must be a finite nonnegative scalar")
+    tau_filter = float(tau_filter)
+    if tau_filter < 0 or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be finite and nonnegative")
+    
+    # Check matrices
+    for mat, name in [(logp_with_result, "logp_with_result"), (logp_call_only, "logp_call_only"), (logp_no_call, "logp_no_call")]:
+        if not isinstance(mat, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if mat.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if mat.shape[0] == 0 or mat.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(mat)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(mat > 0):
+            raise ValueError(f"{name} contains positive values")
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("shape mismatch among input matrices")
+    
+    n_candidates, H = logp_with_result.shape
+    
+    # Compute normalized weights
+    t = np.arange(H)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    normalized_weights = raw_weights / np.sum(raw_weights)
+    
+    # Compute weighted losses
+    loss_with_result = -np.dot(logp_with_result, normalized_weights)
+    loss_call_only = -np.dot(logp_call_only, normalized_weights)
+    loss_no_call = -np.dot(logp_no_call, normalized_weights)
+    
+    # Compute L_minus
+    L_minus = np.minimum(loss_no_call, loss_call_only)
+    
+    # Compute margins
+    margins = L_minus - loss_with_result
+    
+    # Compute keep mask (inclusive threshold tie)
+    keep = margins >= tau_filter
+    
+    return (keep, margins)
