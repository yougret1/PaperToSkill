 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # --- validation ---
+    for name, arr in [
+        ("logp_with_result", logp_with_result),
+        ("logp_call_only", logp_call_only),
+        ("logp_no_call", logp_no_call),
+    ]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy ndarray")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be 2-dimensional")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains non-finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be a finite nonnegative number")
+
+    # --- procedure ---
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # T01: normalized decreasing weights
+    t = np.arange(future_horizon)                         # offset 0,1,...
+    raw = np.maximum(0, 1 - 0.2 * t)                      # per-paper formula
+    norm_weights = raw / raw.sum()                         # normalize
+
+    # T02: weighted future-token loss for each condition
+    #     L = -sum(weight * log_prob)
+    L_plus      = -np.dot(logp_with_result,  norm_weights)
+    L_call_only = -np.dot(logp_call_only,    norm_weights)
+    L_empty     = -np.dot(logp_no_call,      norm_weights)
+
+    # T03: stronger counterfactual baseline (element-wise minimum)
+    L_minus = np.minimum(L_empty, L_call_only)
+
+    # T04: margin and keep decision
+    margin = L_minus - L_plus
+    keep   = margin >= tau_filter
+
+    return keep, margin
