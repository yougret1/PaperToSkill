      "observation_status": "ok",
      "observation_message": "1: \"\"\"Starter module for the locked SNAP-MFSE reproduction task.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import numpy as np\n6: from scipy.linalg import svd\n7: \n8: \n9: def matrix_free_spectral_embedding(\n10:     counts: np.ndarray,\n11:     n_components: int,\n12:     random_state: int = 0,\n13: ) -> tuple[np.ndarray, np.ndarray]:\n14:     \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n15: \n16:     # Validate inputs\n17:     if not np.isfinite(counts).all():\n18:         raise ValueError(\"counts contains nonfinite values\")\n19:     if (counts < 0).any():\n20:         raise ValueError(\"counts contains negative values\")\n21:     row_sums = counts.sum(axis=1)\n22:     if (row_sums == 0).any():\n23:         raise ValueError(\"counts has all-zero cell rows\")\n24:     if n_components < 1 or n_components >= counts.shape[0]:\n25:         raise ValueError(\"n_components must be 1 <= n_components < n_cells\")\n26: \n27:     # Matrix-free spectral embedding via SVD on row-normalized count matrix\n28:     scaling = 1.0 / np.sqrt(row_sums)\n29:     X = counts * scaling[:, np.newaxis]\n30: \n31:     U, s, Vt = svd(X, full_matrices=False)\n32: \n33:     # Ensure we have enough singular values\n34:     min_dim = min(X.shape)\n35:     if n_components > min_dim:\n36:         raise ValueError(f\"n_components {n_components} exceeds available dimensions {min_dim}\")\n37: \n38:     eigenvalues = s[:n_components] ** 2\n39:     eigenvectors = U[:, :n_components]\n40: \n41:     return eigenvalues, eigenvectors",
