-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if logp_with_result.ndim != 2 or logp_call_only.ndim != 2 or logp_no_call.ndim != 2:
+        raise ValueError("All logp inputs must be 2D matrices")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All logp inputs must have the same shape")
+    n_candidates, horizon = logp_with_result.shape
