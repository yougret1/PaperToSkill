+    if np.isnan(tau_filter) or np.isinf(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite nonnegative")
+
+    # Compute decreasing future-token weights
+    t = np.arange(future_horizon)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    normalized_weights = raw_weights / np.sum(raw_weights)
+
+    # Weighted differences
+    delta_with = normalized_weights * (logp_with_result - logp_no_call)
+    delta_call = normalized_weights * (logp_call_only - logp_no_call)
+
+    margins = np.sum(delta_with, axis=1)
+    call_benefit = np.sum(delta_call, axis=1)
+
+    keep_mask = (margins > tau_filter) & (call_benefit > 0.0)
+
+    return keep_mask, margins
