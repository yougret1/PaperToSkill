+    # Validate inputs
+    if not isinstance(logp_with_result, np.ndarray) or not isinstance(logp_call_only, np.ndarray) or not isinstance(logp_no_call, np.ndarray):
+        raise ValueError("Inputs must be numpy arrays")
+    if logp_with_result.ndim != 2 or logp_call_only.ndim != 2 or logp_no_call.ndim != 2:
+        raise ValueError("Inputs must be 2D matrices")
+    n_candidates, future_horizon = logp_with_result.shape
+    if n_candidates == 0 or future_horizon == 0:
+        raise ValueError("Input matrices must not be empty")
+    if logp_call_only.shape != (n_candidates, future_horizon) or logp_no_call.shape != (n_candidates, future_horizon):
+        raise ValueError("Shape mismatch")
+    if np.any(np.isnan(logp_with_result)) or np.any(np.isinf(logp_with_result)) or \
+       np.any(np.isnan(logp_call_only)) or np.any(np.isinf(logp_call_only)) or \
+       np.any(np.isnan(logp_no_call)) or np.any(np.isinf(logp_no_call)):
+        raise ValueError("Inputs must be finite")
+    if np.any(logp_with_result > 0) or np.any(logp_call_only > 0) or np.any(logp_no_call > 0):
+        raise ValueError("Inputs must be nonpositive")
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must be a finite nonnegative float")
