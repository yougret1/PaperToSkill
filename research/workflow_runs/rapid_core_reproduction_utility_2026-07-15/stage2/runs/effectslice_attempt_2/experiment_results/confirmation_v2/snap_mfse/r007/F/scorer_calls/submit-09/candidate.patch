+    v0 = rng.randn(n_cells).astype(np.float64)
+    v0 /= np.linalg.norm(v0)
+
+    evals, evecs = scipy.sparse.linalg.eigsh(
+        op, k=n_components, which='LM', v0=v0, tol=0, maxiter=None
+    )
+    # eigsh returns eigenvalues in ascending order; reverse to descending
+    evals = evals[::-1]
+    evecs = evecs[:, ::-1]
+
+    return evals, evecs
