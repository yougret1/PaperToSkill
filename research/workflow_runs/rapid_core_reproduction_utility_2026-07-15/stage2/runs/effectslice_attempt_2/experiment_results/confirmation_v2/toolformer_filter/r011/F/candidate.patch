+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("Boolean threshold is invalid")
+    if not isinstance(tau_filter, (int, float)):
+        raise ValueError("Threshold must be numeric")
+    if tau_filter < 0 or np.isnan(tau_filter) or np.isinf(tau_filter):
+        raise ValueError("Threshold must be finite nonnegative")
+    # Validate matrices
+    for arr, name in [(logp_with_result, 'logp_with_result'), (logp_call_only, 'logp_call_only'), (logp_no_call, 'logp_no_call')]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be 2D")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("Shape mismatch among matrices")
+    n_candidates, H = logp_with_result.shape
+    # Compute weights
+    weights = np.maximum(0, 1 - 0.2 * np.arange(H))
+    norm_weights = weights / weights.sum()
+    # Compute weighted losses
+    loss_result = -np.sum(norm_weights * logp_with_result, axis=1)
+    loss_call_only = -np.sum(norm_weights * logp_call_only, axis=1)
+    loss_no_call = -np.sum(norm_weights * logp_no_call, axis=1)
+    L_minus = np.minimum(loss_no_call, loss_call_only)
+    margin = L_minus - loss_result
+    keep = margin >= tau_filter
+    return keep, margin
