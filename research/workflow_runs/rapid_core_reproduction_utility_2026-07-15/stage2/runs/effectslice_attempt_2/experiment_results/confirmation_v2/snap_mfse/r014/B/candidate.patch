+    # Compute diagonal scaling
+    D_half_inv = 1.0 / np.sqrt(row_sums)
+
+    # Define operator for D^{-1/2} A A^T D^{-1/2}
+    def matvec(x):
+        y = x * D_half_inv
+        z = counts.T @ y
+        w = counts @ z
+        return w * D_half_inv
+
+    from scipy.sparse.linalg import LinearOperator, eigsh
+    dtype = counts.dtype
+    n = n_cells
+    M_op = LinearOperator((n, n), matvec=matvec, dtype=dtype)
+
+    rng = np.random.RandomState(random_state)
+    v0 = rng.randn(n)
+    # Compute largest eigenvalues and eigenvectors
+    eigvals, eigvecs = eigsh(M_op, k=n_components, which='LM', v0=v0)
