 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr, name in [
+        (logp_with_result, "logp_with_result"),
+        (logp_call_only, "logp_call_only"),
+        (logp_no_call, "logp_no_call"),
+    ]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains non-finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive log probabilities")
+
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be finite")
+    if tau_filter < 0:
+        raise ValueError("tau_filter must be nonnegative")
+
+    n_candidates, horizon = logp_with_result.shape
+
+    # Compute normalized weights
+    t_vals = np.arange(horizon)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t_vals)
+    if raw_weights.sum() == 0:
+        # Only possible if horizon == 0, but we already reject empty matrices
+        norm_weights = raw_weights
+    else:
+        norm_weights = raw_weights / raw_weights.sum()
+
+    # Compute weighted losses (negative weighted log probabilities)
+    # Since log probabilities are nonpositive, -weights * logp is nonnegative
+    L_plus = -np.sum(norm_weights * logp_with_result, axis=1)
+    L_call_only = -np.sum(norm_weights * logp_call_only, axis=1)
+    L_no_call = -np.sum(norm_weights * logp_no_call, axis=1)
+
+    # Counterfactual baseline: use the stronger (lower loss) of the two
+    L_minus = np.minimum(L_no_call, L_call_only)
+
+    # Margin and keep decision
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin
