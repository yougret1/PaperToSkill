+    col_inv_sqrt = np.where(col_sums > 0, 1.0 / np.sqrt(col_sums), 0.0)
+    # Form normalized matrix Y = D_c^{-1/2} @ counts @ D_f^{-1/2}
+    Y = counts * row_inv_sqrt[:, np.newaxis] * col_inv_sqrt[np.newaxis, :]
