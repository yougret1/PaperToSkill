+        raise ValueError("Inputs must be numpy arrays")
+    if logp_with_result.ndim != 2 or logp_call_only.ndim != 2 or logp_no_call.ndim != 2:
+        raise ValueError("Inputs must be 2-dimensional matrices")
+    if logp_with_result.shape != logp_call_only.shape or logp_call_only.shape != logp_no_call.shape:
+        raise ValueError("All input matrices must have the same shape")
+    n_candidates, future_horizon = logp_with_result.shape
+    if n_candidates == 0 or future_horizon == 0:
+        raise ValueError("Input matrices must not be empty")
+    if np.any(np.isnan(logp_with_result)) or np.any(np.isnan(logp_call_only)) or np.any(np.isnan(logp_no_call)):
