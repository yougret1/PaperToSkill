          "new_text": "\"\"\"Starter module for the locked SNAP-MFSE reproduction task.\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nimport scipy.sparse.linalg as sp_linalg\n\n\ndef matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n    # Input validation\n    if not isinstance(counts, np.ndarray):\n        raise ValueError(\"counts must be a numpy array\")\n    if counts.ndim != 2:\n        raise ValueError(\"counts must be 2-dimensional\")\n    n_cells, n_features = counts.shape\n    if not np.isfinite(counts).all():\n        raise ValueError(\"counts contains nonfinite values\")\n    if (counts < 0).any():\n        raise ValueError(\"counts contains negative values\")\n    if (counts.sum(axis=1) == 0).any():\n        raise ValueError(\"counts has all-zero rows\")\n    if not (1 <= n_components < n_cells):\n        raise ValueError(\"n_components must be between 1 and n_cells-1\")\n\n    # Step 1: IDF scaling\n    n = n_cells\n    df = np.count_nonzero(counts > 0, axis=0)  # feature document frequency\n    idf = np.log(n / (1 + df))\n    scaled = counts.astype(float) * idf  # element-wise multiplication\n\n    # Step 2: Row normalization to unit L2 norm\n    row_norms = np.linalg.norm(scaled, axis=1)\n    X = scaled / row_norms[:, np.newaxis]\n\n    # Step 3: Degree vector without building cell-cell matrix\n    ones_n = np.ones(n_cells)\n    degree = X @ (X.T @ ones_n) - ones_n\n    if np.any(degree <= 0):\n        raise ValueError(\"non-positive degree encountered\")\n\n    # Step 4: Define normalized similarity linear operator\n    D_inv = 1.0 / degree\n    D_inv_sqrt = np.sqrt(D_inv)\n    X_tilde = X * D_inv_sqrt[:, np.newaxis]  # D^{-1/2} X\n\n    rng = np.random.RandomState(random_state)\n    v0 = rng.randn(n_cells).astype(X.dtype)\n\n    def matvec(v):\n        return X_tilde @ (X_tilde.T @ v) - D_inv * v\n\n    A = sp_linalg.LinearOperator(\n        shape=(n_cells, n_cells),\n        matvec=matvec,\n        rmatvec=matvec,\n        dtype=X.dtype\n    )\n\n    # Step 5: Return leading eigenpairs\n    eigenvalues, eigenvectors = sp_linalg.eigsh(\n        A, k=n_components, which='LM', return_eigenvectors=True, v0=v0\n    )\n\n    # Sort eigenvalues in descending order\n    idx = np.argsort(eigenvalues)[::-1]\n    eigenvalues_desc = eigenvalues[idx]\n    eigenvectors_desc = eigenvectors[:, idx]\n\n    return eigenvalues_desc, eigenvectors_desc\n"
