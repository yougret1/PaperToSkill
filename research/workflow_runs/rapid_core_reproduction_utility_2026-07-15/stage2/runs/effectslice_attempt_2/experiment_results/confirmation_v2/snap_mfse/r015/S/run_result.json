          "new_text": "import numpy as np\nfrom scipy.sparse.linalg import LinearOperator, eigsh\n\ndef matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n\n    if not isinstance(counts, np.ndarray):\n        raise ValueError(\"counts must be an ndarray\")\n    if counts.ndim != 2:\n        raise ValueError(\"counts must be 2-dimensional\")\n    if not np.isfinite(counts).all():\n        raise ValueError(\"counts contains nonfinite values\")\n    if np.any(counts < 0):\n        raise ValueError(\"counts contains negative values\")\n    n_cells, n_features = counts.shape\n    if not (1 <= n_components < n_cells):\n        raise ValueError(\"n_components must be >= 1 and < n_cells\")\n    row_sums = counts.sum(axis=1)\n    if np.any(row_sums == 0):\n        raise ValueError(\"counts contains all-zero rows\")\n\n    # IDF scaling\n    df = np.count_nonzero(counts, axis=0)\n    idf = np.log(n_cells / (1.0 + df))\n    X = counts * idf\n\n    # Row normalization\n    norms = np.linalg.norm(X, axis=1, keepdims=True)\n    norms[norms == 0] = 1.0  # should not happen due to row check\n    X = X / norms\n\n    # Degree vector without materialising n_cells × n_cells\n    ones = np.ones(n_cells)\n    d = X @ (X.T @ ones) - ones\n    # safeguard against zero degree\n    inv_sqrt_d = 1.0 / np.sqrt(np.maximum(d, 1e-12))\n\n    # Matrix-free product: M v = D^{-1/2} (X X^T - I) D^{-1/2} v\n    def matvec(v):\n        v_scaled = v * inv_sqrt_d\n        temp = X.T @ v_scaled\n        result = X @ temp - v_scaled\n        return result * inv_sqrt_d\n\n    M_op = LinearOperator((n_cells, n_cells), matvec=matvec, dtype=np.float64)\n\n    # Use a seeded starting vector for reproducibility\n    rng = np.random.RandomState(random_state)\n    v0 = rng.randn(n_cells).astype(np.float64)\n    v0 = v0 / np.linalg.norm(v0)\n\n    eigenvalues, eigenvectors = eigsh(\n        M_op, k=n_components, which='LA', tol=1e-8,\n        maxiter=1000, v0=v0\n    )\n\n    # eigsh returns eigenvalues in ascending order -> reverse for descending\n    eigenvalues = eigenvalues[::-1].copy()\n    eigenvectors = eigenvectors[:, ::-1].copy()\n\n    return eigenvalues, eigenvectors"
