 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for name, arr in [("logp_with_result", logp_with_result),
+                      ("logp_call_only", logp_call_only),
+                      ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array, got {type(arr)}")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix, got ndim={arr.ndim}")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values, all must be <= 0")
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("Input matrices must have the same shape")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not isinstance(tau_filter, (int, float)) or tau_filter < 0 or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be a finite nonnegative float")
+    tau = float(tau_filter)
+
+    n_candidates, future_horizon = logp_with_result.shape
+    # Compute raw weights: max(0, 1 - 0.2*t) for t = 0..future_horizon-1
+    t = np.arange(future_horizon, dtype=float)
+    raw = np.maximum(0.0, 1.0 - 0.2 * t)
+    norm = raw / raw.sum()  # normalized weights, shape (future_horizon,)
+    # Weighted sums (log-likelihood contributions)
+    weighted_with = logp_with_result @ norm
+    weighted_no_call = logp_no_call @ norm
+    # margin = weighted logp from with_result minus weighted logp from no_call
+    margins = weighted_with - weighted_no_call
+    # keep if margin > tau (since condition L+ < L- - tau, i.e. weighted_with - weighted_no_call > tau)
+    keep = margins > tau
+    return keep, margins
