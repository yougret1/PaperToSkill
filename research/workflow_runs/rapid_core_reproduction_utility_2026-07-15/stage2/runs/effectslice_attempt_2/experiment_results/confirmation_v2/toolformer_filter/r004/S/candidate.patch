 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Input validation
+    if not isinstance(logp_with_result, np.ndarray) or not isinstance(logp_call_only, np.ndarray) or not isinstance(logp_no_call, np.ndarray):
+        raise ValueError("Inputs must be numpy arrays")
+    if logp_with_result.ndim != 2 or logp_call_only.ndim != 2 or logp_no_call.ndim != 2:
+        raise ValueError("Inputs must be two-dimensional matrices")
+    if logp_with_result.shape != logp_call_only.shape or logp_with_result.shape != logp_no_call.shape:
+        raise ValueError("Input shapes must match")
+    if logp_with_result.size == 0:
+        raise ValueError("Inputs must not be empty")
+    if np.any(logp_with_result > 0) or np.any(logp_call_only > 0) or np.any(logp_no_call > 0):
+        raise ValueError("Inputs must be nonpositive")
+    if not np.all(np.isfinite(logp_with_result)) or not np.all(np.isfinite(logp_call_only)) or not np.all(np.isfinite(logp_no_call)):
+        raise ValueError("Inputs must be finite")
+    if tau_filter < 0 or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be finite nonnegative")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Compute decreasing future-token weights
+    t = np.arange(future_horizon)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    weights = raw_weights / raw_weights.sum()
+
+    # Weighted averages along future horizon
+    avg_with_result = (weights * logp_with_result).sum(axis=1)
+    avg_call_only = (weights * logp_call_only).sum(axis=1)
+    avg_no_call = (weights * logp_no_call).sum(axis=1)
+
+    # Improvements over baselines
+    delta_no_call = avg_with_result - avg_no_call
+    delta_call_only = avg_with_result - avg_call_only
+
+    # Margin as the minimum improvement (both must exceed threshold)
+    margin = np.minimum(delta_no_call, delta_call_only)
+
+    # Keep mask
+    keep = margin > tau_filter
+
+    return keep, margin
