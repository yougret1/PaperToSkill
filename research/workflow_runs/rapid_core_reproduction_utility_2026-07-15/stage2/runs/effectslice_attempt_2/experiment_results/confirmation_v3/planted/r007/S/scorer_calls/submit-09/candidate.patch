-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if logp_with_result.ndim != 2 or logp_call_only.ndim != 2 or logp_no_call.ndim != 2:
+        raise ValueError("Inputs must be 2D matrices")
+    n_candidates, horizon = logp_with_result.shape
+    if logp_call_only.shape != (n_candidates, horizon) or logp_no_call.shape != (n_candidates, horizon):
+        raise ValueError("Shape mismatch")
+    if n_candidates == 0 or horizon == 0:
+        raise ValueError("Inputs cannot be empty")
+    if not (np.isfinite(logp_with_result).all() and np.isfinite(logp_call_only).all() and np.isfinite(logp_no_call).all()):
+        raise ValueError("All inputs must be finite")
+    if (logp_with_result > 0).any() or (logp_call_only > 0).any() or (logp_no_call > 0).any():
+        raise ValueError("All inputs must be nonpositive")
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter cannot be boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite nonnegative")
+
+    # Compute normalized weights
+    t = np.arange(horizon)  # 0-indexed
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    normalized_weights = raw_weights / raw_weights.sum()
+
+    # Weighted negative log probabilities
+    loss_with = -np.sum(logp_with_result * normalized_weights, axis=1)
+    loss_call_only = -np.sum(logp_call_only * normalized_weights, axis=1)
+    loss_no_call = -np.sum(logp_no_call * normalized_weights, axis=1)
+
+    # Counterfactual baseline: min of no_call and call_only
+    L_minus = np.minimum(loss_no_call, loss_call_only)
+
+    # Margin and keep
+    margin = L_minus - loss_with
+    keep = margin >= tau_filter
+
+    return keep, margin
