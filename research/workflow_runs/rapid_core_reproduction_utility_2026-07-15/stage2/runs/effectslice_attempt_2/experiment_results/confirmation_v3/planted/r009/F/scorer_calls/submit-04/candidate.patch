 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+    
+    # Validate matrices
+    for name, arr in [("logp_with_result", logp_with_result), ("logp_call_only", logp_call_only), ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray) or arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D numpy array")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains nonfinite values")
+        if (arr > 0).any():
+            raise ValueError(f"{name} contains positive values")
+    
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+    
+    n_candidates, horizon = logp_with_result.shape
+    
+    # Compute normalized weights
+    t = np.arange(horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    weight_sum = raw_weights.sum()
+    normalized_weights = raw_weights / weight_sum if weight_sum > 0 else np.zeros_like(raw_weights)
+    
+    # Compute weighted losses
+    L_plus = -np.sum(logp_with_result * normalized_weights, axis=1)
+    L_empty = -np.sum(logp_no_call * normalized_weights, axis=1)
+    L_call_only = -np.sum(logp_call_only * normalized_weights, axis=1)
+    
+    L_minus = np.minimum(L_empty, L_call_only)
+    margins = L_minus - L_plus
+    keep_mask = margins >= tau_filter
+    
+    return keep_mask.astype(bool), margins
