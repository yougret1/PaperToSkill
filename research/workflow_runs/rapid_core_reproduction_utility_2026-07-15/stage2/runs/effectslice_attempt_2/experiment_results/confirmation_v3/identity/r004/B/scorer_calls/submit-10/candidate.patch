--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -12,5 +12,32 @@
     tau_filter: float,
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
-
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr, name in [(logp_with_result, "logp_with_result"),
+                      (logp_call_only, "logp_call_only"),
+                      (logp_no_call, "logp_no_call")]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy ndarray")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.shape != logp_with_result.shape:
+            raise ValueError("All input matrices must have the same shape")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} must contain only finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} must be nonpositive")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be a finite nonnegative float")
+    # Compute baseline log probability without result (best of no_call and call_only)
+    baseline_logp = np.maximum(logp_no_call, logp_call_only)
+    # Compute per-token improvement: logp_with_result - baseline
+    improvement_per_token = logp_with_result - baseline_logp
+    # Sum over horizon to get total improvement per candidate (margin)
+    margin = improvement_per_token.sum(axis=1)
+    # Keep if improvement >= tau_filter
+    keep = margin > tau_filter
+    return (keep, margin)
