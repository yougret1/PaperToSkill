--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -12,5 +12,44 @@
     tau_filter: float,
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
-
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not isinstance(tau_filter, (int, float)):
+        raise ValueError("tau_filter must be a finite nonnegative number")
+    if np.isnan(tau_filter) or np.isinf(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+    
+    for arr, name in [(logp_with_result, "logp_with_result"),
+                      (logp_call_only, "logp_call_only"),
+                      (logp_no_call, "logp_no_call")]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values (log probabilities must be nonpositive)")
+    # Check shape match
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All three matrices must have the same shape")
+    
+    n_candidates, future_horizon = logp_with_result.shape
+    # Compute weights
+    t = np.arange(future_horizon)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    normalized_weights = raw_weights / raw_weights.sum()
+    
+    # Compute weighted losses: negative weighted sum
+    L_plus = -np.dot(logp_with_result, normalized_weights)
+    L_call_only = -np.dot(logp_call_only, normalized_weights)
+    L_no_call = -np.dot(logp_no_call, normalized_weights)
+    
+    L_minus = np.minimum(L_no_call, L_call_only)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+    
+    return keep, margin
