@@ -13,4 +13,60 @@
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # ------------------------------------------------------------------ #
+    # Input validation
+    # ------------------------------------------------------------------ #
+    # Reject explicit boolean values (Python bool or numpy bool_)
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be a boolean value")
+    # Accept any numeric type (int, float, np.integer, np.floating)
+    if not isinstance(tau_filter, (int, float, np.integer, np.floating)):
+        raise ValueError("tau_filter must be a numeric type")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    for arr, name in [(logp_with_result, "logp_with_result"),
+                      (logp_call_only, "logp_call_only"),
+                      (logp_no_call, "logp_no_call")]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix, got ndim={arr.ndim}")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains non-finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    shape = logp_with_result.shape
+    if logp_call_only.shape != shape or logp_no_call.shape != shape:
+        raise ValueError("All input matrices must have the same shape")
+
+    # ------------------------------------------------------------------ #
+    # Paper procedure (T01–T05)
+    # ------------------------------------------------------------------ #
+    n_candidates, future_horizon = shape
+
+    # T01: Normalize decreasing future-token weights
+    t = np.arange(future_horizon, dtype=np.float64)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    normalized_weights = raw_weights / raw_weights.sum()
+
+    # T02: Compute weighted future-token loss for each candidate
+    # loss = - Σ w_k * logp_k   (logp is nonpositive, so -loss is positive)
+    def weighted_loss(logp: np.ndarray) -> np.ndarray:
+        return -np.sum(logp * normalized_weights, axis=1)
+
+    L_plus = weighted_loss(logp_with_result)
+    L_call_only = weighted_loss(logp_call_only)
+    L_no_call = weighted_loss(logp_no_call)
+
+    # T03: Stronger counterfactual baseline = min(L_empty, L_call_only)
+    L_minus = np.minimum(L_no_call, L_call_only)
+
+    # T04: Keep calls where margin >= tau_filter
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin
