--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -12,5 +12,40 @@
     tau_filter: float,
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
-
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not isinstance(tau_filter, (int, float)):
+        raise ValueError("tau_filter must be a finite nonnegative scalar")
+    if np.isnan(tau_filter) or np.isinf(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+    for arr in [logp_with_result, logp_call_only, logp_no_call]:
+        if not isinstance(arr, np.ndarray) or arr.ndim != 2:
+            raise ValueError("Each logp matrix must be a 2D numpy array")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All logp matrices must have the same shape")
+    if logp_with_result.size == 0:
+        raise ValueError("Logp matrices must not be empty")
+    if not np.all(np.isfinite(logp_with_result)):
+        raise ValueError("logp_with_result contains non-finite values")
+    if not np.all(np.isfinite(logp_call_only)):
+        raise ValueError("logp_call_only contains non-finite values")
+    if not np.all(np.isfinite(logp_no_call)):
+        raise ValueError("logp_no_call contains non-finite values")
+    if np.any(logp_with_result > 0) or np.any(logp_call_only > 0) or np.any(logp_no_call > 0):
+        raise ValueError("All logp values must be nonpositive")
+    n_candidates, future_horizon = logp_with_result.shape
+    if future_horizon == 0:
+        raise ValueError("future_horizon must be at least 1")
+    # Compute normalized weights
+    t = np.arange(future_horizon, dtype=float)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    weights = raw_weights / raw_weights.sum()
+    # Compute weighted losses (negative log probability)
+    L_plus = np.dot(-logp_with_result, weights)
+    L_call = np.dot(-logp_call_only, weights)
+    L_no = np.dot(-logp_no_call, weights)
+    L_minus = np.minimum(L_no, L_call)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+    return keep, margin
