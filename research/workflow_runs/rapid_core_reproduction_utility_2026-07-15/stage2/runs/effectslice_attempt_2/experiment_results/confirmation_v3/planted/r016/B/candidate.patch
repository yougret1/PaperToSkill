 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Input validation
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be boolean")
+    if not np.isscalar(tau_filter):
+        raise ValueError("tau_filter must be a scalar")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    for mat, name in [(logp_with_result, 'logp_with_result'),
+                      (logp_call_only, 'logp_call_only'),
+                      (logp_no_call, 'logp_no_call')]:
+        if not isinstance(mat, np.ndarray):
+            raise ValueError(f"{name} must be a numpy ndarray")
+        if mat.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if mat.shape[0] == 0 or mat.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if np.any(mat > 0):
+            raise ValueError(f"{name} must have nonpositive values")
+        if not np.all(np.isfinite(mat)):
+            raise ValueError(f"{name} must have finite values")
+
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    # Compute loss sums along the sequence dimension
+    L_with = np.sum(logp_with_result, axis=1)   # sums of log probs (negative)
+    L_call = np.sum(logp_call_only, axis=1)
+    L_no   = np.sum(logp_no_call, axis=1)
+
+    # Margins: improvement over no-call baseline
+    margin_with = L_no - L_with   # positive if with_result reduces loss
+    margin_call = L_no - L_call
+
+    # Keep candidate if both margins exceed the threshold (Toolformer filtering)
+    keep = (margin_with > tau_filter) & (margin_call > tau_filter)
+    return keep, margin_with
