          "new_text": "def filter_api_calls(\n    logp_with_result: np.ndarray,\n    logp_call_only: np.ndarray,\n    logp_no_call: np.ndarray,\n    tau_filter: float,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an ordered keep mask and one finite margin per proposed call.\"\"\"\n    for mat in [logp_with_result, logp_call_only, logp_no_call]:\n        if not isinstance(mat, np.ndarray):\n            raise ValueError(\"Input must be numpy array\")\n        if mat.ndim != 2:\n            raise ValueError(\"Input must be 2D matrix\")\n        if mat.size == 0:\n            raise ValueError(\"Input must not be empty\")\n        if not np.all(np.isfinite(mat)):\n            raise ValueError(\"Input contains nonfinite values\")\n        if np.any(mat > 0):\n            raise ValueError(\"Input contains positive values\")\n    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):\n        raise ValueError(\"Shape mismatch\")\n    if isinstance(tau_filter, bool):\n        raise ValueError(\"tau_filter cannot be a boolean\")\n    if not np.isfinite(tau_filter) or tau_filter < 0:\n        raise ValueError(\"tau_filter must be a finite nonnegative float\")\n\n    future_horizon = logp_with_result.shape[1]\n    t = np.arange(future_horizon)\n    raw_weights = np.maximum(0, 1 - 0.2 * t)\n    weights = raw_weights / raw_weights.sum()\n\n    L_plus = -np.sum(logp_with_result * weights, axis=1)\n    L_call_only = -np.sum(logp_call_only * weights, axis=1)\n    L_empty = -np.sum(logp_no_call * weights, axis=1)\n\n    L_minus = np.minimum(L_empty, L_call_only)\n    margin = L_minus - L_plus\n    keep = margin >= tau_filter\n\n    return keep, margin"
