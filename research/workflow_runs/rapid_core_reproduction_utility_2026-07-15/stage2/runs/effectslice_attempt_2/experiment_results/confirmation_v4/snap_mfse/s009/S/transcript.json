      "response_text": "{\"action\":\"edit\",\"path\":\"snap_core.py\",\"old_text\":\"    \\\"\\\"\\\"Return leading spectral coordinates for a cell-by-feature count matrix.\\\"\\\"\\\"\\n\\n    raise NotImplementedError(\\\"implement the paper-core reproduction task\\\")\",\"new_text\":\"    \\\"\\\"\\\"Return leading spectral coordinates for a cell-by-feature count matrix.\\\"\\\"\\\"\\n    # Validation\\n    if not np.isfinite(counts).all():\\n        raise ValueError(\\\"counts contains nonfinite values\\\")\\n    if np.any(counts < 0):\\n        raise ValueError(\\\"counts contains negative values\\\")\\n    if np.any(np.all(counts == 0, axis=1)):\\n        raise ValueError(\\\"counts contains all-zero rows\\\")\\n    n_cells, n_features = counts.shape\\n    if not (1 <= n_components < n_cells):\\n        raise ValueError(\\\"n_components must be in [1, n_cells)\\\")\\n    \\n    # 1. IDF scaling\\n    n = n_cells\\n    df = np.count_nonzero(counts > 0, axis=0)\\n    idf = np.log(n / (1 + df))\\n    X_idf = counts * idf\\n    \\n    # 2. Row normalization to unit L2 norm\\n    row_norms = np.linalg.norm(X_idf, axis=1)\\n    X_norm = X_idf / row_norms[:, np.newaxis]\\n    \\n    # 3. Matrix-free operator for W = X_norm @ X_norm.T - I\\n    matvec = lambda v: X_norm @ (X_norm.T @ v) - v\\n    W_operator = LinearOperator((n_cells, n_cells), matvec=matvec, dtype=X_norm.dtype)\\n    \\n    # 4. Compute leading eigenvalues and vectors using eigensolver\\n    eigenvalues, eigenvectors = eigsh(W_operator, k=n_components, which=\\\"LA\\\")\\n    \\n    # 5. eigsh returns in ascending order; reverse to descending\\n    eigenvalues = eigenvalues[::-1]\\n    eigenvectors = eigenvectors[:, ::-1]\\n    \\n    return eigenvalues, eigenvectors\"}",
