+    normalized_weights = raw_weights / weight_sum
+
+    # Compute margin for each candidate
+    max_alternative = np.maximum(logp_call_only, logp_no_call)
+    delta = logp_with_result - max_alternative
+    margin = np.dot(delta, normalized_weights)
+
