+        raise ValueError('n_components must be between 1 and n_cells-1')
+
+    # IDF scaling
+    df = np.count_nonzero(counts > 0, axis=0)
+    idf = np.log(n_cells / (1.0 + df))
+    X = counts * idf
+
+    # Row normalization
+    norms = np.linalg.norm(X, axis=1, keepdims=True)
+    if np.any(norms == 0):
+        raise ValueError('counts has all-zero rows')
+    X = X / norms
+
+    # Degree vector (matrix-free): d = X @ (X.T @ ones) - 1
+    d = X @ (X.T @ np.ones(n_cells)) - 1.0
+    if np.any(d <= 0):
+        raise ValueError('Some cells have zero degree')
+
+    # Matrix-free operator for the normalized Laplacian L_norm
+    # L_norm = I - D^{-1/2} (X X^T - I) D^{-1/2} = I - D^{-1/2} X X^T D^{-1/2} + D^{-1}
+    d_inv_sqrt = 1.0 / np.sqrt(d)
+    def matvec(v):
+        scaled = d_inv_sqrt * v
+        inner = X @ (X.T @ scaled)
+        return v - d_inv_sqrt * inner + v / d
+
+    A = spla.LinearOperator((n_cells, n_cells), matvec=matvec, rmatvec=matvec, dtype=np.float64)
+
