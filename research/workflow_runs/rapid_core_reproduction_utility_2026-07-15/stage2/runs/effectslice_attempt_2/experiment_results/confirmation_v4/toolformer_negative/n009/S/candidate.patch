--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -12,5 +12,36 @@
     tau_filter: float,
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
-
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for name, arr in [("logp_with_result", logp_with_result),
+                      ("logp_call_only", logp_call_only),
+                      ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} is empty")
+        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values (must be nonpositive)")
+    # Check shape consistency
+    shape = logp_with_result.shape
+    if logp_call_only.shape != shape or logp_no_call.shape != shape:
+        raise ValueError("all input matrices must have the same shape")
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean value")
+    if not (isinstance(tau_filter, (int, float)) and np.isfinite(tau_filter) and tau_filter >= 0):
+        raise ValueError("tau_filter must be a finite nonnegative number")
+    n_candidates, H = shape
+    # Compute weights
+    t = np.arange(H)
+    raw_w = np.maximum(0, 1 - 0.2 * t)
+    w = raw_w / raw_w.sum()
+    # Compute margin: weighted sum of (logp_with_result - logp_call_only)
+    margin = np.sum(w * (logp_with_result - logp_call_only), axis=1)
+    # Keep if margin > tau_filter
+    keep = margin > tau_filter
+    return (keep, margin)
