+    # Validate inputs
+    for arr, name in [(logp_with_result, 'logp_with_result'), (logp_call_only, 'logp_call_only'), (logp_no_call, 'logp_no_call')]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains non-finite values")
+        if not np.all(arr <= 0):
+            raise ValueError(f"{name} must be nonpositive")
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+    # Validate tau_filter
+    if isinstance(tau_filter, bool) or not isinstance(tau_filter, (int, float, np.integer, np.floating)) or np.isnan(tau_filter) or tau_filter < 0 or np.isinf(tau_filter):
+        raise ValueError("tau_filter must be a finite nonnegative threshold")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Compute normalized weights
+    t = np.arange(future_horizon, dtype=float)
+    raw_weights = np.maximum(0, 1.0 - 0.2 * t)
+    normalized_weights = raw_weights / raw_weights.sum()  # sum > 0 because horizon >= 1
+
+    # Compute weighted losses: -sum(weight * logp)
+    loss_with_result = -np.sum(logp_with_result * normalized_weights, axis=1)
+    loss_call_only = -np.sum(logp_call_only * normalized_weights, axis=1)
+    loss_no_call = -np.sum(logp_no_call * normalized_weights, axis=1)
+
+    # Baseline: min of no call and call only
+    L_minus = np.minimum(loss_no_call, loss_call_only)
+
+    # Margin and keep decision
+    margin = L_minus - loss_with_result
+    keep = margin >= tau_filter
+
+    return keep, margin
