@@ -13,4 +13,52 @@
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for name, arr in [("logp_with_result", logp_with_result),
+                       ("logp_call_only", logp_call_only),
+                       ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a NumPy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D array")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains non-finite values")
+        if not (arr <= 0).all():
+            raise ValueError(f"{name} contains positive values")
+
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All three arrays must have the same shape")
+
+    # Validate threshold
+    if isinstance(tau_filter, bool):
+        raise ValueError("Boolean threshold is invalid")
+    if not isinstance(tau_filter, (int, float)) or np.isnan(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be a finite nonnegative float")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # T01: Compute normalized decreasing weights
+    t = np.arange(future_horizon)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    normalized_weights = raw_weights / raw_weights.sum()
+
+    # T02: Compute weighted future-token loss (negative weighted log prob)
+    # For each candidate, weighted loss = - sum(w * logp)
+    # We use axis=1 to sum over future tokens
+    L_with = -np.sum(logp_with_result * normalized_weights, axis=1)
+    L_call = -np.sum(logp_call_only * normalized_weights, axis=1)
+    L_empty = -np.sum(logp_no_call * normalized_weights, axis=1)
+
+    # T03: Stronger counterfactual baseline
+    L_minus = np.minimum(L_empty, L_call)
+
+    # T04: Filter calls by margin
+    L_plus = L_with
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    # T05: Preserve order (already preserved)
+    return keep, margin
