          "new_text": "\"\"\"Starter module for the locked SNAP-MFSE reproduction task.\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\nimport scipy.sparse.linalg\n\n\ndef matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n    # Input validation\n    counts = np.asarray(counts, dtype=float)\n    if not np.all(np.isfinite(counts)):\n        raise ValueError(\"counts must be finite\")\n    if np.any(counts < 0):\n        raise ValueError(\"counts must be nonnegative\")\n    if counts.ndim != 2:\n        raise ValueError(\"counts must be 2D\")\n    n_cells, n_features = counts.shape\n    if not (1 <= n_components < n_cells):\n        raise ValueError(\"n_components must be between 1 and n_cells-1\")\n    if np.any(np.all(counts == 0, axis=1)):\n        raise ValueError(\"rows with all zeros are not allowed\")\n\n    # A01: IDF scaling\n    df = np.count_nonzero(counts > 0, axis=0)\n    idf = np.log(n_cells / (1.0 + df))\n    X = counts * idf\n\n    # A02: Row normalization to unit L2\n    row_norms = np.linalg.norm(X, axis=1, keepdims=True)\n    if np.any(row_norms == 0):\n        raise ValueError(\"row with zero norm after IDF (should not happen)\")\n    X = X / row_norms\n\n    # A03: Compute degree vector matrix-free\n    ones = np.ones(n_cells)\n    degree = X @ (X.T @ ones) - 1.0\n    if np.any(degree <= 0):\n        raise ValueError(\"non-positive degree encountered\")\n\n    # A04: Build operator for normalized similarity\n    D_inv_sqrt = 1.0 / np.sqrt(degree)\n    X_tilde = X * D_inv_sqrt[:, np.newaxis]\n    D_inv = 1.0 / degree\n\n    class NormSimOperator(scipy.sparse.linalg.LinearOperator):\n        def __init__(self):\n            self.shape = (n_cells, n_cells)\n            self.dtype = X_tilde.dtype\n\n        def _matvec(self, v):\n            return X_tilde @ (X_tilde.T @ v) - D_inv * v\n\n    operator = NormSimOperator()\n\n    # Use Lanczos eigensolver (eigsh)\n    rng = np.random.RandomState(random_state)\n    v0 = rng.randn(n_cells)\n    eigenvalues, eigenvectors = scipy.sparse.linalg.eigsh(\n        operator, k=n_components, which='LA', v0=v0, maxiter=1000, tol=1e-8\n    )\n    # Ensure descending order\n    idx = np.argsort(eigenvalues)[::-1]\n    eigenvalues = eigenvalues[idx]\n    eigenvectors = eigenvectors[:, idx]\n\n    return eigenvalues, eigenvectors\n"
