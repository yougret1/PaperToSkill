@@ -13,4 +13,48 @@
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validation
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be a boolean.")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be a finite nonnegative number.")
+    
+    for arr, name in [(logp_with_result, 'logp_with_result'), (logp_call_only, 'logp_call_only'), (logp_no_call, 'logp_no_call')]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array.")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix.")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty.")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains nonfinite values.")
+        if (arr > 0).any():
+            raise ValueError(f"{name} contains positive log probabilities.")
+    
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape.")
+    
+    n_candidates, future_horizon = logp_with_result.shape
+    
+    # Normalize decreasing future-token weights (T01)
+    t = np.arange(future_horizon, dtype=float)
+    raw = np.maximum(0.0, 1.0 - 0.2 * t)
+    weight_sum = raw.sum()
+    if weight_sum > 0:
+        normalized = raw / weight_sum
+    else:
+        normalized = np.zeros_like(raw)
+    
+    # Compute weighted future-token loss (T02)
+    L_plus = -np.dot(logp_with_result, normalized)   # shape (n_candidates,)
+    L_call_only = -np.dot(logp_call_only, normalized)
+    L_empty = -np.dot(logp_no_call, normalized)
+    
+    # Counterfactual baseline (T03)
+    L_minus = np.minimum(L_empty, L_call_only)
+    
+    # Margin and threshold (T04)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+    
+    return keep, margin
