+    # Validate inputs
+    for arr in (logp_with_result, logp_call_only, logp_no_call):
+        if not isinstance(arr, np.ndarray) or arr.ndim != 2:
+            raise ValueError("Input must be a 2D numpy array")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("Shape mismatch among input matrices")
+    for arr in (logp_with_result, logp_call_only, logp_no_call):
+        if not np.isfinite(arr).all():
+            raise ValueError("Input contains non-finite values")
+        if np.any(arr > 0):
+            raise ValueError("Input contains positive log probabilities")
+    if isinstance(tau_filter, bool) or not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("Invalid tau_filter")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Normalized future-token weights
+    t = np.arange(future_horizon)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    norm_weights = raw_weights / raw_weights.sum()
+
+    # Weighted negative log probabilities
+    L_plus = -np.sum(logp_with_result * norm_weights, axis=1)
+    L_call_only = -np.sum(logp_call_only * norm_weights, axis=1)
+    L_no_call = -np.sum(logp_no_call * norm_weights, axis=1)
+
+    # Counterfactual baseline: min of the two
+    L_minus = np.minimum(L_no_call, L_call_only)
+
+    margins = L_minus - L_plus
+    keep = margins >= tau_filter
+
+    return keep, margins
