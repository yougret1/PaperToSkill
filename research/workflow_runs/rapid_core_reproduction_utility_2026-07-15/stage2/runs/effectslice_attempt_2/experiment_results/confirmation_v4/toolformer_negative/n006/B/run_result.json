          "new_text": "def filter_api_calls(\n    logp_with_result: np.ndarray,\n    logp_call_only: np.ndarray,\n    logp_no_call: np.ndarray,\n    tau_filter: float,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an ordered keep mask and one finite margin per proposed call.\"\"\"\n    # Validate inputs\n    if isinstance(tau_filter, bool):\n        raise ValueError(\"Boolean threshold is invalid\")\n    for arr, name in [(logp_with_result, \"logp_with_result\"),\n                      (logp_call_only, \"logp_call_only\"),\n                      (logp_no_call, \"logp_no_call\")]:\n        if not isinstance(arr, np.ndarray):\n            raise ValueError(f\"{name} must be a numpy array\")\n        if arr.ndim != 2:\n            raise ValueError(f\"{name} must be a 2D matrix\")\n        if arr.size == 0:\n            raise ValueError(f\"{name} must not be empty\")\n        if not np.isfinite(arr).all():\n            raise ValueError(f\"{name} contains nonfinite values\")\n        if np.any(arr > 0):\n            raise ValueError(f\"{name} contains positive values\")\n    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):\n        raise ValueError(\"Input matrices must have the same shape\")\n    if not np.isfinite(tau_filter) or tau_filter < 0:\n        raise ValueError(\"tau_filter must be finite and nonnegative\")\n    # Compute total log probabilities per candidate by summing over horizon\n    total_wr = logp_with_result.sum(axis=1)\n    total_nc = logp_no_call.sum(axis=1)\n    total_call = logp_call_only.sum(axis=1)\n    # Compute differences\n    diff_nc = total_wr - total_nc\n    diff_call = total_wr - total_call\n    # Margin is the smaller improvement\n    margin = np.minimum(diff_nc, diff_call)\n    # Keep if margin >= threshold\n    keep = margin >= tau_filter\n    return keep, margin.astype(np.float64)"
