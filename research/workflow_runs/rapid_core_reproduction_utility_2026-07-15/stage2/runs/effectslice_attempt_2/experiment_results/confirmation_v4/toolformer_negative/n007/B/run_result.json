      "observation_status": "ok",
      "observation_message": "1: \"\"\"Starter module for the locked Toolformer loss-filter task.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import numpy as np\n6: \n7: \n8: def filter_api_calls(\n9:     logp_with_result: np.ndarray,\n10:     logp_call_only: np.ndarray,\n11:     logp_no_call: np.ndarray,\n12:     tau_filter: float,\n13: ) -> tuple[np.ndarray, np.ndarray]:\n14:     \"\"\"Return an ordered keep mask and one finite margin per proposed call.\"\"\"\n15: \n16:     # Validate inputs\n17:     for name, arr in [(\"logp_with_result\", logp_with_result), (\"logp_call_only\", logp_call_only), (\"logp_no_call\", logp_no_call)]:\n18:         if arr.ndim != 2:\n19:             raise ValueError(f\"{name} must be a 2D matrix\")\n20:     if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):\n21:         raise ValueError(\"All input matrices must have the same shape\")\n22:     if logp_with_result.size == 0:\n23:         raise ValueError(\"Input matrices must not be empty\")\n24:     if not (np.isfinite(logp_with_result).all() and np.isfinite(logp_call_only).all() and np.isfinite(logp_no_call).all()):\n25:         raise ValueError(\"All values must be finite\")\n26:     if not (np.all(logp_with_result <= 0) and np.all(logp_call_only <= 0) and np.all(logp_no_call <= 0)):\n27:         raise ValueError(\"All values must be nonpositive\")\n28:     if isinstance(tau_filter, bool) or not np.isscalar(tau_filter):\n29:         raise ValueError(\"tau_filter must be a non-boolean scalar\")\n30:     if not np.isfinite(tau_filter) or tau_filter < 0:\n31:         raise ValueError(\"tau_filter must be finite and nonnegative\")\n32: \n33:     # Compute sums over future horizon\n34:     sum_with = logp_with_result.sum(axis=1)\n35:     sum_call = logp_call_only.sum(axis=1)\n36:     sum_no = logp_no_call.sum(axis=1)\n37:     max_other = np.maximum(sum_call, sum_no)\n38:     margins = sum_with - max_other\n39:     keep = margins > tau_filter\n40:     return keep, margins.astype(np.float64)",
