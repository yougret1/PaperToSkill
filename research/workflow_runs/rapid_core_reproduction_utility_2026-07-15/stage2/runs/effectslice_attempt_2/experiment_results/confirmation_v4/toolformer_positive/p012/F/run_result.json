r(\\\"Weights sum to zero.\\\")\\n    normalized_weights = raw_weights / weight_sum\\n    # Compute weighted future-token loss for each condition\\n    L_empty = -np.sum(normalized_weights * log_probs_empty, axis=1)\\n    L_call_only = -np.sum(normalized_weights * log_probs_call_only, axis=1)\\n    L_plus = -np.sum(normalized_weights * log_probs_plus, axis=1)\\n    # Compute baseline and margin\\n    L_minus = np.minimum(L_empty, L_call_only)\\n    margins = L_minus - L_plus\\n    keep = margins >= tau_filter\\n    return keep, margins\"}",
