-    raise NotImplementedError("implement the paper-core reproduction task")
+    # validation
+    for arr in [logp_with_result, logp_call_only, logp_no_call]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError("each input must be a numpy ndarray")
+        if arr.ndim != 2:
+            raise ValueError("each input must be 2-dimensional")
+        if arr.size == 0:
+            raise ValueError("each input must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError("each input must contain only finite values")
+        if not (arr <= 0).all():
+            raise ValueError("each input must contain only nonpositive values")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("all inputs must have the same shape")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not isinstance(tau_filter, (int, float)):
+        raise ValueError("tau_filter must be a finite nonnegative number")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be a finite nonnegative number")
+
+    n_candidates, horizon = logp_with_result.shape
+    t = np.arange(horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    weight_sum = np.sum(raw_weights)
+    normalized_weights = raw_weights / weight_sum
+
+    L_with_result = -np.sum(normalized_weights * logp_with_result, axis=1)
+    L_call_only = -np.sum(normalized_weights * logp_call_only, axis=1)
+    L_no_call = -np.sum(normalized_weights * logp_no_call, axis=1)
+
+    L_minus = np.minimum(L_no_call, L_call_only)
+    margins = L_minus - L_with_result
+    keep = margins >= tau_filter
+    return keep, margins
