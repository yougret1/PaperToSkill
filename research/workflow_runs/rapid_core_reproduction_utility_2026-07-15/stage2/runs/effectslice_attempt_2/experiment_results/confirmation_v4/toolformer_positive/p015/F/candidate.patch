 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must be a nonnegative finite number, not bool")
+    if not isinstance(tau_filter, (float, int)):
+        raise ValueError("tau_filter must be a number")
+    if tau_filter < 0 or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be nonnegative and finite")
+
+    arrays = [logp_with_result, logp_call_only, logp_no_call]
+    for name, arr in zip(["logp_with_result", "logp_call_only", "logp_no_call"], arrays):
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} cannot be empty")
+        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive log probabilities (must be nonpositive)")
+        if arr.dtype.kind != 'f':
+            raise ValueError(f"{name} must have floating-point dtype")
+
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input arrays must have the same shape")
+
+    n_candidates, horizon = logp_with_result.shape
+    # Compute normalized decreasing future-token weights
+    t = np.arange(horizon, dtype=np.float64)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    normalized_weights = raw_weights / raw_weights.sum()
+
+    # Compute weighted future-token losses
+    loss_with_result = - (logp_with_result @ normalized_weights)
+    loss_call_only = - (logp_call_only @ normalized_weights)
+    loss_no_call = - (logp_no_call @ normalized_weights)
+
+    # Use the stronger counterfactual baseline: min(L_empty, L_call_only)
+    L_minus = np.minimum(loss_no_call, loss_call_only)
+    L_plus = loss_with_result
+
+    margins = L_minus - L_plus
+    keep = margins >= tau_filter
+
+    return keep.astype(np.bool_), margins.astype(np.float64)
