     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # validation
+    if not all(isinstance(x, np.ndarray) for x in [logp_with_result, logp_call_only, logp_no_call]):
+        raise ValueError("All inputs must be numpy arrays")
+    if logp_with_result.shape != logp_call_only.shape or logp_with_result.shape != logp_no_call.shape:
+        raise ValueError("All input arrays must have the same shape")
+    if logp_with_result.ndim != 2:
+        raise ValueError("Input arrays must be 2-dimensional")
+    for arr in [logp_with_result, logp_call_only, logp_no_call]:
+        if not np.all(np.isfinite(arr)):
+            raise ValueError("All values must be finite")
+        if np.any(arr > 0):
+            raise ValueError("All values must be nonpositive")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+    # compute normalized decreasing weights
+    m = logp_with_result.shape[1]
+    t = np.arange(m, dtype=float)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    w_sum = np.sum(raw_weights)
+    norm_weights = raw_weights / w_sum  # sum to 1 (w_sum > 0 if m > 0)
+    # weighted average log probabilities (larger means better, less negative)
+    wa_with = np.dot(logp_with_result, norm_weights)
+    wa_call = np.dot(logp_call_only, norm_weights)
+    wa_no = np.dot(logp_no_call, norm_weights)
+    # margin: improvement over the better baseline
+    margin = wa_with - np.maximum(wa_no, wa_call)
+    keep = margin >= tau_filter
+    return keep, margin
