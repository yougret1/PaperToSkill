          "old_text": "def matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n\n    raise NotImplementedError(\"implement the paper-core reproduction task\")",
          "new_text": "def matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n\n    from scipy.sparse.linalg import eigsh, LinearOperator\n\n    # Input validation\n    if not isinstance(counts, np.ndarray) or counts.ndim != 2:\n        raise ValueError(\"counts must be a 2D numpy array\")\n    counts = counts.astype(np.float64, copy=False)\n    if not np.isfinite(counts).all():\n        raise ValueError(\"counts contains nonfinite values\")\n    if np.any(counts < 0):\n        raise ValueError(\"counts contains negative values\")\n    if np.any(np.all(counts == 0, axis=1)):\n        raise ValueError(\"counts contains all-zero rows\")\n    n_cells, n_features = counts.shape\n    if not (1 <= n_components < n_cells):\n        raise ValueError(\"n_components must be between 1 and n_cells-1\")\n\n    # Row normalization\n    d = counts.sum(axis=1)  # (n_cells,)\n    d_inv_sqrt = 1.0 / np.sqrt(d)\n\n    # Define linear operator for matrix-free multiplication\n    def matvec(v: np.ndarray) -> np.ndarray:\n        temp1 = v * d_inv_sqrt\n        temp2 = counts.T @ temp1\n        temp3 = counts @ temp2\n        return d_inv_sqrt * temp3\n\n    A = LinearOperator(shape=(n_cells, n_cells), matvec=matvec, dtype=np.float64)\n\n    # Set starting vector for reproducibility\n    rng = np.random.RandomState(random_state)\n    v0 = rng.randn(n_cells).astype(np.float64)\n\n    # Compute leading eigenvalues and eigenvectors\n    eigenvalues, eigenvectors = eigsh(A, k=n_components, which='LA', v0=v0)\n\n    # Reverse to descending order\n    eigenvalues = eigenvalues[::-1]\n    eigenvectors = eigenvectors[:, ::-1]\n\n    return eigenvalues, eigenvectors"
