     logp_no_call: np.ndarray,
     tau_filter: float,
 ) -> tuple[np.ndarray, np.ndarray]:
-    """Return an ordered keep mask and one finite margin per proposed call."""
+    """Return an ordered keep mask and one finite margin per proposed call.
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    All inputs are finite, nonpositive 2D arrays of shape (n_candidates, future_horizon).
+    tau_filter is a finite nonnegative float.
+    """
+    # Validate inputs
+    if not all(isinstance(arr, np.ndarray) for arr in [logp_with_result, logp_call_only, logp_no_call]):
+        raise ValueError("Inputs must be numpy arrays")
+    if logp_with_result.ndim != 2 or logp_call_only.ndim != 2 or logp_no_call.ndim != 2:
+        raise ValueError("Inputs must be 2D matrices")
+    if logp_with_result.shape != logp_call_only.shape or logp_with_result.shape != logp_no_call.shape:
+        raise ValueError("Input shapes must match")
+    if not np.all(np.isfinite([logp_with_result, logp_call_only, logp_no_call])):
+        raise ValueError("Inputs must be finite")
+    if np.any(logp_with_result > 0) or np.any(logp_call_only > 0) or np.any(logp_no_call > 0):
+        raise ValueError("Input log probabilities must be nonpositive")
+    if isinstance(tau_filter, bool) or not isinstance(tau_filter, (int, float)):
+        raise ValueError("tau_filter must be a finite nonnegative number, not boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    # Compute normalized decreasing weights
+    n_candidates, horizon = logp_with_result.shape
+    t = np.arange(horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    norm_weights = raw_weights / raw_weights.sum()
+
+    # Weighted loss
+    def weighted_loss(logprobs: np.ndarray) -> np.ndarray:
+        return -np.dot(logprobs, norm_weights)  # shape (n_candidates,)
+
+    L_plus = weighted_loss(logp_with_result)
+    L_call_only = weighted_loss(logp_call_only)
+    L_no_call = weighted_loss(logp_no_call)
+    L_minus = np.minimum(L_no_call, L_call_only)
+
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin
