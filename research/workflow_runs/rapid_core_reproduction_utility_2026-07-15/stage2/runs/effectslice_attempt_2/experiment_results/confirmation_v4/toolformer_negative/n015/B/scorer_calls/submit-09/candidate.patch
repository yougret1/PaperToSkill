--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -12,5 +12,27 @@
     tau_filter: float,
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
-
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Input validation
+    if not isinstance(tau_filter, (int, float)) or isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must be a finite nonnegative number, not a boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+    for name, arr in [("logp_with_result", logp_with_result), ("logp_call_only", logp_call_only), ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray) or arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D numpy array")
+        if arr.size == 0:
+            raise ValueError(f"{name} is empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains nonfinite values")
+        if (arr > 0).any():
+            raise ValueError(f"{name} contains positive values")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input arrays must have the same shape")
+    # Compute total log probabilities over the future horizon
+    total_with = np.sum(logp_with_result, axis=1)
+    total_call = np.sum(logp_call_only, axis=1)
+    total_no = np.sum(logp_no_call, axis=1)
+    # Compute margin as logp_with_result advantage over best alternative
+    margins = total_with - np.maximum(total_call, total_no)
+    keep = margins > tau_filter
+    return keep, margins
