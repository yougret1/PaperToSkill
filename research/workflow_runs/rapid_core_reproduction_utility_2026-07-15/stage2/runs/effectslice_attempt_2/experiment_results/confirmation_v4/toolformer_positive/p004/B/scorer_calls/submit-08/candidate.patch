--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -12,5 +12,40 @@
     tau_filter: float,
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
-
-    raise NotImplementedError("implement the paper-core reproduction task")
+    
+    # Validate inputs
+    for name, mat in [("logp_with_result", logp_with_result), ("logp_call_only", logp_call_only), ("logp_no_call", logp_no_call)]:
+        if not isinstance(mat, np.ndarray) or mat.ndim != 2:
+            raise ValueError(f"{name} must be a 2D numpy array")
+        if mat.shape[0] == 0 or mat.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(mat)):
+            raise ValueError(f"{name} must contain only finite values")
+        if np.any(mat > 0):
+            raise ValueError(f"{name} must be nonpositive")
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All matrices must have the same shape")
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not isinstance(tau_filter, (int, float, np.floating)):
+        raise ValueError("tau_filter must be a number")
+    if not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be finite")
+    if tau_filter < 0:
+        raise ValueError("tau_filter must be nonnegative")
+    
+    # Compute losses (negative log-likelihood)
+    loss_with_result = -np.sum(logp_with_result, axis=1)
+    loss_call_only = -np.sum(logp_call_only, axis=1)
+    loss_no_call = -np.sum(logp_no_call, axis=1)
+    
+    # Compute margin: reduction in loss when using the API call with result vs no call
+    margin = loss_no_call - loss_with_result
+    
+    # Keep if margin exceeds threshold AND using the API call with result is better than without result
+    keep_mask = (margin > tau_filter) & (loss_with_result < loss_call_only)
+    
+    # Return keep_mask as boolean array and margins as finite floats
+    return keep_mask, margin
