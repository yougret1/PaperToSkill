 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not isinstance(tau_filter, (int, float)):
+        raise ValueError("tau_filter must be a finite nonnegative number")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    # Validate matrices
+    for name, arr in [("logp_with_result", logp_with_result), ("logp_call_only", logp_call_only), ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be 2-dimensional")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains nonfinite values")
+        if (arr > 0).any():
+            raise ValueError(f"{name} contains positive values (log probabilities must be nonpositive)")
+
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    n, future_horizon = logp_with_result.shape
+
+    # Normalized weights
+    t = np.arange(future_horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    norm_weights = raw_weights / np.sum(raw_weights)
+
+    # Weighted losses
+    L_plus = -np.sum(norm_weights * logp_with_result, axis=1)
+    L_call_only = -np.sum(norm_weights * logp_call_only, axis=1)
+    L_empty = -np.sum(norm_weights * logp_no_call, axis=1)
+
+    L_minus = np.minimum(L_empty, L_call_only)
+
+    margins = L_minus - L_plus
+    keep = margins >= tau_filter
+
+    return keep, margins.astype(float)
