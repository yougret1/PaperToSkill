          "new_text": "def matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n    if not np.isfinite(counts).all():\n        raise ValueError(\"counts must be finite\")\n    if np.any(counts < 0):\n        raise ValueError(\"counts must be nonnegative\")\n    if np.any(np.all(counts == 0, axis=1)):\n        raise ValueError(\"counts must not have all-zero rows\")\n    n_cells, n_features = counts.shape\n    if not (1 <= n_components < n_cells):\n        raise ValueError(\"n_components must be between 1 and n_cells - 1 inclusive\")\n    col_sums = np.sum(counts, axis=0)\n    row_sums_similarity = counts @ col_sums  # shape (n_cells,)\n    D_inv_sqrt = 1.0 / np.sqrt(row_sums_similarity)\n    from scipy.sparse.linalg import LinearOperator, eigsh\n    def matvec(v):\n        a = v * D_inv_sqrt\n        b = counts.T @ a\n        c = counts @ b\n        d = c * D_inv_sqrt\n        return d\n    op = LinearOperator((n_cells, n_cells), matvec=matvec, dtype=counts.dtype)\n    rng = np.random.RandomState(random_state)\n    v0 = rng.normal(size=n_cells)\n    v0 = v0 / np.linalg.norm(v0)\n    eigenvalues, eigenvectors = eigsh(op, k=n_components, which='LM', v0=v0)\n    idx = np.argsort(eigenvalues)[::-1]\n    eigenvalues = eigenvalues[idx]\n    eigenvectors = eigenvectors[:, idx]\n    return eigenvalues, eigenvectors"
