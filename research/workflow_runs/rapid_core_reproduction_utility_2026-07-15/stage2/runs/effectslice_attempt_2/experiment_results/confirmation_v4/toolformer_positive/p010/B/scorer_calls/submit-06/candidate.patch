+        raise ValueError("All three input matrices must have the same shape")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean value")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    # Compute losses
+    loss_no_call = -np.sum(logp_no_call, axis=1)
+    loss_call_only = -np.sum(logp_call_only, axis=1)
