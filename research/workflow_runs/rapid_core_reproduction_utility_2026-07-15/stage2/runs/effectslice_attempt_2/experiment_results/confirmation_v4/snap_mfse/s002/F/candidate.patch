+        raise ValueError("n_components must be between 1 and n_cells-1")
+    
+    # IDF scaling
+    df = np.count_nonzero(counts > 0, axis=0)
+    idf = np.log(n_cells / (1.0 + df))
+    scaled = counts * idf
+    
+    # Row L2 normalization
+    row_norms = np.linalg.norm(scaled, axis=1)
+    if np.any(row_norms == 0) or np.any(~np.isfinite(row_norms)):
+        raise ValueError("some rows have zero or nonfinite norm")
+    X = scaled / row_norms[:, np.newaxis]
+    
+    # Degree vector: d = X @ (X.T @ ones) - 1
+    ones = np.ones(n_cells)
+    X_T_ones = X.T @ ones
+    d = X @ X_T_ones - 1.0
+    if np.any(d <= 0):
+        raise ValueError("nonpositive degree encountered")
+    
+    D_inv = 1.0 / d
+    D_inv_sqrt = np.sqrt(D_inv)
+    X_tilde = X * D_inv_sqrt[:, np.newaxis]
+    
+    # Define matrix-free linear operator
+    def matvec(v):
+        return X_tilde @ (X_tilde.T @ v) - D_inv * v
