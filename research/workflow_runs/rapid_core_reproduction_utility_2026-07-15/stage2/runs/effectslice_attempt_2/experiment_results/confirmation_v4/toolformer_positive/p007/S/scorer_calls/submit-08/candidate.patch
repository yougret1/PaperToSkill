 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr, name in [(logp_with_result, 'logp_with_result'), 
+                      (logp_call_only, 'logp_call_only'), 
+                      (logp_no_call, 'logp_no_call')]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} is empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input arrays must have same shape")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+    
+    n_candidates, future_horizon = logp_with_result.shape
+    # Compute normalized weights
+    raw_weights = np.maximum(0, 1 - 0.2 * np.arange(future_horizon, dtype=float))
+    normalized_weights = raw_weights / raw_weights.sum() if raw_weights.sum() > 0 else raw_weights
+    # Compute weighted losses
+    L_plus = -np.sum(normalized_weights * logp_with_result, axis=1)
+    L_call_only = -np.sum(normalized_weights * logp_call_only, axis=1)
+    L_empty = -np.sum(normalized_weights * logp_no_call, axis=1)
+    L_minus = np.minimum(L_empty, L_call_only)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+    return keep, margin
