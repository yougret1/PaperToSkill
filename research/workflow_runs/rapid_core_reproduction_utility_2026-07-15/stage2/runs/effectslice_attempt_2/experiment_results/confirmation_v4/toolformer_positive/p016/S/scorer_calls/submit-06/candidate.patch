+            raise ValueError("Input must be numpy arrays")
+        if arr.ndim != 2:
+            raise ValueError("Input matrices must be 2D")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError("Input matrices must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError("Input matrices must be finite")
+        if np.any(arr > 0):
+            raise ValueError("Input matrices must be nonpositive")
+    # Check shape match
+    shape = logp_with_result.shape
+    if logp_call_only.shape != shape or logp_no_call.shape != shape:
+        raise ValueError("Input matrices must have same shape")
+    # Validate threshold
+    if isinstance(tau_filter, bool):
+        raise ValueError("Boolean threshold is invalid")
+    if not isinstance(tau_filter, (int, float)):
+        raise ValueError("Threshold must be numeric")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("Threshold must be finite and nonnegative")
+    T = shape[1]
+    t = np.arange(T)
