 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite nonnegative")
+    for arr in (logp_with_result, logp_call_only, logp_no_call):
+        if arr.ndim != 2:
+            raise ValueError("Input matrices must be 2D")
+        if arr.size == 0:
+            raise ValueError("Input matrices must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError("Input matrices must be finite")
+        if np.any(arr > 0):
+            raise ValueError("Input matrices must be nonpositive")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("Input matrices must have the same shape")
+    
+    n_candidates, future_horizon = logp_with_result.shape
+    # Compute normalized weights
+    raw_weights = np.maximum(0, 1 - 0.2 * np.arange(future_horizon))
+    normalized_weights = raw_weights / raw_weights.sum()
+    
+    # Compute weighted losses
+    def weighted_loss(logp):
+        return -np.sum(normalized_weights * logp, axis=1)
+    
+    L_plus = weighted_loss(logp_with_result)
+    L_call_only = weighted_loss(logp_call_only)
+    L_no_call = weighted_loss(logp_no_call)
+    L_minus = np.minimum(L_call_only, L_no_call)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+    return keep, margin
