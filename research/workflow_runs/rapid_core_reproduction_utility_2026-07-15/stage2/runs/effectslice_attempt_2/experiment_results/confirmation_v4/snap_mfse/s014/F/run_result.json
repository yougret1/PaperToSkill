          "old_text": "def matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n\n    raise NotImplementedError(\"implement the paper-core reproduction task\")",
          "new_text": "def matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\n\n    Implements the matrix-free spectral embedding from SnapATAC2\n    paper lines 73-79.  Input is a 2-D cell-by-feature count matrix.\n    Returns eigenvalues in descending order and cell embedding matrix.\n    \"\"\"\n    n_cells, n_features = counts.shape\n\n    # Input validation\n    if n_components < 1 or n_components >= n_cells:\n        raise ValueError(\n            f\"n_components must be in [1, n_cells), got {n_components}\"\n        )\n    if not np.isfinite(counts).all():\n        raise ValueError(\"Input contains nonfinite values\")\n    if np.any(counts < 0):\n        raise ValueError(\"Input contains negative values\")\n    # Check for all-zero rows (cannot L2-normalize)\n    row_zero = np.all(counts == 0, axis=1)\n    if np.any(row_zero):\n        raise ValueError(\"Input contains all-zero cell rows\")\n\n    # A01: IDF scaling\n    freqs = np.count_nonzero(counts, axis=0)          # document frequency per feature\n    idf = np.log(n_cells / (1.0 + freqs))             # log(n / (1 + df))\n    X = counts * idf.astype(counts.dtype)             # scale\n\n    # A02: row normalization (L2)\n    row_norms = np.linalg.norm(X, axis=1)\n    if np.any(row_norms == 0):\n        raise ValueError(\"Row L2 norm is zero after IDF scaling\")\n    X = X / row_norms[:, np.newaxis]\n\n    # A03: degree vector without building W\n    ones = np.ones(n_cells)\n    degree = X @ (X.T @ ones) - ones                  # d = X (X^T 1) - 1\n\n    # Check positive degrees\n    if np.any(degree <= 0):\n        raise ValueError(\"All degrees must be positive\")\n\n    # A04: prepare normalized linear operator\n    sqrt_recip_d = 1.0 / np.sqrt(degree)               # D^{-1/2}\n    recip_d = 1.0 / degree                             # D^{-1}\n    X_tilde = X * sqrt_recip_d[:, np.newaxis]          # D^{-1/2} X\n\n    # Linear operator for L = D^{-1/2} W D^{-1/2}\n    def matvec(v):\n        return X_tilde @ (X_tilde.T @ v) - recip_d * v\n\n    Lop = spla.LinearOperator(\n        (n_cells, n_cells), matvec=matvec, dtype=X.dtype\n    )\n\n    # A05: Lanczos eigensolver\n    rng = np.random.RandomState(random_state)\n    v0 = rng.randn(n_cells)\n\n    eigenvalues, eigenvectors = spla.eigsh(\n        Lop,\n        k=n_components,\n        which='LA',\n        tol=0,\n        maxiter=None,\n        v0=v0,\n    )\n    # eigsh returns eigenvalues in ascending order; reverse to descending\n    eigenvalues = eigenvalues[::-1]\n    eigenvectors = eigenvectors[:, ::-1]\n\n    return eigenvalues, eigenvectors"
