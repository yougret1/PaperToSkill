     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr, name in [(logp_with_result, 'logp_with_result'),
+                      (logp_call_only, 'logp_call_only'),
+                      (logp_no_call, 'logp_no_call')]:
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains nonfinite values")
+        if (arr > 0).any():
+            raise ValueError(f"{name} contains positive values")
+
+    shape = logp_with_result.shape
+    if logp_call_only.shape != shape or logp_no_call.shape != shape:
+        raise ValueError("all input matrices must have identical shape")
+
+    # Validate tau_filter
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be a boolean")
+    tau_filter = float(tau_filter)
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    # Compute normalized weights
+    horizon = shape[1]
+    t = np.arange(horizon)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    weights = raw_weights / raw_weights.sum()
+
+    # Weighted losses (negative weighted log probabilities)
+    L_plus = -np.dot(logp_with_result, weights)
+    L_call_only = -np.dot(logp_call_only, weights)
+    L_no_call = -np.dot(logp_no_call, weights)
+
+    L_minus = np.minimum(L_no_call, L_call_only)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin
