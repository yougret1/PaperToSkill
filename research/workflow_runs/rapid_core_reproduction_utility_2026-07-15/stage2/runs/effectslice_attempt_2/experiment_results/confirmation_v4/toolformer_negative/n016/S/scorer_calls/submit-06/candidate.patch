 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be boolean")
+    tau_filter = float(tau_filter)
+    if tau_filter < 0 or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be nonnegative finite")
+    arrays = [
+        (logp_with_result, "logp_with_result"),
+        (logp_call_only, "logp_call_only"),
+        (logp_no_call, "logp_no_call"),
+    ]
+    for arr, name in arrays:
+        if not isinstance(arr, np.ndarray) or arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D numpy array")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} must contain only finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} must be nonpositive")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("all input matrices must have the same shape")
+    n_candidates, horizon = logp_with_result.shape
+    if horizon == 0:
+        raise ValueError("future horizon must be positive")
+    # Compute normalized decreasing weights
+    t = np.arange(horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    weights = raw_weights / np.sum(raw_weights)
+    # Weighted sums
+    ws_with = np.sum(weights * logp_with_result, axis=1)
+    ws_call = np.sum(weights * logp_call_only, axis=1)
+    ws_no = np.sum(weights * logp_no_call, axis=1)
+    # Best baseline and margin
+    best_baseline = np.maximum(ws_call, ws_no)
+    margin = ws_with - best_baseline
+    keep = margin > tau_filter
+    return keep, margin
