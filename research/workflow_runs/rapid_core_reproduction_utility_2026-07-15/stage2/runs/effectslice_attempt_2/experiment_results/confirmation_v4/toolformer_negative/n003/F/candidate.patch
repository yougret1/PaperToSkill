+    # Validate inputs
+    if not isinstance(logp_with_result, np.ndarray) or not isinstance(logp_call_only, np.ndarray) or not isinstance(logp_no_call, np.ndarray):
+        raise ValueError("Inputs must be NumPy arrays")
+    if logp_with_result.ndim != 2 or logp_call_only.ndim != 2 or logp_no_call.ndim != 2:
+        raise ValueError("Inputs must be 2D matrices")
+    if logp_with_result.size == 0 or logp_call_only.size == 0 or logp_no_call.size == 0:
+        raise ValueError("Input matrices must not be empty")
+    n_candidates, horizon = logp_with_result.shape
+    if horizon == 0:
+        raise ValueError("Future horizon must be at least 1")
+    if logp_call_only.shape != (n_candidates, horizon) or logp_no_call.shape != (n_candidates, horizon):
+        raise ValueError("All input matrices must have the same shape")
+    if not np.all(np.isfinite(logp_with_result)) or not np.all(np.isfinite(logp_call_only)) or not np.all(np.isfinite(logp_no_call)):
+        raise ValueError("Log probabilities must be finite")
+    if np.any(logp_with_result > 0) or np.any(logp_call_only > 0) or np.any(logp_no_call > 0):
+        raise ValueError("Log probabilities must be nonpositive")
+    if isinstance(tau_filter, bool) or not isinstance(tau_filter, (int, float)):
+        raise ValueError("tau_filter must be a finite nonnegative float")
+    if np.isnan(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite nonnegative")
+
+    # Compute normalized weights according to T01
+    t = np.arange(horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    weight_sum = raw_weights.sum()
+    if weight_sum == 0:
+        normalized_weights = np.zeros(horizon)
+    else:
+        normalized_weights = raw_weights / weight_sum
+
+    # Compute weighted future-token loss for each conditioning prefix (T02)
+    loss_with = -np.sum(logp_with_result * normalized_weights, axis=1)
+    loss_call_only = -np.sum(logp_call_only * normalized_weights, axis=1)
+    loss_no_call = -np.sum(logp_no_call * normalized_weights, axis=1)
+
+    # Use the stronger counterfactual baseline (T03)
+    loss_minus = np.minimum(loss_no_call, loss_call_only)
+
+    # Margin and keep decision (T04)
+    margin = loss_minus - loss_with
+    keep = margin >= tau_filter
+
+    return keep.astype(bool), margin.astype(float)
