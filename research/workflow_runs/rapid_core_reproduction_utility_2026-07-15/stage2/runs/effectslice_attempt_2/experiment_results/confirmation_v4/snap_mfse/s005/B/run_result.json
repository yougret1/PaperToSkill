          "new_text": "def matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n    # Input validation\n    if not np.all(np.isfinite(counts)):\n        raise ValueError(\"Input contains non-finite values\")\n    if np.any(counts < 0):\n        raise ValueError(\"Input contains negative values\")\n    if np.any(np.all(counts == 0, axis=1)):\n        raise ValueError(\"Input contains all-zero rows\")\n    n_cells, n_features = counts.shape\n    if n_components < 1 or n_components >= n_cells:\n        raise ValueError(\"n_components must be in 1 <= n_components < n_cells\")\n\n    # Row normalization to unit L2 norm\n    row_norms = np.sqrt(np.sum(counts ** 2, axis=1))\n    N_norm = counts / row_norms[:, np.newaxis]\n\n    # Compute degree vector D\n    col_sum = N_norm.sum(axis=0)\n    D = N_norm @ col_sum\n    D_inv_sqrt = 1.0 / np.sqrt(D)\n\n    # Linear operator for K = D^{-1/2} W D^{-1/2}\n    def matvec(v):\n        x = D_inv_sqrt * v\n        y = N_norm.T @ x\n        z = N_norm @ y\n        return D_inv_sqrt * z\n\n    import scipy.sparse.linalg as spla\n    n = n_cells\n    K_op = spla.LinearOperator((n, n), matvec=matvec, dtype=np.float64)\n\n    np.random.seed(random_state)\n    eigenvalues, eigenvectors = spla.eigsh(K_op, k=n_components, which='LM', tol=1e-6)\n\n    # Sort descending\n    idx = np.argsort(eigenvalues)[::-1]\n    eigenvalues = eigenvalues[idx]\n    eigenvectors = eigenvectors[:, idx]\n\n    return eigenvalues, eigenvectors"
