+    # Input validation
+    if not all(isinstance(arr, np.ndarray) for arr in [logp_with_result, logp_call_only, logp_no_call]):
+        raise ValueError("All inputs must be numpy arrays")
+    if logp_with_result.ndim != 2 or logp_call_only.ndim != 2 or logp_no_call.ndim != 2:
+        raise ValueError("All inputs must be 2D matrices")
+    if logp_with_result.shape != logp_call_only.shape or logp_with_result.shape != logp_no_call.shape:
+        raise ValueError("All inputs must have the same shape")
+    n, m = logp_with_result.shape
+    if n == 0 or m == 0:
+        raise ValueError("Matrices must not be empty")
+    if not (np.all(np.isfinite(logp_with_result)) and np.all(np.isfinite(logp_call_only)) and np.all(np.isfinite(logp_no_call))):
+        raise ValueError("All inputs must be finite")
+    if np.any(logp_with_result > 0) or np.any(logp_call_only > 0) or np.any(logp_no_call > 0):
+        raise ValueError("All inputs must be nonpositive")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be boolean")
+    if not isinstance(tau_filter, (int, float, np.floating, np.integer)):
+        raise ValueError("tau_filter must be a finite nonnegative number")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
