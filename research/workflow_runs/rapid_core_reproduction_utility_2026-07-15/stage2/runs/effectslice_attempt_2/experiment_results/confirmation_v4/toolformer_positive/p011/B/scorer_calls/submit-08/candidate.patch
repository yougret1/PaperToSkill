+        raise ValueError("All inputs must have the same shape")
+    # Check tau_filter
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter cannot be boolean")
+    if not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be finite")
+    if tau_filter < 0:
+        raise ValueError("tau_filter must be nonnegative")
+
+    # Compute losses (negative log likelihood summed over tokens)
+    loss_with_result = -np.sum(logp_with_result, axis=1)
+    loss_call_only = -np.sum(logp_call_only, axis=1)
+    loss_no_call = -np.sum(logp_no_call, axis=1)
+
+    # Improvement over no call
+    margin = loss_no_call - loss_with_result
+
+    # Keep if margin >= tau and result helps over call-only
+    keep = (margin >= tau_filter) & (loss_call_only - loss_with_result > 0)
