+        if not isinstance(arr, np.ndarray):
+            raise ValueError("Input must be numpy ndarray")
+        if arr.ndim != 2:
+            raise ValueError("Input must be 2D matrix")
+        if arr.size == 0:
+            raise ValueError("Input cannot be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError("Input contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError("Input contains positive values")
+    # Check shapes
+    shape = logp_with_result.shape
