+            raise ValueError(f"{name} contains positive values")
+
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    # Validate tau_filter
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be a boolean")
+    if not isinstance(tau_filter, (int, float, np.floating, np.integer)):
+        raise ValueError("tau_filter must be a numeric value")
+    if tau_filter < 0 or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be a nonnegative finite number")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Compute normalized weights (T01)
+    raw_weights = np.maximum(0, 1 - 0.2 * np.arange(future_horizon, dtype=float))
+    weights = raw_weights / raw_weights.sum()
+
+    # Weighted losses (T02)
+    L_plus = -np.dot(logp_with_result, weights)
