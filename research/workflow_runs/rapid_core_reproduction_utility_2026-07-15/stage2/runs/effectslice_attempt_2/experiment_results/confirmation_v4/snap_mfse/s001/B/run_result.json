          "new_text": "def matrix_free_spectral_embedding(\n    counts: np.ndarray,\n    n_components: int,\n    random_state: int = 0,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return leading spectral coordinates for a cell-by-feature count matrix.\"\"\"\n    from scipy.sparse.linalg import LinearOperator, eigsh\n\n    # Input validation\n    if not np.isfinite(counts).all():\n        raise ValueError(\"counts contains nonfinite values\")\n    if (counts < 0).any():\n        raise ValueError(\"counts contains negative values\")\n    n_cells, n_features = counts.shape\n    if not (1 <= n_components < n_cells):\n        raise ValueError(\"n_components must satisfy 1 <= n_components < n_cells\")\n    row_sums = counts.sum(axis=1)\n    if (row_sums == 0).any():\n        raise ValueError(\"counts contains all-zero cell rows\")\n\n    # Reproducible initial vector\n    rng = np.random.RandomState(random_state)\n\n    # Compute degree D_i = X_i dot col_sums (matrix-free)\n    col_sums = counts.sum(axis=0)\n    D = counts @ col_sums  # (n_cells,)\n    inv_sqrt_D = np.where(D > 0, 1.0 / np.sqrt(D), 0.0)\n\n    # Linear operator for K_norm = D^{-1/2} X X^T D^{-1/2}\n    def matvec(v):\n        w = inv_sqrt_D * v\n        temp = counts.T @ w\n        temp2 = counts @ temp\n        return inv_sqrt_D * temp2\n\n    A = LinearOperator((n_cells, n_cells), matvec=matvec, dtype=counts.dtype)\n\n    # Compute leading n_components eigenvalues and eigenvectors\n    v0 = rng.randn(n_cells)\n    eigenvalues, eigenvectors = eigsh(A, k=n_components, which='LM', v0=v0)\n    # eigsh returns in ascending order; reverse for descending\n    eigenvalues = eigenvalues[::-1]\n    eigenvectors = eigenvectors[:, ::-1]\n\n    if not np.isfinite(eigenvalues).all() or not np.isfinite(eigenvectors).all():\n        raise ValueError(\"numerical instability: nonfinite output\")\n\n    return eigenvalues, eigenvectors"
