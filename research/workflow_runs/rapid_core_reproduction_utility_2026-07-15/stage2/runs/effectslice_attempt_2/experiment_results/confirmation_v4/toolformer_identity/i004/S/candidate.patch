-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr in [logp_with_result, logp_call_only, logp_no_call]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError("Inputs must be numpy arrays")
+        if arr.ndim != 2:
+            raise ValueError("Inputs must be 2D matrices")
+        if not np.isfinite(arr).all():
+            raise ValueError("Inputs must be finite")
+        if (arr > 0).any():
+            raise ValueError("Inputs must be nonpositive")
+        if arr.size == 0:
+            raise ValueError("Inputs cannot be empty")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be finite")
+    if tau_filter < 0:
+        raise ValueError("tau_filter must be nonnegative")
+
+    n, horizon = logp_with_result.shape
+    t = np.arange(horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    weight_sum = raw_weights.sum()
+    w_norm = raw_weights / weight_sum
+
+    L_plus = -np.sum(logp_with_result * w_norm, axis=1)
+    L_call_only = -np.sum(logp_call_only * w_norm, axis=1)
+    L_no_call = -np.sum(logp_no_call * w_norm, axis=1)
+
+    L_minus = np.minimum(L_no_call, L_call_only)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin
