--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -13,4 +13,53 @@
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate tau_filter
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be a boolean")
+    if not isinstance(tau_filter, (int, float, np.floating)):
+        raise ValueError("tau_filter must be a numeric type")
+    if tau_filter < 0 or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be nonnegative and finite")
+
+    # Validate input arrays
+    for arr, name in [
+        (logp_with_result, "logp_with_result"),
+        (logp_call_only, "logp_call_only"),
+        (logp_no_call, "logp_no_call"),
+    ]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.issubdtype(arr.dtype, np.floating):
+            raise ValueError(f"{name} must have floating dtype")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains non-finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All three matrices must have the same shape")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Compute normalized decreasing weights
+    t = np.arange(future_horizon, dtype=float)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    total_raw = np.sum(raw_weights)
+    if total_raw == 0.0:
+        raise ValueError("All raw weights are zero; future horizon may be too large?")
+    weights = raw_weights / total_raw
+
+    # Weighted future-token loss (negative weighted log probability)
+    L_plus = -np.dot(logp_with_result, weights)
+    L_call = -np.dot(logp_call_only, weights)
+    L_empty = -np.dot(logp_no_call, weights)
+
+    L_minus = np.minimum(L_empty, L_call)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin.astype(np.float64)
