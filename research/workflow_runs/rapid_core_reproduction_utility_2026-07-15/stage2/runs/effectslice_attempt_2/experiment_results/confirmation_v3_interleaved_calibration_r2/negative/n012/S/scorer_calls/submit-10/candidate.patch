@@ -13,4 +13,50 @@
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for name, arr in [("logp_with_result", logp_with_result),
+                       ("logp_call_only", logp_call_only),
+                       ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    # Check shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a Boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Compute normalized decreasing weights
+    t = np.arange(future_horizon, dtype=float)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    weight_sum = np.sum(raw_weights)
+    if weight_sum == 0:
+        # All weights zero -> set uniform weights (should not happen with finite horizon)
+        normalized_weights = np.full_like(raw_weights, 1.0 / future_horizon)
+    else:
+        normalized_weights = raw_weights / weight_sum
+
+    # Weighted averages (dot product each row with normalized weights)
+    w_avg_no_call = logp_no_call @ normalized_weights
+    w_avg_call_only = logp_call_only @ normalized_weights
+    w_avg_with_result = logp_with_result @ normalized_weights
+
+    # Compute margin: improvement in loss (higher is better)
+    margin = np.maximum(w_avg_with_result, w_avg_call_only) - w_avg_no_call
+    keep = margin > tau_filter
+
+    return keep, margin
