 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for name, mat in [("logp_with_result", logp_with_result),
+                      ("logp_call_only", logp_call_only),
+                      ("logp_no_call", logp_no_call)]:
+        if not isinstance(mat, np.ndarray):
+            raise ValueError(f"{name} must be a NumPy array")
+        if mat.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if mat.shape[0] == 0 or mat.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(mat)):
+            raise ValueError(f"{name} must contain only finite values")
+        if np.any(mat > 0):
+            raise ValueError(f"{name} must be nonpositive")
+
+    # Check shapes match
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("all matrices must have the same shape")
+
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be a boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be a finite nonnegative scalar")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Compute normalized future-token weights
+    raw = np.maximum(0, 1.0 - 0.2 * np.arange(future_horizon, dtype=float))
+    norm = raw / raw.sum()
+
+    # Helper to compute weighted loss
+    def weighted_loss(logp):
+        return -np.sum(norm[np.newaxis, :] * logp, axis=1)
+
+    L_plus = weighted_loss(logp_with_result)
+    L_call_only = weighted_loss(logp_call_only)
+    L_no_call = weighted_loss(logp_no_call)
+
+    L_minus = np.minimum(L_no_call, L_call_only)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin
