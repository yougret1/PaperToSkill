+        raise ValueError("shapes of the three matrices must match")
+    # Validate tau_filter
+    # Ensure scalar
+    if np.ndim(tau_filter) != 0:
+        raise ValueError("tau_filter must be a scalar")
+    # Reject boolean (including numpy bool)
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be a boolean")
