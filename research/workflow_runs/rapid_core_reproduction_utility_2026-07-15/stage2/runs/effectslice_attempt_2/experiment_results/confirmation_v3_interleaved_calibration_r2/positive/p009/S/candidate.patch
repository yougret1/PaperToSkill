+    for arr, name in [(logp_with_result, "logp_with_result"), (logp_call_only, "logp_call_only"), (logp_no_call, "logp_no_call")]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if not np.all(arr <= 0):
+            raise ValueError(f"{name} must contain only nonpositive values")
+    # Check shape consistency
+    shape = logp_with_result.shape
+    if logp_call_only.shape != shape or logp_no_call.shape != shape:
+        raise ValueError("All input matrices must have the same shape")
+    # Validate tau_filter
+    if not isinstance(tau_filter, (int, float)) or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be a finite number")
+    if tau_filter < 0:
+        raise ValueError("tau_filter must be nonnegative")
+    # Compute normalized weights
+    horizon = shape[1]
+    t = np.arange(horizon, dtype=float)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    norm_weights = raw_weights / raw_weights.sum()
+    # Compute weighted negative log probability for each candidate
+    def weighted_loss(logp):
+        return -np.dot(logp, norm_weights)  # (n_candidates,) dot (horizon,) gives (n_candidates,)
+    L_plus = weighted_loss(logp_with_result)
+    L_call_only = weighted_loss(logp_call_only)
+    L_empty = weighted_loss(logp_no_call)
