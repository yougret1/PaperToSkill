-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate matrices
+    for name, arr in [("logp_with_result", logp_with_result),
+                      ("logp_call_only", logp_call_only),
+                      ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty (shape {arr.shape})")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    # Check shape consistency
+    n_candidates = logp_with_result.shape[0]
+    future_horizon = logp_with_result.shape[1]
+    if logp_call_only.shape != (n_candidates, future_horizon) or logp_no_call.shape != (n_candidates, future_horizon):
+        raise ValueError("All three log probability matrices must have the same shape")
+
+    # Compute normalized weights per T01
+    t = np.arange(future_horizon, dtype=np.float64)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    sum_weights = np.sum(raw_weights)
+    normalized_weights = raw_weights / sum_weights  # shape (future_horizon,)
+
+    # Compute weighted losses per T02
+    def weighted_loss(log_probs):
+        return -np.sum(normalized_weights * log_probs, axis=1)  # shape (n_candidates,)
+
+    L_plus = weighted_loss(logp_with_result)
+    L_empty = weighted_loss(logp_no_call)
+    L_call_only = weighted_loss(logp_call_only)
+
+    # Stronger counterfactual baseline per T03
+    L_minus = np.minimum(L_empty, L_call_only)
+
+    # Compute margins and apply filtering threshold per T04
+    margins = L_minus - L_plus
+    keep_mask = margins >= tau
+
+    return np.asarray(keep_mask), np.asarray(margins)
