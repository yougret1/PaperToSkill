      "observation_status": "ok",
      "observation_message": "1: \"\"\"Starter module for the locked Toolformer loss-filter task.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import numpy as np\n6: \n7: \n8: def filter_api_calls(\n9:     logp_with_result: np.ndarray,\n10:     logp_call_only: np.ndarray,\n11:     logp_no_call: np.ndarray,\n12:     tau_filter: float,\n13: ) -> tuple[np.ndarray, np.ndarray]:\n14:     \"\"\"Return an ordered keep mask and one finite margin per proposed call.\"\"\"\n15: \n16:     # Validate inputs\n17:     if not isinstance(logp_with_result, np.ndarray) or not isinstance(logp_call_only, np.ndarray) or not isinstance(logp_no_call, np.ndarray):\n18:         raise ValueError(\"Inputs must be NumPy arrays\")\n19:     for arr in [logp_with_result, logp_call_only, logp_no_call]:\n20:         if arr.ndim != 2:\n21:             raise ValueError(\"Inputs must be two-dimensional\")\n22:         if arr.size == 0:\n23:             raise ValueError(\"Inputs must not be empty\")\n24:         if not np.all(np.isfinite(arr)):\n25:             raise ValueError(\"Inputs must be finite\")\n26:         if np.any(arr > 0):\n27:             raise ValueError(\"Inputs must be nonpositive\")\n28:     # Check shapes\n29:     shape = logp_with_result.shape\n30:     if logp_call_only.shape != shape or logp_no_call.shape != shape:\n31:         raise ValueError(\"Input shapes must match\")\n32:     # Validate threshold\n33:     if isinstance(tau_filter, bool):\n34:         raise ValueError(\"Invalid threshold: Boolean\")\n35:     if not np.isfinite(tau_filter) or tau_filter < 0:\n36:         raise ValueError(\"Threshold must be finite and nonnegative\")\n37:     \n38:     # Compute margins\n39:     improvement_no_call = logp_with_result - logp_no_call\n40:     improvement_call_only = logp_with_result - logp_call_only\n41:     avg_no_call = np.mean(improvement_no_call, axis=1)\n42:     avg_call_only = np.mean(improvement_call_only, axis=1)\n43:     margins = np.minimum(avg_no_call, avg_call_only)\n44:     keep_mask = margins > tau_filter\n45:     return keep_mask, margins",
