 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter cannot be a boolean")
+    if not np.isscalar(tau_filter):
+        raise ValueError("tau_filter must be a scalar")
+    if not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be finite")
+    if tau_filter < 0:
+        raise ValueError("tau_filter must be nonnegative")
+
+    for arr, name in [(logp_with_result, 'logp_with_result'), (logp_call_only, 'logp_call_only'), (logp_no_call, 'logp_no_call')]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains non-finite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    n_candidates, horizon = logp_with_result.shape
+
+    # Normalize weights
+    t = np.arange(horizon, dtype=float)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    if raw_weights.sum() == 0:
+        norm_weights = np.ones(horizon) / horizon if horizon > 0 else np.array([])
+    else:
+        norm_weights = raw_weights / raw_weights.sum()
+
+    # Compute weighted losses (lower is better)
+    L_plus = -np.dot(logp_with_result, norm_weights)
+    L_call_only = -np.dot(logp_call_only, norm_weights)
+    L_empty = -np.dot(logp_no_call, norm_weights)
+
+    L_minus = np.minimum(L_empty, L_call_only)
+    margins = L_minus - L_plus
+    keep_mask = margins >= tau_filter
+
+    return keep_mask, margins
