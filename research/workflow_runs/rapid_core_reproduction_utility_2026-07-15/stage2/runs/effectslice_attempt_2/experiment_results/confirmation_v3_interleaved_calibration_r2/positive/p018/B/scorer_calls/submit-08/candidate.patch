 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate tau_filter
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter cannot be a boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    # Validate matrices
+    for arr, name in [
+        (logp_with_result, 'logp_with_result'),
+        (logp_call_only, 'logp_call_only'),
+        (logp_no_call, 'logp_no_call'),
+    ]:
+        if not isinstance(arr, np.ndarray) or arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D numpy array")
+        if arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} cannot be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    # Check shapes match
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    # Compute total log probabilities over future horizon (sum over columns)
+    total_with_result = np.sum(logp_with_result, axis=1)
+    total_call_only = np.sum(logp_call_only, axis=1)
+    total_no_call = np.sum(logp_no_call, axis=1)
+
+    # Compute improvements
+    improvement_no_call = total_with_result - total_no_call
+    improvement_call_only = total_with_result - total_call_only
+
+    # Keep condition: improvement over no_call > tau and improvement over call_only > 0
+    keep = (improvement_no_call > tau_filter) & (improvement_call_only > 0)
+
+    # Margins: improvement over no_call (finite)
+    margins = improvement_no_call.astype(np.float64)
+
+    return keep, margins
