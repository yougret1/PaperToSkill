 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate tau_filter is not boolean
+    if isinstance(tau_filter, (bool, np.bool_)):
+        raise ValueError("tau_filter must not be a boolean")
+
+    # Validate input matrices
+    for name, arr in [("logp_with_result", logp_with_result),
+                      ("logp_call_only", logp_call_only),
+                      ("logp_no_call", logp_no_call)]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    # Check shapes match
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    n_candidates, future_horizon = logp_with_result.shape
+
+    # Compute normalized decreasing weights
+    t = np.arange(future_horizon)
+    raw = np.maximum(0, 1 - 0.2 * t)
+    weights = raw / raw.sum()
+
+    # Compute weighted negative log probability losses
+    L_plus = -np.sum(weights[None, :] * logp_with_result, axis=1)
+    L_call_only = -np.sum(weights[None, :] * logp_call_only, axis=1)
+    L_no_call = -np.sum(weights[None, :] * logp_no_call, axis=1)
+
+    # Stronger counterfactual baseline
+    L_minus = np.minimum(L_no_call, L_call_only)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin.astype(np.float64)
