        "new_text": "def filter_api_calls(\n    logp_with_result: np.ndarray,\n    logp_call_only: np.ndarray,\n    logp_no_call: np.ndarray,\n    tau_filter: float,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an ordered keep mask and one finite margin per proposed call.\"\"\"\n    # Validate inputs\n    for x, name in zip([logp_with_result, logp_call_only, logp_no_call],\n                       [\"logp_with_result\", \"logp_call_only\", \"logp_no_call\"]):\n        if not isinstance(x, np.ndarray):\n            raise ValueError(f\"{name} must be a numpy array\")\n        if x.ndim != 2:\n            raise ValueError(f\"{name} must be a 2D matrix\")\n        if x.size == 0:\n            raise ValueError(f\"{name} must not be empty\")\n        if not np.isfinite(x).all():\n            raise ValueError(f\"{name} contains non-finite values\")\n        if (x > 0).any():\n            raise ValueError(f\"{name} contains positive values\")\n    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):\n        raise ValueError(\"All log-probability inputs must have the same shape\")\n    if isinstance(tau_filter, bool) or not np.isfinite(tau_filter) or tau_filter < 0:\n        raise ValueError(\"tau_filter must be a finite nonnegative threshold and not a boolean\")\n    tau_filter = float(tau_filter)\n    # Compute normalized decreasing weights (T01)\n    future_horizon = logp_with_result.shape[1]\n    t = np.arange(future_horizon, dtype=float)\n    raw = np.maximum(0.0, 1.0 - 0.2 * t)\n    norm_weights = raw / raw.sum()\n    # Weighted average log-probabilities\n    wavg_with = np.dot(logp_with_result, norm_weights)\n    wavg_call = np.dot(logp_call_only, norm_weights)\n    wavg_no = np.dot(logp_no_call, norm_weights)\n    # Differences\n    diff_no_call = wavg_with - wavg_no\n    diff_call_only = wavg_with - wavg_call\n    # Keep mask\n    keep = (diff_no_call > tau_filter) & (diff_call_only > tau_filter)\n    # Margins\n    margins = np.minimum(diff_no_call, diff_call_only)\n    return keep, margins"
      },
