--- a/toolformer_filter.py
+++ b/toolformer_filter.py
@@ -13,4 +13,43 @@
 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must be a numeric threshold, not bool")
+    if not np.issubdtype(type(tau_filter), np.floating) and not np.issubdtype(type(tau_filter), np.integer):
+        raise ValueError("tau_filter must be a finite nonnegative number")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+    
+    for arr in [logp_with_result, logp_call_only, logp_no_call]:
+        if not isinstance(arr, np.ndarray) or arr.ndim != 2:
+            raise ValueError("All logp inputs must be 2D numpy arrays")
+        if arr.size == 0:
+            raise ValueError("Input matrices must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError("All logp values must be finite")
+        if np.any(arr > 0):
+            raise ValueError("All logp values must be nonpositive")
+    
+    n_candidates, horizon = logp_with_result.shape
+    if logp_call_only.shape != (n_candidates, horizon) or logp_no_call.shape != (n_candidates, horizon):
+        raise ValueError("All input matrices must have the same shape")
+    
+    # Normalize weights
+    t = np.arange(horizon, dtype=float)
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    weights = raw_weights / raw_weights.sum()
+    
+    # Compute weighted losses (negative weighted log probability)
+    L_plus = -np.sum(weights * logp_with_result, axis=1)
+    L_call_only = -np.sum(weights * logp_call_only, axis=1)
+    L_no_call = -np.sum(weights * logp_no_call, axis=1)
+    
+    # Counterfactual baseline: min of L_no_call and L_call_only
+    L_minus = np.minimum(L_no_call, L_call_only)
+    
+    # Margin and keep mask
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+    
+    return keep, margin
