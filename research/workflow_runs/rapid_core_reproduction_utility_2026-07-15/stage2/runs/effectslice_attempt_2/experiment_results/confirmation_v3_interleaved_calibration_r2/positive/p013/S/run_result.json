          "new_text": "def filter_api_calls(\n    logp_with_result: np.ndarray,\n    logp_call_only: np.ndarray,\n    logp_no_call: np.ndarray,\n    tau_filter: float,\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Return an ordered keep mask and one finite margin per proposed call.\"\"\"\n    # Validate inputs\n    for arr, name in [\n        (logp_with_result, \"logp_with_result\"),\n        (logp_call_only, \"logp_call_only\"),\n        (logp_no_call, \"logp_no_call\"),\n    ]:\n        if not isinstance(arr, np.ndarray) or arr.ndim != 2:\n            raise ValueError(f\"{name} must be a 2D NumPy array\")\n        if arr.size == 0:\n            raise ValueError(f\"{name} must not be empty\")\n        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):\n            raise ValueError(f\"{name} contains nonfinite values\")\n        if np.any(arr > 0):\n            raise ValueError(f\"{name} contains positive values\")\n    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):\n        raise ValueError(\"All input arrays must have the same shape\")\n    if isinstance(tau_filter, bool):\n        raise ValueError(\"tau_filter cannot be a Boolean value\")\n    if not np.isfinite(tau_filter) or tau_filter < 0:\n        raise ValueError(\"tau_filter must be a finite nonnegative number\")\n\n    n_candidates, horizon = logp_with_result.shape\n    # Compute normalized weights\n    t = np.arange(horizon, dtype=float)\n    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)\n    norm_weights = raw_weights / raw_weights.sum()\n\n    # Weighted losses: -sum(weights * log_prob)\n    loss_with_result = -np.sum(norm_weights * logp_with_result, axis=1)\n    loss_call_only = -np.sum(norm_weights * logp_call_only, axis=1)\n    loss_no_call = -np.sum(norm_weights * logp_no_call, axis=1)\n\n    # Stronger counterfactual baseline\n    L_minus = np.minimum(loss_no_call, loss_call_only)\n    margins = L_minus - loss_with_result\n    keep_mask = margins >= tau_filter\n    return keep_mask, margins"
