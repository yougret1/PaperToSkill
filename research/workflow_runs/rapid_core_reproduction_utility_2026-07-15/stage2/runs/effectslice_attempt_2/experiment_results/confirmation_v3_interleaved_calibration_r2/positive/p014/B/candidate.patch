 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr, name in [(logp_with_result, 'logp_with_result'),
+                      (logp_call_only, 'logp_call_only'),
+                      (logp_no_call, 'logp_no_call')]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be a 2D matrix")
+        if arr.size == 0 or arr.shape[0] == 0 or arr.shape[1] == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.isfinite(arr).all():
+            raise ValueError(f"{name} contains non-finite values")
+        if (arr > 0).any():
+            raise ValueError(f"{name} contains positive values")
+
+    # Shape consistency
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    # Validate tau_filter
+    if type(tau_filter) in (bool, np.bool_):
+        raise ValueError("tau_filter must not be a boolean")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    # Compute per-candidate total log probabilities
+    sum_with = logp_with_result.sum(axis=1)
+    sum_call = logp_call_only.sum(axis=1)
+    sum_no = logp_no_call.sum(axis=1)
+
+    # Keep if with_result log prob exceeds both baselines by at least tau
+    keep = (sum_with > sum_no + tau_filter) & (sum_with > sum_call + tau_filter)
+
+    # Margin = min(delta_no, delta_call) - tau
+    delta_no = sum_with - sum_no
+    delta_call = sum_with - sum_call
+    margins = np.minimum(delta_no, delta_call) - tau_filter
+
+    return keep.astype(np.bool_), margins.astype(np.float64)
