 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must not be boolean")
+    if not np.isscalar(tau_filter) or np.isnan(tau_filter) or np.isinf(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite nonnegative scalar")
+    # Validate arrays
+    arrs = [logp_with_result, logp_call_only, logp_no_call]
+    names = ["logp_with_result", "logp_call_only", "logp_no_call"]
+    for arr, name in zip(arrs, names):
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be 2D matrix")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} must be nonpositive")
+    # Check shape consistency
+    shape = logp_with_result.shape
+    if logp_call_only.shape != shape or logp_no_call.shape != shape:
+        raise ValueError("All input matrices must have same shape")
+    n_candidates, horizon = shape
+    # T01: Compute normalized weights
+    t = np.arange(horizon)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    sum_raw = np.sum(raw_weights)
+    if sum_raw <= 0:
+        raise ValueError("Unexpected zero weight sum")
+    norm_weights = raw_weights / sum_raw
+    # T02: Compute weighted losses
+    L_plus = -np.sum(norm_weights * logp_with_result, axis=1)
+    L_call_only = -np.sum(norm_weights * logp_call_only, axis=1)
+    L_no_call = -np.sum(norm_weights * logp_no_call, axis=1)
+    # T03: L_minus = min(L_empty, L_call_only)
+    L_minus = np.minimum(L_no_call, L_call_only)
+    # T04: Compute margin
+    margin = L_minus - L_plus
+    keep_mask = margin >= tau_filter
+    # Ensure output types
+    return keep_mask, margin.astype(float)
