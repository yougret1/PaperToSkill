+
+    # Margin = logp(with_result) - max(logp(call_only), logp(no_call))
+    margins = sum_with - np.maximum(sum_call, sum_no)
+
+    # Keep where margin > tau_filter
+    keep = margins > tau_filter
+
+    return keep, margins
