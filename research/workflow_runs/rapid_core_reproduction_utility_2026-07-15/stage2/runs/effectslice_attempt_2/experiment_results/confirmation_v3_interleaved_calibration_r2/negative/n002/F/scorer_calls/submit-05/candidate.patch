 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr, name in zip([logp_with_result, logp_call_only, logp_no_call],
+                        ["logp_with_result", "logp_call_only", "logp_no_call"]):
+        if not isinstance(arr, np.ndarray):
+            raise ValueError(f"{name} must be a numpy array")
+        if arr.ndim != 2:
+            raise ValueError(f"{name} must be 2-dimensional, got shape {arr.shape}")
+        if arr.size == 0:
+            raise ValueError(f"{name} must not be empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError(f"{name} contains nonfinite values")
+        if np.any(arr > 0):
+            raise ValueError(f"{name} contains positive values")
+
+    # Check shapes match
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("All input matrices must have the same shape")
+
+    # Validate tau_filter
+    if isinstance(tau_filter, bool) or not isinstance(tau_filter, (int, float)):
+        raise ValueError("tau_filter must be a nonnegative numeric value, not a boolean")
+    if tau_filter < 0:
+        raise ValueError("tau_filter must be nonnegative")
+
+    n_candidates, horizon = logp_with_result.shape
+
+    # Compute normalized decreasing weights
+    t = np.arange(horizon, dtype=float)  # offsets 0, 1, ...
+    raw_weights = np.maximum(0.0, 1.0 - 0.2 * t)
+    weight_sum = raw_weights.sum()
+    if weight_sum <= 0:
+        # This can happen if horizon=0 (already rejected) or all weights zero?
+        # But with horizon>=1, sum>0. Safety: fallback to uniform?
+        normalized_weights = np.ones_like(raw_weights) / horizon
+    else:
+        normalized_weights = raw_weights / weight_sum
+
+    # Compute weighted negative log-probability losses for each candidate
+    L_plus   = -np.sum(logp_with_result * normalized_weights, axis=1)
+    L_empty  = -np.sum(logp_no_call    * normalized_weights, axis=1)
+    L_call_only = -np.sum(logp_call_only * normalized_weights, axis=1)
+
+    # Stronger counterfactual baseline: min of no call and call only
+    L_minus = np.minimum(L_empty, L_call_only)
+
+    # Compute margin
+    margin = L_minus - L_plus
+
+    # Keep decision
+    keep_mask = margin >= tau_filter
+
+    return keep_mask, margin
