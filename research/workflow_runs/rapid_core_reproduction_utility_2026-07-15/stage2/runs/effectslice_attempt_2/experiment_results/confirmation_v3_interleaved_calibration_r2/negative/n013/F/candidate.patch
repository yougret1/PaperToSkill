 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    for arr in [logp_with_result, logp_call_only, logp_no_call]:
+        if not isinstance(arr, np.ndarray):
+            raise ValueError("Input must be numpy arrays")
+        if arr.ndim != 2:
+            raise ValueError("Input must be 2D arrays")
+        if arr.size == 0:
+            raise ValueError("Input must be non-empty")
+        if not np.all(np.isfinite(arr)):
+            raise ValueError("Input must contain finite values")
+        if np.any(arr > 0):
+            raise ValueError("Input must be nonpositive (<= 0)")
+    if not (logp_with_result.shape == logp_call_only.shape == logp_no_call.shape):
+        raise ValueError("Input shapes must match")
+    if isinstance(tau_filter, bool):
+        raise ValueError("tau_filter cannot be boolean")
+    if not isinstance(tau_filter, (int, float, np.floating, np.integer)):
+        raise ValueError("tau_filter must be a number")
+    if not np.isfinite(tau_filter) or tau_filter < 0:
+        raise ValueError("tau_filter must be finite and nonnegative")
+
+    H = logp_with_result.shape[1]
+    t = np.arange(H)
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    normalized_weights = raw_weights / np.sum(raw_weights)
+
+    L_plus = np.sum(normalized_weights * (-logp_with_result), axis=1)
+    L_call_only = np.sum(normalized_weights * (-logp_call_only), axis=1)
+    L_no_call = np.sum(normalized_weights * (-logp_no_call), axis=1)
+
+    L_minus = np.minimum(L_no_call, L_call_only)
+    margin = L_minus - L_plus
+    keep = margin >= tau_filter
+
+    return keep, margin
