 ) -> tuple[np.ndarray, np.ndarray]:
     """Return an ordered keep mask and one finite margin per proposed call."""
 
-    raise NotImplementedError("implement the paper-core reproduction task")
+    # Validate inputs
+    if not isinstance(tau_filter, (int, float)) or isinstance(tau_filter, bool):
+        raise ValueError("tau_filter must be finite nonnegative float, not bool")
+    if tau_filter < 0 or not np.isfinite(tau_filter):
+        raise ValueError("tau_filter must be finite nonnegative")
+
+    arrays = [logp_with_result, logp_call_only, logp_no_call]
+    for arr in arrays:
+        if arr.ndim != 2:
+            raise ValueError("inputs must be 2D matrices")
+        if not np.isfinite(arr).all():
+            raise ValueError("inputs must be finite")
+        if np.any(arr > 0):
+            raise ValueError("inputs must be nonpositive (log probabilities)")
+    # Check shape equality
+    shape = logp_with_result.shape
+    for arr in arrays:
+        if arr.shape != shape:
+            raise ValueError("input matrices must have the same shape")
+
+    n_candidates, future_horizon = shape
+    if future_horizon == 0:
+        raise ValueError("future_horizon must be positive")
+
+    # Compute normalized decreasing weights (T01)
+    t = np.arange(future_horizon, dtype=float)  # t = j - i, first future token t=0
+    raw_weights = np.maximum(0, 1 - 0.2 * t)
+    weight_sum = raw_weights.sum()
+    if weight_sum == 0:
+        normalized_weights = np.ones_like(raw_weights) * np.nan
+    else:
+        normalized_weights = raw_weights / weight_sum
+
+    # Weighted future-token loss (T02)
+    # L = - weighted sum of log probabilities
+    L_with = -np.sum(logp_with_result * normalized_weights[None, :], axis=1)
+    L_call = -np.sum(logp_call_only * normalized_weights[None, :], axis=1)
+    L_empty = -np.sum(logp_no_call * normalized_weights[None, :], axis=1)
+
+    # Stronger counterfactual baseline (T03)
+    L_minus = np.minimum(L_empty, L_call)
+
+    # Margin and threshold (T04)
+    margin = L_minus - L_with
+    keep = margin >= tau_filter
+
+    return keep.astype(bool), margin.astype(float)
