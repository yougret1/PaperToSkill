      if sig not in sig_indices:\n            sig_indices[sig] = []\n        sig_indices[sig].append(idx)\n    # determine which indices to keep per signature\n    keep_indices = set()\n    for sig, indices in sig_indices.items():\n        if capacity > 0 and len(indices) > capacity:\n            keep = indices[-capacity:]\n        else:\n            keep = indices\n        keep_indices.update(keep)\n    # build memory in chronological order\n    memory = []\n    for idx, trial in enumerate(trials):\n        if idx in keep_indices:\n            memory.append({\n                'last_trial': idx,\n                'reflection': trial['reflection'],\n                'signature': trial['signature'],\n                'success': trial['success']\n            })\n    # build distinct signatures in order of first appearance\n    seen = set()\n    signatures = []\n    for trial in trials:\n        sig = trial['signature']\n        if sig not in seen:\n            seen.add(sig)\n            signatures.append(sig)\n    return {'memory': memory, 'signatures': signatures}\n```\n\nCheck: last_trial is integer index. reflection, signature, success from trial.\n\nNow encode as JSON string for the response. Ensure no extra whitespace. Use json.dumps to escape.\n\nBut the output must be exactly one JSON object with key \"implementation\". So we do:\n\n{\"implementation\": \"def solve(case):\\n    capacity = case['capacity']\\n    trials = case['trials']\\n    sig_indices = {}\\n    for idx, trial in enumerate(trials):\\n        sig = trial['signature']\\n        if sig not in sig_indices:\\n            sig_indices[sig] = []\\n        sig_indices[sig].append(idx)\\n    keep_indices = set()\\n    for sig, indices in sig_indices.items():\\n        if capacity > 0 and len(indices) > capacity:\\n            keep = indices[-capacity:]\\n        else:\\n            keep = indices\\n        keep_indices.update(keep)\\n    memory = []\\n    for idx, trial in enumerate(trials):\\n        if id