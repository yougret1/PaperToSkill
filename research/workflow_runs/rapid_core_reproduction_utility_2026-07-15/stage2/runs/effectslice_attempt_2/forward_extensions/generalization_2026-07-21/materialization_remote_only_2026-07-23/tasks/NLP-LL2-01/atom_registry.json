{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "NLP-LL2-01",
  "atoms": [
    {
      "atom_id": "a_ac8bd9c158480dae",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 484,
        "byte_end": 568,
        "split_index": 0
      },
      "rendered_text": "Implement `word_label_alignment` through `solve(case)` for this bounded objective: Project word-level keep/drop labels onto registered subword spans and recover a faithful ordered token mask across punctuation and repeated substrings.",
      "rendered_text_sha256": "5d4cf032efab8f949b37413642a54a80409791244cb7260c1213fe69dd4d0bb4"
    },
    {
      "atom_id": "a_128de7928d9f2df3",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 484,
        "byte_end": 568,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Data-distillation label alignment and inference preparation; teacher generation and classifier training are excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "1db0b9dc37e55f5ccfdb36d3e1adcfa94ad9885ee3ad73d9e3e00d50095dc1dc"
    },
    {
      "atom_id": "a_52bd2c60c40ec747",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 484,
        "byte_end": 568,
        "split_index": 2
      },
      "rendered_text": "Require one word label for every registered word group.",
      "rendered_text_sha256": "98752c39e33bead2cc7236c52b6c4fef401c6f3e5f0756449a8021bdbc6d4d69"
    },
    {
      "atom_id": "a_91f49cd220b82810",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 484,
        "byte_end": 568,
        "split_index": 3
      },
      "rendered_text": "Broadcast each word label to every token index in that group.",
      "rendered_text_sha256": "28a693e607498775a78d5500d8ab25bd672c6c0bc80dc0c5c5797e993a7959b5"
    },
    {
      "atom_id": "a_d8f49aa4c7990f10",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 484,
        "byte_end": 568,
        "split_index": 4
      },
      "rendered_text": "Reject overlapping, out-of-range, or uncovered token indices.",
      "rendered_text_sha256": "7028fdcc597aab21629b90526eb1b22d27e07a5da1621bbbe3358339cda0e2bd"
    },
    {
      "atom_id": "a_fd07fa98df4f21cb",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 484,
        "byte_end": 568,
        "split_index": 5
      },
      "rendered_text": "Keep token indices whose broadcast label equals one.",
      "rendered_text_sha256": "eab48cb42eb7044a02f1d9fbb7121a3af337afe413c819e2b64715635113ad1a"
    },
    {
      "atom_id": "a_44a86f3d3650c2a1",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 585,
        "byte_end": 667,
        "split_index": 6
      },
      "rendered_text": "Return the full token-label vector and retained indices.",
      "rendered_text_sha256": "3eb094b3d1e4ad2c688b483c33758777558e52fa4da9a3a2258a344c4678ee6f"
    },
    {
      "atom_id": "a_9431da39b7bb52c2",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 585,
        "byte_end": 667,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: complete_alignment, offset_integrity, stable_order, no_unlabeled_tokens.",
      "rendered_text_sha256": "5b13cd90796f534875fa206254db865e12c4e1bebde2778138e63421bec7aa74"
    },
    {
      "atom_id": "a_e657252303df6c90",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 585,
        "byte_end": 667,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_4b94c08bbf594f85",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 585,
        "byte_end": 667,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_b4167ef2869d8d6f",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 585,
        "byte_end": 667,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_9840c25513cd8966",
      "source_locator": {
        "document_sha256": "cc2c968a24c2c99c02aba339d6828da9de2d2dd31b057d4656631a3a547662bd",
        "byte_start": 585,
        "byte_end": 667,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
