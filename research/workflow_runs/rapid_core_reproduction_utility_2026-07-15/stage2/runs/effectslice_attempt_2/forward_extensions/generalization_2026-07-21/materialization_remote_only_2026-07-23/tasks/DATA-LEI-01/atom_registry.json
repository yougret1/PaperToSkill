{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "DATA-LEI-01",
  "atoms": [
    {
      "atom_id": "a_5b48ec90590475f5",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 0
      },
      "rendered_text": "Implement `local_moving_phase` through `solve(case)` for this bounded objective: Execute a deterministic local moving phase over a weighted graph using supplied quality gains and a registered node/tie order.",
      "rendered_text_sha256": "c90ef21af5164a7c5a5520e58ce0fa5b4cbef6ae3e136b39785c11f16cf9cb11"
    },
    {
      "atom_id": "a_98caabd5247027e5",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Leiden local moving and partition bookkeeping; large-scale graph I/O is excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "2836814dea678f12c65b2683423e21f0529f11a8655ef7db7185a2ccc87937dd"
    },
    {
      "atom_id": "a_5e631cd8e11692bc",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 2
      },
      "rendered_text": "Build symmetric weighted adjacency and node degrees.",
      "rendered_text_sha256": "01e7a7a1be558132fe7ec43692af6ab2263b617851abe1ba8de66e3ce8b9981c"
    },
    {
      "atom_id": "a_b00f5336a8c2b533",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 3
      },
      "rendered_text": "Visit nodes in stable node-ID order.",
      "rendered_text_sha256": "94b60682e1d2eef3549163a43584d6c48cbfc31dbd69a8a122aaa2d7d66a0937"
    },
    {
      "atom_id": "a_471b176c779c76c9",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 4
      },
      "rendered_text": "Evaluate the registered resolution-adjusted gain for neighboring communities plus the current one.",
      "rendered_text_sha256": "a4c7059d5579a843c6838abbd7b42e436e2b26c86e098d0d0d93082f40e32645"
    },
    {
      "atom_id": "a_a1c19303782db11d",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 5
      },
      "rendered_text": "Move only on a strictly positive improvement and break ties by community ID.",
      "rendered_text_sha256": "467a87e7cb2b46ea91f03b19c064cc5c88d99a80ae0c565e23836108d06e2224"
    },
    {
      "atom_id": "a_b4259a438262a463",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 565,
        "byte_end": 660,
        "split_index": 6
      },
      "rendered_text": "Update labels immediately and return labels plus the ordered move ledger.",
      "rendered_text_sha256": "a70c5b925330638874a50b3c76a2fce3f936348197ae2b0a2446155c060d679e"
    },
    {
      "atom_id": "a_f68a6ad6c8d150fa",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 565,
        "byte_end": 660,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: objective_nondecreasing, partition_valid, stable_ties, complete_assignment.",
      "rendered_text_sha256": "8ab203738a314b9cc05a8374d4d28d6f573c3987b2228d3a9ca3c44fe4b4ed26"
    },
    {
      "atom_id": "a_239dcd2273aa959e",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 565,
        "byte_end": 660,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_61b2bae83f54d900",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 565,
        "byte_end": 660,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_fc39233a27b8d90d",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 565,
        "byte_end": 660,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_e2a375996dadc406",
      "source_locator": {
        "document_sha256": "34f80ba170fdbadcb90cf0893510157ecc8eea45df1b73663270cda0d139ea8c",
        "byte_start": 565,
        "byte_end": 660,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
