ation\". So we write the Python code as a string inside JSON.\n\nThe code should be self-contained, only standard library. We'll define solve(case) function.\n\nWe'll also include validation and error handling.\n\nPlan:\n\n```python\ndef solve(case):\n    # Validate required top-level keys\n    if not isinstance(case, dict):\n        raise ValueError(\"case must be a dict\")\n    if \"threshold\" not in case or \"calls\" not in case:\n        raise ValueError(\"case must contain threshold and calls\")\n    threshold = case[\"threshold\"]\n    calls = case[\"calls\"]\n    if not isinstance(threshold, (int, float)):\n        raise ValueError(\"threshold must be a number\")\n    if not isinstance(calls, list):\n        raise ValueError(\"calls must be a list\")\n    diagnostics = []\n    for call in calls:\n        # Validate each call\n        if not isinstance(call, dict):\n            raise ValueError(\"each call must be a dict\")\n        required_call_keys = {\"call_id\", \"loss_without_call\", \"loss_with_call\", \"prediction_tokens\", \"parseable\"}\n        if not required_call_keys.issubset(call.keys()):\n            raise ValueError(\"call missing required keys\")\n        call_id = call[\"call_id\"]\n        loss_without = call[\"loss_without_call\"]\n        loss_with = call[\"loss_with_call\"]\n        pred_tokens = call[\"prediction_tokens\"]\n        parseable = call[\"parseable\"]\n        # Validate types\n        if not isinstance(call_id, str):\n            raise ValueError(\"call_id must be string\")\n        if not isinstance(loss_without, (int, float)):\n            raise ValueError(\"loss_without_call must be number\")\n        if not isinstance(loss_with, (int, float)):\n            raise ValueError(\"loss_with_call must be number\")\n        if not isinstance(pred_tokens, int) or pred_tokens < 1:\n            raise ValueError(\"prediction_tokens must be integer >= 1\")\n        if not isinstance(parseable, bool):\n            raise ValueError(\