d library, no imports.\n\nI'll write:\n\ndef solve(case):\n    min_size = case['min_cluster_size']\n    clusters = case['clusters']\n    parent = case['parent']\n    \n    cluster_map = {c['cluster_id']: c for c in clusters}\n    \n    children = {}\n    for cid in cluster_map:\n        pid = parent.get(cid)\n        if pid is not None:\n            children.setdefault(pid, []).append(cid)\n    \n    ancestors = {}\n    for cid in cluster_map:\n        anc = []\n        p = parent.get(cid)\n        while p is not None:\n            anc.append(p)\n            p = parent.get(p)\n        ancestors[cid] = anc\n    \n    retained = [c for c in clusters if c['size'] >= min_size]\n    \n    retained_data = []\n    for c in retained:\n        cid = c['cluster_id']\n        birth = c['birth_lambda']\n        exits = c['point_exit_lambdas']\n        stability = sum(max(0, ex - birth) for ex in exits)\n        retained_data.append({'cluster_id': cid, 'size': c['size'], 'stability': stability})\n    \n    retained_data.sort(key=lambda x: (-x['stability'], x['cluster_id']))\n    \n    selected = []\n    blocked = set()\n    for cd in retained_data:\n        cid = cd['cluster_id']\n        if cid in blocked:\n            continue\n        has_desc = False\n        for s in selected:\n            if cid in ancestors[s]:\n                has_desc = True\n                break\n        if has_desc:\n            continue\n        selected.append(cid)\n        for a in ancestors[cid]:\n            blocked.add(a)\n    \n    return {'clusters': retained_data, 'selected_cluster_ids': selected}\n\nThat should work.\n\nNow, produce the final JSON."},"logprobs":null,"finish_reason":"length"}],"usage":{"prompt_tokens":1608,"completion_tokens":8192,"total_tokens":9800,"prompt_tokens_details":{"cached_tokens":1536},"completion_tokens_details":{"reasoning_tokens":7904},"prompt_cache_hit_tokens":1536,"prompt_cache_miss_tokens":72},"system_fingerprint":"fp_8b330d02d0_prod0820_fp8_kvcache_20260402