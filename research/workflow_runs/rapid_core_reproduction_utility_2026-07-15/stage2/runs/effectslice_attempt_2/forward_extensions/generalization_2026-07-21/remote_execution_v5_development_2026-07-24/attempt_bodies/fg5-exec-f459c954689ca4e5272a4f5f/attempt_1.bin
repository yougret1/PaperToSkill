e not in core:\\n            raise ValueError(f'Core distance missing for node: {node}')\\n    \\n    # Build set of nodes for lookup\\n    node_set = set(nodes)\\n    \\n    # Process edges with mutual reachability\\n    edges = []  # list of (mr, u, v) with u < v\\n    for entry in distances:\\n        if len(entry) != 3:\\n            raise ValueError('Each distance entry must be triple: [u, v, d]')\\n        u, v, d = entry\\n        if u not in node_set or v not in node_set:\\n            raise ValueError(f'Distance references unknown node: {u} or {v}')\\n        # Canonicalize endpoints\\n        a, b = (u, v) if u <= v else (v, u)\\n        mr = max(core[u], core[v], d)\\n        edges.append((mr, a, b))\\n    \\n    # Sort edges: primary by mr, then by a, then by b (lexicographic)\\n    edges.sort(key=lambda x: (x[0], x[1], x[2]))\\n    \\n    # Union-Find (Disjoint Set Union)\\n    parent = {}\\n    rank = {}\\n    \\n    def make_set(x):\\n        if x not in parent:\\n            parent[x] = x\\n            rank[x] = 0\\n    \\n    def find(x):\\n        while parent[x] != x:\\n            parent[x] = parent[parent[x]]\\n            x = parent[x]\\n        return x\\n    \\n    def union(x, y):\\n        xr = find(x)\\n        yr = find(y)\\n        if xr == yr:\\n            return False\\n        if rank[xr] < rank[yr]:\\n            parent[xr] = yr\\n        elif rank[xr] > rank[yr]:\\n            parent[yr] = xr\\n        else:\\n            parent[yr] = xr\\n            rank[xr] += 1\\n        return True\\n    \\n    # Initialize union-find for all nodes\\n    for node in nodes:\\n        make_set(node)\\n    \\n    mst_edges = []\\n    total_weight = 0.0\\n    \\n    for mr, a, b in edges:\\n        if union(a, b):\\n            mst_edges.append([a, b, mr])\\n            total_weight += mr\\n            if len(mst_edges) == len(nodes) - 1:\\n                break\\n    \\n    if len(mst_edges) != len(nodes) - 1:\\n        raise ValueError('Graph is