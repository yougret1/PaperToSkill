{"id":"503d9364-86e7-4beb-8749-185cd342f8e5","object":"chat.completion","created":1784983438,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"{\n  \"implementation\": \"def solve(case):\\n    segments = case['segments']\\n    budget = case['budget']\\n\\n    # Validate structure\\n    if not isinstance(budget, int):\\n        raise ValueError(\\\"budget must be an integer\\\")\\n    sum_min = sum(seg['minimum'] for seg in segments)\\n    sum_cap = sum(seg['capacity'] for seg in segments)\\n    if budget < sum_min:\\n        raise ValueError(f\\\"budget {budget} < sum of minima {sum_min}\\\")\\n    if budget > sum_cap:\\n        raise ValueError(f\\\"budget {budget} > sum of capacities {sum_cap}\\\")\\n\\n    # Initialise allocations at minima\\n    n = len(segments)\\n    allocations = [seg['minimum'] for seg in segments]\\n    remaining = budget - sum_min\\n\\n    # Greedy allocation by importance / (next position)\\n    while remaining > 0:\\n        best_idx = -1\\n        best_priority = -1.0\\n        for i in range(n):\\n            seg = segments[i]\\n            cur = allocations[i]\\n            if cur >= seg['capacity']:\\n                continue\\n            # priority = importance / (next allocated position, which is cur+1)\\n            priority = seg['importance'] / (cur + 1)\\n            if priority > best_priority:\\n                best_priority = priority\\n                best_idx = i\\n            # tie: keep earliest index (original order) by not updating on equal\\n        # Must always find a candidate because budget <= sum_cap and remaining>0\\n        allocations[best_idx] += 1\\n        remaining -= 1\\n\\n    # Build by_name dict preserving original segment order names\\n    by_name = {segments[i]['name']: allocations[i] for i in range(n)}\\n    total = sum(allocations)\\n\\n    return {\\n        'allocations': allocations,\\n        'by_name': by_name,\\n        'total': total\\n    }\"\n}","r