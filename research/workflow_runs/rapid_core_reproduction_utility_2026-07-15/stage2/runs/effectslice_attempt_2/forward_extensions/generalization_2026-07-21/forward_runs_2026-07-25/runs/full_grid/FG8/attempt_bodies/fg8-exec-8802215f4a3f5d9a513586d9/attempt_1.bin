munities\"]\n    resolution = case[\"resolution\"]\n    \n    # adjacency\n    adj = {}\n    for u, v, w in edges:\n        if u not in adj:\n            adj[u] = []\n        if v not in adj:\n            adj[v] = []\n        adj[u].append((v, w))\n        adj[v].append((u, w))\n    # ensure all nodes in initial communities are in adj\n    for node in initial_communities:\n        if node not in adj:\n            adj[node] = []\n    \n    # total edge weight\n    E = sum(w for _,_,w in edges)\n    \n    # degrees\n    deg = {}\n    for node, neighs in adj.items():\n        deg[node] = sum(w for _,w in neighs)\n    \n    # current community assignment\n    community = dict(initial_communities)\n    # community degree sums\n    comm_deg = {}\n    for node, comm in community.items():\n        comm_deg[comm] = comm_deg.get(comm, 0) + deg[node]\n    \n    nodes = sorted(initial_communities.keys())\n    moves = []\n    \n    while True:\n        moves_in_pass = 0\n        for v in nodes:\n            cur_comm = community[v]\n            deg_v = deg[v]\n            # compute weights to each community\n            neigh_comm_weights = {}\n            for neighbor, w in adj[v]:\n                nc = community[neighbor]\n                neigh_comm_weights[nc] = neigh_comm_weights.get(nc, 0) + w\n            w_cur = neigh_comm_weights.get(cur_comm, 0)\n            \n            best_comm = None\n            best_delta = 0.0\n            for cand_comm, w_cand in neigh_comm_weights.items():\n                if cand_comm == cur_comm:\n                    continue\n                s_cur = comm_deg[cur_comm]\n                s_cand = comm_deg.get(cand_comm, 0)\n                factor = resolution * deg_v / E\n                delta = w_cand - w_cur - factor * (s_cand - s_cur + deg_v)\n                if delta > 0:\n                    if best_comm is None or delta > best_delta or (delta == best_delta and cand_comm < best_comm):\n                        best_comm = cand_comm\n       