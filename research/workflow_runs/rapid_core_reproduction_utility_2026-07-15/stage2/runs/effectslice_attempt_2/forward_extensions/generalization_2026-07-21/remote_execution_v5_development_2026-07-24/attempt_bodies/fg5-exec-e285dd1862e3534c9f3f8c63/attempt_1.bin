ank[xr] > rank[yr]:\\n            parent[yr] = xr\\n        else:\\n            parent[yr] = xr\\n            rank[xr] += 1\\n        return True\\n    mst_edges = []\\n    total_weight = 0.0\\n    edge_count = 0\\n    target = len(nodes) - 1\\n    for mr, u, v in edges:\\n        if edge_count == target:\\n            break\\n        if union(u, v):\\n            mst_edges.append([u, v, mr])\\n            total_weight += mr\\n            edge_count += 1\\n    return {'mst_edges': mst_edges, 'total_weight': total_weight}\n```\n\nNow embed that as a JSON string value. The entire response should be:\n\n```\n{\"implementation\":\"def solve(case):\\n    nodes = case['nodes']\\n    core_dist = case['core_distance']\\n    distances = case['distances']\\n    edges = []\\n    for u, v, d in distances:\\n        if u > v:\\n            u, v = v, u\\n        mr = max(core_dist[u], core_dist[v], d)\\n        edges.append((mr, u, v))\\n    edges.sort(key=lambda x: (x[0], x[1], x[2]))\\n    parent = {node: node for node in nodes}\\n    rank = {node: 0 for node in nodes}\\n    def find(x):\\n        while parent[x] != x:\\n            parent[x] = parent[parent[x]]\\n            x = parent[x]\\n        return x\\n    def union(x, y):\\n        xr, yr = find(x), find(y)\\n        if xr == yr:\\n            return False\\n        if rank[xr] < rank[yr]:\\n            parent[xr] = yr\\n        elif rank[xr] > rank[yr]:\\n            parent[yr] = xr\\n        else:\\n            parent[yr] = xr\\n            rank[xr] += 1\\n        return True\\n    mst_edges = []\\n    total_weight = 0.0\\n    edge_count = 0\\n    target = len(nodes) - 1\\n    for mr, u, v in edges:\\n        if edge_count == target:\\n            break\\n        if union(u, v):\\n            mst_edges.append([u, v, mr])\\n            total_weight += mr\\n            edge_count += 1\\n    return {'mst_edges': mst_edges, 'total_weight': total_weight}\"}\n```\n\nDouble-check: No stray characters. The JSON object has on