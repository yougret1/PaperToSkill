{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "NLP-LL2-02",
  "atoms": [
    {
      "atom_id": "a_f1c016939646f422",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 484,
        "byte_end": 571,
        "split_index": 0
      },
      "rendered_text": "Implement `budgeted_token_reconstruction` through `solve(case)` for this bounded objective: Construct a compressed prompt from supplied keep probabilities, force-token constraints, sentence boundaries, and an exact global budget.",
      "rendered_text_sha256": "a8712c165bcbe60de237757d600bd2b027839c11e3984661cd1028dd9ba25b1c"
    },
    {
      "atom_id": "a_9f71a483689d7948",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 484,
        "byte_end": 571,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Task-agnostic token-classifier inference and reconstruction with supplied probabilities; model training is excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "f7531df78a676cda2ecb561628cabb86d237e2fabd9b116001b332a8886f5a4b"
    },
    {
      "atom_id": "a_893a3743446f91ac",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 484,
        "byte_end": 571,
        "split_index": 2
      },
      "rendered_text": "Treat a word group as indivisible when accounting token cost.",
      "rendered_text_sha256": "11e5173d838dc72f593270399d9f2ae46a0677137b38789c056fecb7cef76daf"
    },
    {
      "atom_id": "a_99f105ae3778a0c9",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 484,
        "byte_end": 571,
        "split_index": 3
      },
      "rendered_text": "Select forced words first and reject an infeasible forced set.",
      "rendered_text_sha256": "fd02c0984f807234dc679d3659b8a44b5d2fe2b3063f0c724317e62e0a726ba0"
    },
    {
      "atom_id": "a_05375bd58e78bbd9",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 484,
        "byte_end": 571,
        "split_index": 4
      },
      "rendered_text": "Rank remaining words by descending supplied score and then source position.",
      "rendered_text_sha256": "749ed48d51812c14ddcaac390355552b4893d8678253f5ce50c00aee6926c3da"
    },
    {
      "atom_id": "a_33f365e49456e11a",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 484,
        "byte_end": 571,
        "split_index": 5
      },
      "rendered_text": "Accept a word only when its entire token group fits the residual budget.",
      "rendered_text_sha256": "4f23db78519da212af29bd5eb3d2a9feda93958e6ce0699b613adb951d8109d7"
    },
    {
      "atom_id": "a_e209eb4952ea2dbe",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 588,
        "byte_end": 670,
        "split_index": 6
      },
      "rendered_text": "Return words and tokens in original order with exact token usage.",
      "rendered_text_sha256": "9fbdb8a7a340f04b53f0eb6da9895c7388feb5bb7c37f6691cf8321259037092"
    },
    {
      "atom_id": "a_dbbb9b88080fa427",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 588,
        "byte_end": 670,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: exact_budget, force_token_precedence, deterministic_ties, faithful_reconstruction.",
      "rendered_text_sha256": "63e455bf6f4f74172120758073103bdd5a51c4148b14c4a3bf07f5ab92c27857"
    },
    {
      "atom_id": "a_e290ad6ec68335bd",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 588,
        "byte_end": 670,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_c2e654ef6fd44439",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 588,
        "byte_end": 670,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_0fbd3b2b336ee6cd",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 588,
        "byte_end": 670,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_bcdc307a43ca32cd",
      "source_locator": {
        "document_sha256": "300f62268cde8ef79a6aac6ab73094d086b622a2fc205f651b2e9abbb019d912",
        "byte_start": 588,
        "byte_end": 670,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
