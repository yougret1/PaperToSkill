{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "AGENT-RF-01",
  "atoms": [
    {
      "atom_id": "a_cdd262127a9a92a5",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 444,
        "byte_end": 527,
        "split_index": 0
      },
      "rendered_text": "Implement `episodic_reflection_memory` through `solve(case)` for this bounded objective: Update and truncate an episodic reflection memory from registered trial outcomes, feedback, and reflection records without changing model weights.",
      "rendered_text_sha256": "41c6efb141a579ac58a6d9906b23e1f6352996503922579ee69e1e80f717cf5f"
    },
    {
      "atom_id": "a_3c65f24d45f9d87f",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 444,
        "byte_end": 527,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Reflexion episodic memory bookkeeping and prompt assembly; free-form reflection generation is supplied. Validate every required field before computing a result.",
      "rendered_text_sha256": "07df9b4e49a1dea32f3e67f348a7e31bfe3daa0300bdd78f53033981e3e09b92"
    },
    {
      "atom_id": "a_dc6f233a48f2997c",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 444,
        "byte_end": 527,
        "split_index": 2
      },
      "rendered_text": "Process trials in chronological order.",
      "rendered_text_sha256": "80afebc00e684d647497e4e636e47db3122a223d183257ff58c5ad28475ed958"
    },
    {
      "atom_id": "a_6cffe2a6dc8ac532",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 444,
        "byte_end": 527,
        "split_index": 3
      },
      "rendered_text": "Deduplicate memory by failure signature, retaining the newest reflection.",
      "rendered_text_sha256": "e56cd8710dc1c966ae941868bc692355bbca468bffd579922463e1fc9b261c5a"
    },
    {
      "atom_id": "a_3b4e2ac16c670124",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 444,
        "byte_end": 527,
        "split_index": 4
      },
      "rendered_text": "When capacity binds, prioritize failures before successes, then recency and signature.",
      "rendered_text_sha256": "945cff3f0f1cdcb45caacd9a05cf737ae424373293e0b931b712d86abcccf332"
    },
    {
      "atom_id": "a_b2865ea86f016f1c",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 444,
        "byte_end": 527,
        "split_index": 5
      },
      "rendered_text": "Restore chronological order in the final memory.",
      "rendered_text_sha256": "8280dc33b8c71f1edb296d31c56b0fc3e77875079fceacba2063e339129dea4b"
    },
    {
      "atom_id": "a_3334f26e5529ae8d",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 544,
        "byte_end": 640,
        "split_index": 6
      },
      "rendered_text": "Return complete retained entries and their signatures.",
      "rendered_text_sha256": "def14c326f5a621b08c7f948ca3a83cbf349b1132a90deade1a1e01c9ff7f637"
    },
    {
      "atom_id": "a_c40692d0778c3835",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 544,
        "byte_end": 640,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: feedback_provenance, memory_bound, stable_order, no_weight_update.",
      "rendered_text_sha256": "79eb4849fd34fcebc48c416052c31bc61fea1c1bca031f55963bc632b09b30e4"
    },
    {
      "atom_id": "a_efe1414d11e377b2",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 544,
        "byte_end": 640,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_f96a2eba7a91e49f",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 544,
        "byte_end": 640,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_a1a93653b2313825",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 544,
        "byte_end": 640,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_99e7af809aed85af",
      "source_locator": {
        "document_sha256": "6db3de24a4337dfb29088893a579de68d304b478ccdc08a003f7b286077646da",
        "byte_start": 544,
        "byte_end": 640,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
