l_state {} not in transitions'.format(initial_state))\n    for state, trans in transitions.items():\n        if not isinstance(trans, dict):\n            raise ValueError('transition for {} must be a dict'.format(state))\n        kind = trans.get('kind')\n        if kind not in ('action', 'final'):\n            raise ValueError('transition for {} has invalid kind: {}'.format(state, kind))\n        if kind == 'action':\n            action = trans.get('action')\n            if not isinstance(action, str) or not action:\n                raise ValueError('action for {} missing or invalid'.format(state))\n            if action not in tool_observations:\n                raise ValueError(\"action '{}' in state {} not in tool_observations\".format(action, state))\n            next_by = trans.get('next_by_observation')\n            if not isinstance(next_by, dict):\n                raise ValueError('next_by_observation for {} must be a dict'.format(state))\n            default_next = trans.get('default_next')\n            if default_next is None:\n                raise ValueError('default_next missing for {}'.format(state))\n            for obs, ns in next_by.items():\n                if ns not in transitions:\n                    raise ValueError('next state {} from state {} via obs {} not defined'.format(ns, state, obs))\n            if default_next not in transitions:\n                raise ValueError('default next state {} from state {} not defined'.format(default_next, state))\n        else:\n            value = trans.get('value')\n            if value is None:\n                raise ValueError('final state {} missing value'.format(state))\n    \n    # Simulation\n    current_state = initial_state\n    step_count = 0\n    trace = []\n    \n    if transitions[current_state]['kind'] == 'final':\n        return {\n            'status': 'completed',\n            'value': transitions[current_state]['value'],\n            'trace': []\n        }\n    \n    while step_count < m