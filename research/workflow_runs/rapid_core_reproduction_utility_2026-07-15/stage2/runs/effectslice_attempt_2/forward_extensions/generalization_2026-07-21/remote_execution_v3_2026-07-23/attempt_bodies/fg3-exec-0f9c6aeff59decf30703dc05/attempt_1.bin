   # Validate and parse\n    if 'payload' not in case:\n        raise ValueError(\"Missing payload\")\n    payload = case['payload']\n    if 'nodes' not in payload or 'required_symbols' not in payload:\n        raise ValueError(\"Missing nodes or required_symbols\")\n    nodes = payload['nodes']\n    required_symbols = set(payload['required_symbols'])\n\n    # Build maps\n    nodes_map = {}\n    children_map = {}\n    root_id = None\n    for node in nodes:\n        nid = node['id']\n        nodes_map[nid] = node\n        children_map.setdefault(node['parent'], []).append(nid)\n        if node['parent'] is None:\n            root_id = nid\n\n    if root_id is None:\n        raise ValueError(\"No root node\")\n\n    # Check required symbols exist\n    symbols_present = set()\n    for node in nodes:\n        symbols_present.add(node['symbol'])\n    if not required_symbols.issubset(symbols_present):\n        missing = required_symbols - symbols_present\n        raise ValueError(f\"Required symbols missing: {missing}\")\n\n    retained = set(nodes_map.keys())\n    # Sort candidates: deeper first, then by id ascending\n    candidates = sorted(\n        nodes,\n        key=lambda n: (-n['depth'], n['id'])\n    )\n\n    removal_order = []\n    for node in candidates:\n        nid = node['id']\n        # Can't remove root\n        if nid == root_id:\n            continue\n        # Can't remove if symbol is required\n        if node['symbol'] in required_symbols:\n            continue\n        # Can't remove if not removable\n        if not node['removable']:\n            continue\n        # Can't remove if any child is still retained\n        children = children_map.get(nid, [])\n        if any(child in retained for child in children):\n            continue\n        # Check if removing would lose required symbols\n        test_retained = retained - {nid}\n        # For each required symbol, is there still a node with it?\n        ok = True\n        for sym in required_symbols:\n            found = False\n            for rid in test_retained:\n                if nodes_map[rid]['symbol'] == sym:\n                    found = True\n                    break\n            if not found:\n                ok = False\n                break\n        if ok:\n            retained = test_retained\n            removal_order.append(nid)\n\n    final_retained = sorted(retained)\n    return {\"retained\": final_retained, \"removed\": removal_order}\n```\n\nBut we can optimize the check for required symbols by precomputing counts. However, for simplicity, it's fine.\n\nNow, we need to output as JSON string. Ensure no trailing whitespace.\n\nNow, produce the response."},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":1852,"completion_tokens":3588,"total_tokens":5440,"prompt_tokens_details":{"cached_tokens":1792},"completion_tokens_details":{"reasoning_tokens":3073},"prompt_cache_hit_tokens":1792,"prompt_cache_miss_tokens":60},"system_fingerprint":"fp_8b330d02d0_prod0820_fp8_kvcache_20260402"}