aise ValueError\n    required = set(case.get('required_symbols', []))\n    # Build lookup\n    node_map = {n['id']: n for n in nodes}\n    children = {}\n    for n in nodes:\n        parent = n.get('parent')\n        if parent is not None:\n            children.setdefault(parent, []).append(n['id'])\n    # Initialize\n    removed = set()\n    removal_order = []\n    # Sort nodes by depth descending, then id as tie-breaker\n    sorted_nodes = sorted(nodes, key=lambda x: (-x['depth'], x['id']))\n    # Precompute symbols present initially\n    all_ids = {n['id'] for n in nodes}\n    # Function to compute current symbols present (excluding removed)\n    def current_symbols():\n        syms = set()\n        for nid in all_ids:\n            if nid not in removed:\n                syms.add(node_map[nid]['symbol'])\n        return syms\n    for node in sorted_nodes:\n        nid = node['id']\n        if nid == 'root':\n            continue\n        if not node['removable']:\n            continue\n        if node['symbol'] in required:\n            continue\n        # Check if any child retained\n        child_ids = children.get(nid, [])\n        if any(cid not in removed for cid in child_ids):\n            continue\n        # Tentative removal: check required symbols still present\n        # Compute symbols if we remove this node\n        removed.add(nid)\n        syms_after = current_symbols()\n        if required.issubset(syms_after):\n            # proceed with removal\n            removal_order.append(nid)\n            # already added to removed\n        else:\n            # revert\n            removed.discard(nid)\n    retained = sorted(nid for nid in all_ids if nid not in removed)\n    return {\"removed_node_ids\": removal_order, \"retained_node_ids\": retained}\n\nCheck: after loop, removed set includes only nodes we actually removed (since we only add to removed when we decide to keep removal). So okay.\n\nOne nuance: The function current_symbols recalculates from s