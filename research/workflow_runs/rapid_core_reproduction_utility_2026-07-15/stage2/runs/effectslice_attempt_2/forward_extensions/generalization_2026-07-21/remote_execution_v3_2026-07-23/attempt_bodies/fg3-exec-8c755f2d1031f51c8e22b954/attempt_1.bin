arent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n    def union(x, y):\n        rx, ry = find(x), find(y)\n        if rx == ry:\n            return False\n        if rank[rx] < rank[ry]:\n            parent[rx] = ry\n        elif rank[rx] > rank[ry]:\n            parent[ry] = rx\n        else:\n            parent[ry] = rx\n            rank[rx] += 1\n        return True\n    mst_edges = []\n    total_weight = 0.0\n    for mr, a, b in edge_list:\n        if union(a, b):\n            mst_edges.append({\"source\": a, \"target\": b, \"mutual_reachability\": mr})\n            total_weight += mr\n            if len(mst_edges) == len(nodes) - 1:\n                break\n    if len(mst_edges) != len(nodes) - 1:\n        raise ValueError(\"Graph is disconnected or insufficient edges\")\n    return {\"edges\": mst_edges, \"total_weight\": total_weight}\n\nNow, convert to a single line with escaped newlines: replace each newline with \\n. Also, the double quotes inside the source (like \"nodes\") need to be escaped as \\\". So the resulting string (call it S_line) will have \\n and \\\". Then, to embed in JSON, we need to escape backslashes and double quotes again as described. But wait, S_line is already a string that contains backslash-n and backslash-doublequote. In JSON, we must escape those backslashes. So we replace every \\ in S_line with \\\\, and every \" with \\\". That yields the final JSON string value.\n\nSo final JSON string will have many slashes.\n\nI'll produce it manually with attention.\n\nLet me write S_line by replacing newlines with \\\\n (so that will become \\\\\\\\n after second escape? No, careful: I need to construct S_line first. I'll write it out as a string with escape sequences:\n\n\"def solve(case):\\n    nodes = case[\\\"nodes\\\"]\\n    core = case[\\\"core_distance\\\"]\\n    distances = case[\\\"distances\\\"]\\n    if not isinstance(nodes, list) or not isinstance(core, dict) or not isinsta