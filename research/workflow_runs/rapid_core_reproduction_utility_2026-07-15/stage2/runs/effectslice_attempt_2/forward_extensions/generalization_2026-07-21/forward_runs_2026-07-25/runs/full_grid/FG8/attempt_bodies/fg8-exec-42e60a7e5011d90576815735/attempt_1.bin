in cfg for x in unresolved):\n            return 'UNRESOLVED'\n        if all(x in cfg for x in required):\n            return 'FAIL'\n        return 'PASS'\n    full = list(items)\n    if test(full) != 'FAIL':\n        raise ValueError('Initial configuration does not fail')\n    cfg = full[:]\n    from math import ceil  # but we can do without import? We'll just use // and %.\n    # Actually we can implement split manually.\n    n = 2\n    while len(cfg) > 1:\n        if n > len(cfg):\n            n = len(cfg)\n        # split into n subsets\n        subset_size = len(cfg) // n\n        remainder = len(cfg) % n\n        subsets = []\n        start = 0\n        for i in range(n):\n            end = start + subset_size + (1 if i < remainder else 0)\n            subsets.append(cfg[start:end])\n            start = end\n        reduced = False\n        for subset in subsets:\n            res = test(subset)\n            if res == 'FAIL':\n                cfg = subset[:]\n                n = 2\n                reduced = True\n                break\n        if reduced:\n            continue\n        # test complements\n        for subset in subsets:\n            complement = [x for x in cfg if x not in subset]\n            # note: subset is a list, we use x not in subset. Since items are unique, okay.\n            res = test(complement)\n            if res == 'FAIL':\n                cfg = complement[:]\n                n = max(2, n-1)\n                reduced = True\n                break\n        if reduced:\n            continue\n        # no reduction\n        if n == len(cfg):\n            break\n        n = min(2*n, len(cfg))\n    return {'minimal_failure': cfg, 'outcome': 'FAIL', 'tests': tests}\n```\n\nBut note: In complement, we used `x not in subset`. That is fine since items are hashable strings.\n\nBut we must ensure that we don't import math or something. We didn't.\n\nNow we need to make sure this code handles cases where unresolved_without is empty: `if unre