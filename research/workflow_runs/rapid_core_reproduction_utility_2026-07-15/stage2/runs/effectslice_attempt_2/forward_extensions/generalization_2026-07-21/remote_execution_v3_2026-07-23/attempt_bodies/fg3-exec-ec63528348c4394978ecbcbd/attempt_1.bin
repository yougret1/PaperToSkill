 nodes:\n        if n not in core:\n            raise ValueError(f\"Missing core distance for {n}\")\n    # Build mutual reachability edges\n    edges = []\n    for a, b, d in dists:\n        if a not in node_set or b not in node_set:\n            raise ValueError(f\"Unknown node in distance: {a} or {b}\")\n        mr = max(core[a], core[b], d)\n        # canonicalize\n        if a < b:\n            edges.append((mr, a, b))\n        else:\n            edges.append((mr, b, a))\n    # Sort: by weight, then first node, then second node\n    edges.sort(key=lambda x: (x[0], x[1], x[2]))\n    # Union-Find\n    parent = {n: n for n in nodes}\n    rank = {n: 0 for n in nodes}\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n    def union(x, y):\n        rx, ry = find(x), find(y)\n        if rx == ry:\n            return False\n        if rank[rx] < rank[ry]:\n            parent[rx] = ry\n        elif rank[rx] > rank[ry]:\n            parent[ry] = rx\n        else:\n            parent[ry] = rx\n            rank[rx] += 1\n        return True\n    mst = []\n    total = 0.0\n    for weight, u, v in edges:\n        if len(mst) == len(nodes) - 1:\n            break\n        if union(u, v):\n            mst.append([u, v, weight])\n            total += weight\n    if len(mst) != len(nodes) - 1:\n        raise ValueError(\"Graph is disconnected\")\n    # Return result\n    return {\n        \"edges\": mst,\n        \"total_weight\": total\n    }\n\nWe should ensure no mutation of case. We are only reading.\n\nNow we need to output this as a JSON string with key \"implementation\". The JSON string must escape newlines, backslashes, quotes. We'll generate the string programmatically.\n\nWe'll produce the final JSON object.\n\nMake sure to not use Markdown fences. Just plain JSON.\n\nThus final answer: {\"implementation\": \"def solve(case):\\n    nodes = case[\\\"nodes\\\"]\\n    core = case[\\\"c