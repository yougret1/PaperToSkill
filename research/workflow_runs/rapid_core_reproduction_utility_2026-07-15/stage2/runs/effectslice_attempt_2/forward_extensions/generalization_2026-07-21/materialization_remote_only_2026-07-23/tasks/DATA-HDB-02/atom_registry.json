{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "DATA-HDB-02",
  "atoms": [
    {
      "atom_id": "a_47d25d83dd9ccf7c",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 484,
        "byte_end": 558,
        "split_index": 0
      },
      "rendered_text": "Implement `condensed_tree_stability` through `solve(case)` for this bounded objective: Condense a supplied hierarchy under a minimum cluster size and select stable clusters with deterministic tie handling.",
      "rendered_text_sha256": "2dd87e8bee7b59d4c6b4849524fd3cebec74e7ee4dc3b3fe7e5eb32cce7631cb"
    },
    {
      "atom_id": "a_8311c2efd7548823",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 484,
        "byte_end": 558,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Condensed-tree construction, cluster stability, and flat selection; metric learning is excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "832bba9bfd38c52069ce71b222c9ec017c464e0613b26eff50dc39ff80e054b2"
    },
    {
      "atom_id": "a_5803ef711d16cfe5",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 484,
        "byte_end": 558,
        "split_index": 2
      },
      "rendered_text": "Drop clusters smaller than the minimum cluster size.",
      "rendered_text_sha256": "edb7d35f338a6bb5e88c70298bd2acd0c9535cfa8d523c424ed1dad19c01ad51"
    },
    {
      "atom_id": "a_9db2ce1554e20acf",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 484,
        "byte_end": 558,
        "split_index": 3
      },
      "rendered_text": "For each retained cluster sum max(0, exit_lambda - birth_lambda) over its points.",
      "rendered_text_sha256": "251ff58541a2407f8b6c7e1ecc3174f1b29aa22db3e6af2e9e0401d78c5162bb"
    },
    {
      "atom_id": "a_03dff4abf90d5a78",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 484,
        "byte_end": 558,
        "split_index": 4
      },
      "rendered_text": "Rank clusters by decreasing stability and cluster ID.",
      "rendered_text_sha256": "6837bb22ed16c1bd44eff4f01fe34a962ab4efc6c6058c64caac3942da2b4fef"
    },
    {
      "atom_id": "a_df4ef087fb71b921",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 484,
        "byte_end": 558,
        "split_index": 5
      },
      "rendered_text": "Select a cluster only when no already selected descendant blocks it, then block its ancestors.",
      "rendered_text_sha256": "706fb7c96174654f66de8ccbcd6450126dc11d6c72218c2017b21fd3f16acadb"
    },
    {
      "atom_id": "a_effa04475504d23e",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 575,
        "byte_end": 675,
        "split_index": 6
      },
      "rendered_text": "Return all retained stability rows and sorted selected IDs.",
      "rendered_text_sha256": "c6e567df9433c2cb16ee7a0c0762c4f71ce3fda538e165f2e47894418f6c6b50"
    },
    {
      "atom_id": "a_aef81cc06118e2b0",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 575,
        "byte_end": 675,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: valid_condensed_tree, stability_accounting, noise_semantics, stable_ties.",
      "rendered_text_sha256": "c8ca6c790e07ea4e4934f8d8bafe6b101d128fd51713725ba82a78e3d198b492"
    },
    {
      "atom_id": "a_e756ecdd1d32a094",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 575,
        "byte_end": 675,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_ceb6834b3e8dcabd",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 575,
        "byte_end": 675,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_5d25c6254169d274",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 575,
        "byte_end": 675,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_e88dd7293fe500d1",
      "source_locator": {
        "document_sha256": "b5fc37f21f97fc1060d2bd4f40c50276d3be68d5f7f0aad80e4e5440987a0451",
        "byte_start": 575,
        "byte_end": 675,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
