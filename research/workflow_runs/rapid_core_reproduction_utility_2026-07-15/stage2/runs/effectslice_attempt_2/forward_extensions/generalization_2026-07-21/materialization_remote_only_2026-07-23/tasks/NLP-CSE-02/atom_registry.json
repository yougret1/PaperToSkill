{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "NLP-CSE-02",
  "atoms": [
    {
      "atom_id": "a_53bcdcf2d6b51d37",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 485,
        "byte_end": 577,
        "split_index": 0
      },
      "rendered_text": "Implement `sentence_budget_selection` through `solve(case)` for this bounded objective: Select and reconstruct context-scored sentences under an exact token budget while preserving document order and required query context.",
      "rendered_text_sha256": "dcac87a0914b626474e4276cae66116b81f4cbd1ef515fed122d0857f3329548"
    },
    {
      "atom_id": "a_de65d61b77552b91",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 485,
        "byte_end": 577,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Budgeted sentence selection and reconstruction; upstream embedding generation is supplied. Validate every required field before computing a result.",
      "rendered_text_sha256": "74a8a6b1922e8d1d9e0cd0217292e5cb979bd08fae2b249fff105d6acd2799a2"
    },
    {
      "atom_id": "a_d5d39e0c5ad5ade2",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 485,
        "byte_end": 577,
        "split_index": 2
      },
      "rendered_text": "Enumerate sentence inclusion with a zero-one dynamic program over token cost.",
      "rendered_text_sha256": "e1e3f8c586f416902e7f784516168bf86e27cdad1a5b577c2954e6d575e17795"
    },
    {
      "atom_id": "a_d4ed8f0f479b78b0",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 485,
        "byte_end": 577,
        "split_index": 3
      },
      "rendered_text": "Never split a sentence or exceed the budget.",
      "rendered_text_sha256": "0db4a13be5a1bb55e947274d8788ed961103d36c5495f706d9e3e0585f522c48"
    },
    {
      "atom_id": "a_a2d2ea15777ff9f4",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 485,
        "byte_end": 577,
        "split_index": 4
      },
      "rendered_text": "Maximize summed salience.",
      "rendered_text_sha256": "6ac8d3f991857555ed0f4eae0b79f5e4dd6f56140c61f206c9a585b2db0a7fc9"
    },
    {
      "atom_id": "a_7dbd0a2463297750",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 485,
        "byte_end": 577,
        "split_index": 5
      },
      "rendered_text": "Break equal utility by fewer used tokens and then lexicographic source indices.",
      "rendered_text_sha256": "dd771cc1c9fcdf5851a445bf98da904a8b262f98f8eefe8a2c3a3ab59a21a0f7"
    },
    {
      "atom_id": "a_031e9bdbf9d9c978",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 594,
        "byte_end": 675,
        "split_index": 6
      },
      "rendered_text": "Return selected indices, used tokens, and summed score.",
      "rendered_text_sha256": "31e3bb2e4deefea302245aa3f3e1f56fe0b52b8d05714358d9d688163aa2208c"
    },
    {
      "atom_id": "a_9454f04df0371780",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 594,
        "byte_end": 675,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: budget_feasible, query_context_retained, stable_ties, document_order.",
      "rendered_text_sha256": "ad18c11a0f9ee8bae04f4701ed9592b568f495c2ded55002a887e5909a24a09e"
    },
    {
      "atom_id": "a_8319df7b48d5327a",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 594,
        "byte_end": 675,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_cffaa599211ea220",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 594,
        "byte_end": 675,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_60ca74e4586e6884",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 594,
        "byte_end": 675,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_6b0aad45aca4e05f",
      "source_locator": {
        "document_sha256": "0e7de5000aa69a6266359b12dea966354739a98add136c41443b0ae9a9b0c479",
        "byte_start": 594,
        "byte_end": 675,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
