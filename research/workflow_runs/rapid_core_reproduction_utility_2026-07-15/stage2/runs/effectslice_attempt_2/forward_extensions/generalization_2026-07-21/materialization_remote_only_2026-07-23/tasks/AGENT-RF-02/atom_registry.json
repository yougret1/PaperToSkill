{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "AGENT-RF-02",
  "atoms": [
    {
      "atom_id": "a_e92b5fd611aa7ad1",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 444,
        "byte_end": 528,
        "split_index": 0
      },
      "rendered_text": "Implement `trial_reflect_retry_controller` through `solve(case)` for this bounded objective: Drive a bounded trial loop through act, evaluate, reflect, retry, and terminate states from supplied agent outputs and feedback signals.",
      "rendered_text_sha256": "f42158f67aa8748668df9b239603d4ac94e4686de1eb2d9d7b1db5eef9611702"
    },
    {
      "atom_id": "a_f1bc78d9ddaf8981",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 444,
        "byte_end": 528,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Reflexion control flow and state isolation; base-agent and evaluator model calls are supplied as deterministic fixtures. Validate every required field before computing a result.",
      "rendered_text_sha256": "f6fbbf90806a36e4c76fabb43bd9419b2140eb67e4735bc5f2bfca89d664b15b"
    },
    {
      "atom_id": "a_e06f5bcb8238321c",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 444,
        "byte_end": 528,
        "split_index": 2
      },
      "rendered_text": "With no prior attempt request attempt one.",
      "rendered_text_sha256": "9e679ecedd7ec32f263147a5a00a0766fadf7f53ab5852e31d535b1d11e56247"
    },
    {
      "atom_id": "a_6d7c764ad4c6b214",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 444,
        "byte_end": 528,
        "split_index": 3
      },
      "rendered_text": "Stop immediately after success.",
      "rendered_text_sha256": "8e14ae32acd8e22a54f7f043219a44eef7ac21d149fdcffbe2146944f5e86a4f"
    },
    {
      "atom_id": "a_765d49a5447bd3fd",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 444,
        "byte_end": 528,
        "split_index": 4
      },
      "rendered_text": "Stop on the registered attempt budget or a repeated failure signature.",
      "rendered_text_sha256": "07949366272d395469719ee8397d3404dc85c807f08c9bcf277253d227c7d906"
    },
    {
      "atom_id": "a_e0d2dea2312e1815",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 444,
        "byte_end": 528,
        "split_index": 5
      },
      "rendered_text": "Otherwise request exactly the next attempt.",
      "rendered_text_sha256": "588bba85c5f306327387adf2b599e72403ed809d278f00c07253e207e619fb9a"
    },
    {
      "atom_id": "a_77cbad9d8a15f582",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 545,
        "byte_end": 638,
        "split_index": 6
      },
      "rendered_text": "Append a nonempty reflection with its signature and return decision, next index, and memory update.",
      "rendered_text_sha256": "b311418eb266829bfa6a84667e3507633b81853dd2362d64491e27917ef3122d"
    },
    {
      "atom_id": "a_efee260f02ff34f0",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 545,
        "byte_end": 638,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: registered_state_machine, reflection_after_feedback, budget_accounting, success_terminates.",
      "rendered_text_sha256": "5cb61ba7b72f8ab94ae4cddfdaf02aa0ccd8ae17cab8a021fb07f9b34dbe6737"
    },
    {
      "atom_id": "a_4977cf03db650581",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 545,
        "byte_end": 638,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_393bdbd1c855fad8",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 545,
        "byte_end": 638,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_b99636bc9ee0497e",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 545,
        "byte_end": 638,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_94a04e5412edb9ec",
      "source_locator": {
        "document_sha256": "173a0e808a1b0efc56702f10a8e81bce006a446bb4b4c139adeafbd7efdc59fc",
        "byte_start": 545,
        "byte_end": 638,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
