all(0 <= f < N for f in forced):\n        raise ValueError('Forced index out of range')\n    active = list(range(N))\n    per_round_masks = []\n    for i in range(len(round_scores)):\n        target = round_targets[i]\n        if target < len(forced):\n            raise ValueError('Target less than forced count')\n        if target > len(active):\n            raise ValueError('Target exceeds active count')\n        forced_active = [f for f in forced if f in active]\n        non_forced = [idx for idx in active if idx not in forced_active]\n        non_forced_sorted = sorted(non_forced, key=lambda idx: (-round_scores[i][idx], idx))\n        pick = target - len(forced_active)\n        if pick < 0 or pick > len(non_forced):\n            raise ValueError('Cannot pick enough non-forced')\n        selected_non_forced = set(non_forced_sorted[:pick])\n        kept = set(forced_active) | selected_non_forced\n        mask = [j in kept for j in range(N)]\n        per_round_masks.append(mask)\n        active = sorted(kept)\n    final_retained_indices = active\n    return {'per_round_masks': per_round_masks, 'final_retained_indices': final_retained_indices}\n\nNow we need to escape newlines. Replace each newline with \\n. Also escape any backslashes (none) and double quotes (none because we used single quotes). So the JSON value will be a string with \\n between lines.\n\nWe'll output: {\"implementation\": \"def solve(case):\\n    payload = case['payload']\\n    ...\"}\n\nBut note: The code has single quotes inside, that's fine because JSON string is delimited by double quotes. So we don't need to escape them.\n\nNow ensure the first character of output is { and last is }. That's fine.\n\nWe'll generate the exact string."},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":1152,"completion_tokens":4846,"total_tokens":5998,"prompt_tokens_details":{"cached_tokens":1024},"completion_tokens_details":{"reasoning_tokens":4368},"prompt_cache_hit_tokens":1024,"prompt_cache