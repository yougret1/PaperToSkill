 remaining > 0:\n        best_idx = -1\n        best_num = 0\n        best_den = 1\n        for i in range(n):\n            if allocations[i] < capacities[i]:\n                if best_idx == -1:\n                    best_idx = i\n                    best_num = importances[i]\n                    best_den = allocations[i] + 1\n                else:\n                    left = importances[i] * best_den\n                    right = best_num * (allocations[i] + 1)\n                    if left > right:\n                        best_idx = i\n                        best_num = importances[i]\n                        best_den = allocations[i] + 1\n                    elif left == right and i < best_idx:\n                        best_idx = i\n                        best_num = importances[i]\n                        best_den = allocations[i] + 1\n        if best_idx == -1:\n            raise ValueError(\"No capacity left\")\n        allocations[best_idx] += 1\n        remaining -= 1\n    by_name = {segments[i]['name']: allocations[i] for i in range(n)}\n    total = sum(allocations)\n    return {'allocations': allocations, 'by_name': by_name, 'total': total}\n\nNow escape: replace \" with \\\", and newline with \\n. Also backslash? No backslashes except in \\n we add. Also note that the code uses single quotes for dict keys, no issue.\n\nLet's write as a single line string with \\n.\n\nFinal JSON:\n{\n  \"implementation\": \"def solve(case):\\n    segments = case['segments']\\n    budget = case['budget']\\n    importances = [seg['importance'] for seg in segments]\\n    minima = [seg['minimum'] for seg in segments]\\n    capacities = [seg['capacity'] for seg in segments]\\n    total_min = sum(minima)\\n    total_cap = sum(capacities)\\n    if budget < total_min or budget > total_cap:\\n        raise ValueError(\\\"Budget out of feasible range\\\")\\n    n = len(segments)\\n    allocations = minima[:]\\n    remaining = budget - total_min\\n    while remaining > 0:\\n        bes