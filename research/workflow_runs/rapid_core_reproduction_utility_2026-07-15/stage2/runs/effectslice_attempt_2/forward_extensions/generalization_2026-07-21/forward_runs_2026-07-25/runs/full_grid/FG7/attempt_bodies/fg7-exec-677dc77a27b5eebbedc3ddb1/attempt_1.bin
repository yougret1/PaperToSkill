] > rank[ry]:\n            parent[ry] = rx\n        else:\n            parent[ry] = rx\n            rank[rx] += 1\n        return True\n    # build edges\n    edges = []\n    for u, v, d in distances:\n        w = max(core[u], core[v], d)\n        if u > v:\n            u, v = v, u\n        edges.append((w, u, v))\n    edges.sort()\n    mst = []\n    total = 0.0\n    for w, u, v in edges:\n        if union(u, v):\n            mst.append([u, v, w])\n            total += w\n            if len(mst) == len(nodes) - 1:\n                break\n    # optionally check connectivity\n    # if len(mst) != len(nodes)-1: raise - but we assume connected\n    return {\"mst_edges\": mst, \"total_weight\": total}\n\nNow I need to output as JSON with key \"implementation\" and value the source code as a JSON string. Escape newlines, backslashes, quotes. Use json.dumps internally? But we must manually write. I'll use a raw string and then escape manually or use Python's json.dumps within a script? Since I'm the AI, I'll just write the JSON with proper escaping.\n\nI'll write the Python code as a string without any extra newlines in the middle? Better to keep compact. Use triple quotes? Not in JSON. I'll use a single line with ; separating statements? But it's okay to have newlines in the string; JSON allows \\n. I'll write the code with proper indentation and then escape newlines as \\n and quotes as \\\". I'll manually escape each double quote. Also backslashes: need to escape backslash itself. For example, parent[x] = x, no backslashes. The only backslashes are in the code: maybe none. But in string literals? Not present. So safe.\n\nI'll produce a single JSON object: {\"implementation\": \"def solve(case):\\n    nodes = case['nodes']\\n    ...\"}\n\nBut we must ensure that the JSON is valid. I'll copy the code and escape manually. Let's do it step by step.\n\nWrite code in a string with actual newlines. Then for each newline replace with \\n. For each double quote replace with \\\". For each backslash replace with \\\\ (none). Also need to escape any control characters. I'll write in a compact form but with readability. I'll use spaces for indentation.\n\nI'll write the code as a multiline string and then escape.\n\nIn JSON, newline is \\n, tab is \\t, etc. I'll use 4 spaces for indent, so each indent becomes spaces. That's fine.\n\nLet me write the Python code:\n\ndef solve(case):\n    nodes = case['nodes']\n    core = case['core_distance']\n    distances = case['distances']\n    parent = {n: n for n in nodes}\n    rank = {n: 0 for n in nodes}\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n    def union(x, y):\n        rx, ry = find(x), find(y)\n        if rx == ry:\n            return False\n        if rank[rx] < rank[ry]:\n            parent[rx] = ry\n        elif rank[rx] > rank[ry]:\n            parent[ry] = rx\n        else:\n            parent[ry] = rx\n            rank[rx] += 1\n        return True\n    edges = []\n    for u, v, d in distances:\n        w = max(core[u], core[v], d)\n        if u > v:\n            u, v = v, u\n        edges.append((w, u, v))\n    edges.sort()\n    mst = []\n    total = 0.0\n    for w, u, v in edges:\n        if union(u, v):\n            mst.append([u, v, w])\n            total += w\n            if len(mst) == len(nodes) - 1:\n                break\n    return {\"mst_edges\": mst, \"total_weight\": total}\n\nNow escape for JSON: Replace each double quote with \\\", each newline with \\n. I'll do it manually:\n\n- Line1: \"def solve(case):\\n\"\n- Line2: \"    nodes = case['nodes']\\n\" -> need to escape single quotes? Not needed, single quotes are fine in JSON string; they don't need escaping. But to be safe, we can use double quotes inside the code? The code uses single quotes for dict keys, that's fine. The JSON string can contain single quotes. No escaping needed.\n- But the string itself is delimited by double