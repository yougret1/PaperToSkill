 n in nodes:\n        if n['parent'] is not None:\n            parent = node_map.get(n['parent'])\n            if parent:\n                parent['children'].append(n['id'])\n    # initial retained set\n    retained = set(n['id'] for n in nodes)\n    # symbol counts\n    symbol_count = {}\n    for n in nodes:\n        sym = n['symbol']\n        symbol_count[sym] = symbol_count.get(sym, 0) + 1\n    # sort nodes by depth descending, then id\n    sorted_nodes = sorted(nodes, key=lambda x: (-x['depth'], x['id']))\n    removed = set()\n    # function to collect retained subtree ids\n    def subtree_ids(node_id):\n        ids = [node_id]\n        for child_id in node_map[node_id]['children']:\n            if child_id not in removed:\n                ids.extend(subtree_ids(child_id))\n        return ids\n    # function to compute symbol delta for removal of subtree\n    def compute_delta(sub_ids):\n        delta = {}\n        for nid in sub_ids:\n            sym = node_map[nid]['symbol']\n            delta[sym] = delta.get(sym, 0) + 1\n        return delta\n    removal_order = []\n    for node in sorted_nodes:\n        nid = node['id']\n        if nid in removed:\n            continue\n        if nid == 'root' or node['symbol'] in required_symbols:\n            continue\n        if not node['removable']:\n            continue\n        # check children retained\n        children_retained = [c for c in node['children'] if c not in removed]\n        if children_retained:\n            continue\n        # compute subtree nodes currently retained\n        sub_ids = subtree_ids(nid)\n        # compute delta\n        delta = compute_delta(sub_ids)\n        # check if after removal all required symbols still >=1\n        feasible = True\n        for sym in required_symbols:\n            if symbol_count.get(sym, 0) - delta.get(sym, 0) <= 0:\n                feasible = False\n                break\n        if feasible:\n            # perform removal\n            for sid in sub_ids:\n                removed.add(sid)\n                sym = node_map[sid]['symbol']\n                symbol_count[sym] -= 1\n            removal_order.append(nid)\n            # note: we only record the root of the removed subtree? The task says \"removed_node_ids\" is the actual removal order. Typically it's the nodes we explicitly removed (i.e., the roots of removed subtrees). The description: \"removed_node_ids ... the actual removal order.\" We remove subtrees by removing the root node. So we record that root node id. That's consistent with the order we process.\n    # After loop, retained_node_ids = all node ids not in removed.\n    retained_ids = sorted([nid for nid in node_map if nid not in removed])\n    return {\n        \"removed_node_ids\": removal_order,\n        \"retained_node_ids\": retained_ids\n    }\n\nBut check edge: what if a required symbol node is also removable? We said we skip removal. So it stays.\n\nAlso note: The example fixtures have required_symbols = [\"root\", \"s1\"]. So root is always required, plus s1. So we must keep at least one node of symbol \"s1\". There may be multiple \"s1\" nodes. In the given trees, there are two \"s1\" nodes: n1 (depth1, not removable) and n4 (depth2, removable). So we must keep at least one of them. Since n1 is not removable, we cannot remove it. So n4 may be removable if n1 remains. So the algorithm would process deeper nodes first: n4 (depth2, removable, symbol s1). Is it removable? Its symbol is s1 which is required. So we skip because symbol in required_symbols. So we cannot remove n4. Then n6 (depth2, removable, symbol s0). s0 not required. Check children: none? n6 has no children. So children_retained empty. Compute subtree: just n6. delta: s0 count becomes 0 but required symbols not affected. So feasible. So remove n6. Then next deeper? Actually after n4 and n6, next deeper is n5 (depth2, not removable, symbol s2) skip. Then depth1 nodes: n2 (removable, symbol s2, not required, children: n4 (but n4 not