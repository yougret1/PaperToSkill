):\n    nodes = case['nodes']\n    required = set(case['required_symbols'])\n    node_map = {n['id']: n for n in nodes}\n    # validate root\n    roots = [n for n in nodes if n['parent'] is None]\n    if len(roots) != 1:\n        raise ValueError(\"Must have exactly one root node\")\n    root_id = roots[0]['id']\n    # validate parents exist\n    for n in nodes:\n        if n['parent'] is not None and n['parent'] not in node_map:\n            raise ValueError(f\"Parent {n['parent']} not found for node {n['id']}\")\n    # validate required symbols present\n    symbols = {n['symbol'] for n in nodes}\n    for sym in required:\n        if sym not in symbols:\n            raise ValueError(f\"Required symbol {sym} not present in any node\")\n    # build children lists\n    children = {}\n    for n in nodes:\n        pid = n['parent']\n        if pid is not None:\n            children.setdefault(pid, []).append(n['id'])\n    # initially retain all\n    retained = set(node_map.keys())\n    removed_order = []\n    # sort by depth desc, then id asc\n    nodes_sorted = sorted(nodes, key=lambda n: (-n['depth'], n['id']))\n    for n in nodes_sorted:\n        nid = n['id']\n        if nid not in retained:\n            continue\n        if not n['removable']:\n            continue\n        if n['parent'] is None:\n            continue\n        if n['symbol'] in required:\n            continue\n        # check children: if any child still retained, cannot remove\n        if any(cid in retained for cid in children.get(nid, [])):\n            continue\n        retained.remove(nid)\n        removed_order.append(nid)\n    retained_sorted = sorted(retained)\n    return {\"removed_node_ids\": removed_order, \"retained_node_ids\": retained_sorted}\n\nWe must also handle that \"utility\" field is present but unused.\n\nNow embed this in JSON. We'll write as a single line with \\n. We'll ensure we escape double quotes inside the code (strings). For example, in the validation string \"Parent