not completed\n    \n    # loop\n    while steps < max_steps:\n        if state not in transitions:\n            # invalid state, stop with error\n            status = \"error\"\n            break\n        node = transitions[state]\n        if node[\"kind\"] == \"final\":\n            final_value = node[\"value\"]\n            status = \"completed\"\n            break\n        elif node[\"kind\"] == \"action\":\n            action = node[\"action\"]\n            # get observation\n            if action in tool_observations:\n                observation = tool_observations[action]\n            else:\n                # missing tool - treat as invalid action? maybe observation = \"invalid_tool\"\n                observation = \"invalid_tool\"  # or something; spec says \"invalid-action feedback\"\n            # determine next state\n            next_by_obs = node.get(\"next_by_observation\", {})\n            if observation in next_by_obs:\n                next_state = next_by_obs[observation]\n            else:\n                next_state = node.get(\"default_next\")\n            # record trace step\n            steps += 1\n            trace.append({\n                \"step\": steps,\n                \"action\": action,\n                \"observation\": observation,\n                \"state\": state  # current state before action? or after? The schema: state is part of trace. Should be the state at the time of action? Usually state before action. We'll record the current state before action.\n            })\n            # move to next state\n            state = next_state\n        else:\n            # unknown kind, error\n            status = \"error\"\n            break\n    else:\n        # loop finished without break, meaning steps >= max_steps and not final\n        # status = \"max_steps_exceeded\"\n        status = \"max_steps_exceeded\"\n        # final remains None\n    \n    # if we broke due to error, final_value might be None\n    return {\n        \"final\"