{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "SE-CR-02",
  "atoms": [
    {
      "atom_id": "a_d557312a2d31d794",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 421,
        "byte_end": 506,
        "split_index": 0
      },
      "rendered_text": "Implement `chunk_reduction_schedule` through `solve(case)` for this bounded objective: Apply deterministic chunk-removal and granularity-refinement passes while preserving a supplied syntax and interestingness oracle.",
      "rendered_text_sha256": "60e63d287d075b6619d3e98be9aa195d12248f46f4673780261be90ee2ed5313"
    },
    {
      "atom_id": "a_f792338bb1956a2a",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 421,
        "byte_end": 506,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Chunk-based reduction and pass refinement on registered token trees; compiler execution is supplied by fixtures. Validate every required field before computing a result.",
      "rendered_text_sha256": "304e0ceb0162130e87719ac05884fc4b0ac5920b9b8ab75075ecec449a99b1b1"
    },
    {
      "atom_id": "a_833fda9a5f03ec48",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 421,
        "byte_end": 506,
        "split_index": 2
      },
      "rendered_text": "Start chunk removal at granularity two.",
      "rendered_text_sha256": "45e95787c13c4e4b0ce219646579515b7a92cf377a65cf4a2de458ffedf5f549"
    },
    {
      "atom_id": "a_b75299577c4ec2f0",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 421,
        "byte_end": 506,
        "split_index": 3
      },
      "rendered_text": "Try chunks from left to right and accept removal only if required failure items remain.",
      "rendered_text_sha256": "fad8ecd8df3daf24a7da8cc08c16a902d3fa03be6120505f2341c4feff0b11b6"
    },
    {
      "atom_id": "a_da4aa3fd9d8e43e2",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 421,
        "byte_end": 506,
        "split_index": 4
      },
      "rendered_text": "Restart after an accepted removal with slightly coarser granularity.",
      "rendered_text_sha256": "d478bda4771901137860cf28a225e84527b1d02f74bddb170cca7d65bf894124"
    },
    {
      "atom_id": "a_f9a9ed28d78574df",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 421,
        "byte_end": 506,
        "split_index": 5
      },
      "rendered_text": "Double granularity when no removal succeeds and stop at singleton granularity.",
      "rendered_text_sha256": "c71627aa653f4d45f7d2420c6ba3ce0baa750ccc7d40375f59cd11aba53338f1"
    },
    {
      "atom_id": "a_c87de3a7faf38fa4",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 523,
        "byte_end": 620,
        "split_index": 6
      },
      "rendered_text": "Return the reduced items, attempt count, and an explicit one-minimal check.",
      "rendered_text_sha256": "d962a49de78176dd8fcfd068b7e289349aa6ecd883d449d093456f430ee138c7"
    },
    {
      "atom_id": "a_6eea82872238b1bf",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 523,
        "byte_end": 620,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: syntax_valid, interestingness_preserved, granularity_progression, no_stale_cache.",
      "rendered_text_sha256": "ef8adde7408af515f0c5b7b305b26e99d85b883db513d0332f69ce7a0c60cb2c"
    },
    {
      "atom_id": "a_1e4fdf0827fba817",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 523,
        "byte_end": 620,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_7b29ed183a4789d2",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 523,
        "byte_end": 620,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_67aff08bf0bc8b57",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 523,
        "byte_end": 620,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_cfca819d0869261a",
      "source_locator": {
        "document_sha256": "a77d48ba8b36c5396ea816aa2ea77c93d92baaffbb257df31ce4fc6bb0a2c40b",
        "byte_start": 523,
        "byte_end": 620,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
