{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "DATA-LEI-02",
  "atoms": [
    {
      "atom_id": "a_4c14420ce587b0f0",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 0
      },
      "rendered_text": "Implement `refinement_and_aggregation` through `solve(case)` for this bounded objective: Refine communities and construct the aggregated graph while preserving parent-community constraints and edge weights.",
      "rendered_text_sha256": "bb63ce68d914962756cd8abe3a818601fdacc839e3d1003a48981ef56e91c94a"
    },
    {
      "atom_id": "a_9a83ea07574df2ec",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Leiden refinement and aggregation phases on registered miniature graphs; stochastic node order is replaced by a frozen permutation. Validate every required field before computing a result.",
      "rendered_text_sha256": "510ad834523853c5ed733dc4e10900bdea71b75f20fa3f44144a1dd9a32b66da"
    },
    {
      "atom_id": "a_f43d38a57dc069ab",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 2
      },
      "rendered_text": "Map each original node to exactly one refined community.",
      "rendered_text_sha256": "5ef3cf7666a8a3d877aa590d54c36bc0833227e9910c5f2c223f22cd26c8d2d3"
    },
    {
      "atom_id": "a_a4a6c72d9aef1d84",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 3
      },
      "rendered_text": "Map every edge endpoint through that refinement.",
      "rendered_text_sha256": "1662c5e7a0e507577b1cb04e2aecc15d91eeb1d40c9b7552eb1662eef7b2d46d"
    },
    {
      "atom_id": "a_5980f58020b02c4d",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 4
      },
      "rendered_text": "Canonicalize each aggregate endpoint pair so undirected duplicates coincide.",
      "rendered_text_sha256": "8095b0e0b3224e8e4553e8f078d927a199e1681dd383f9ea6238ad8afcc8835d"
    },
    {
      "atom_id": "a_e21466b97d5db945",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 454,
        "byte_end": 548,
        "split_index": 5
      },
      "rendered_text": "Sum all weights for each aggregate pair including self-loops.",
      "rendered_text_sha256": "71d93672339054f0b6c3007faa665935d5bfd96a1c550e355ad926adf69718a0"
    },
    {
      "atom_id": "a_36bce3abac62f26e",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 565,
        "byte_end": 642,
        "split_index": 6
      },
      "rendered_text": "Return sorted aggregate edges and sorted membership lists.",
      "rendered_text_sha256": "09c2598226f25d3280a5ac72c525bd8db12e883918cf15f7f76ec7278a552cd0"
    },
    {
      "atom_id": "a_38568dc66857d4ce",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 565,
        "byte_end": 642,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: parent_constraint, refined_connectivity, weight_conservation, deterministic_mapping.",
      "rendered_text_sha256": "11815fc0b96c578f55b2b10e908f4dd4341bf19f18a3f7c3ba60c0a731f031d4"
    },
    {
      "atom_id": "a_130b480375380018",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 565,
        "byte_end": 642,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_e6724b4472d08b6e",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 565,
        "byte_end": 642,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_8df696546853349e",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 565,
        "byte_end": 642,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_ddc425fa9f0fdc57",
      "source_locator": {
        "document_sha256": "a04bc366ce0fcce74ba5c8808b3ec1d6d656633a1d82264348539a06ad2a1fca",
        "byte_start": 565,
        "byte_end": 642,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
