{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "SE-DD-02",
  "atoms": [
    {
      "atom_id": "a_9f751448a0fbb632",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 454,
        "byte_end": 537,
        "split_index": 0
      },
      "rendered_text": "Implement `difference_isolation` through `solve(case)` for this bounded objective: Isolate a minimal causal difference between passing and failing configurations under the paper's delta-debugging invariant.",
      "rendered_text_sha256": "426e0ceba46d1fbb1271fecc0b47c05ccd0113fa0a38e623a427aa0f6716c188"
    },
    {
      "atom_id": "a_bafcd7ccb23e0161",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 454,
        "byte_end": 537,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Difference isolation between c_pass and c_fail; source-code transformation is excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "0e0ce32ef657aea0a2696ad3e92cd531320a2495fa13378888f61be437823e9e"
    },
    {
      "atom_id": "a_3e0f3b5c760cb125",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 454,
        "byte_end": 537,
        "split_index": 2
      },
      "rendered_text": "Compute the ordered change set present in failing but absent from passing.",
      "rendered_text_sha256": "bcd60a25e2545c927eeb60bfc790f997a06b691509f201a60def4ef3a3418e10"
    },
    {
      "atom_id": "a_17d31bd10afcc52f",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 454,
        "byte_end": 537,
        "split_index": 3
      },
      "rendered_text": "Run ddmin only on this difference.",
      "rendered_text_sha256": "d066fe7d91450b93ef37654b2c6bbab5150d186085a1dd8efeed4321d972de9e"
    },
    {
      "atom_id": "a_d8b1d7f0e474cdc1",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 454,
        "byte_end": 537,
        "split_index": 4
      },
      "rendered_text": "Preserve the registered PASS/FAIL/UNRESOLVED oracle semantics.",
      "rendered_text_sha256": "2a8a8b8b38e2597f2bf872ebdad2d9cd7cfe472d903e8dccd114b2105e0b73eb"
    },
    {
      "atom_id": "a_31dc866f48624e9b",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 454,
        "byte_end": 537,
        "split_index": 5
      },
      "rendered_text": "Retain source order through every subset and complement.",
      "rendered_text_sha256": "25ec04d425bd2852887e9a28088fce913a3bf5a57a3cfae82718e2d9373b09e2"
    },
    {
      "atom_id": "a_f20c884d5c0d88c0",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 554,
        "byte_end": 648,
        "split_index": 6
      },
      "rendered_text": "Return the isolated difference and number of tests.",
      "rendered_text_sha256": "7f3e304472dca43f32b23e8466553f4f3057060159115b334e51bc6e9c8f21ab"
    },
    {
      "atom_id": "a_a5b7d739d447aeee",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 554,
        "byte_end": 648,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: endpoint_invariant, minimal_difference, call_accounting, termination.",
      "rendered_text_sha256": "1cfe0bdaa242be5a14a00fd7bf1a95c5a72155875f8a04ce6c135d462323ec12"
    },
    {
      "atom_id": "a_56328bec1f94d305",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 554,
        "byte_end": 648,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_97e2700305265a4a",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 554,
        "byte_end": 648,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_69f1077c5f0f8751",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 554,
        "byte_end": 648,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_fd54078f5b466336",
      "source_locator": {
        "document_sha256": "a1c0707f048d0fbc7328c8ce0a681ff0b2dffc1f77abb963ce201ff5892fc77f",
        "byte_start": 554,
        "byte_end": 648,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
