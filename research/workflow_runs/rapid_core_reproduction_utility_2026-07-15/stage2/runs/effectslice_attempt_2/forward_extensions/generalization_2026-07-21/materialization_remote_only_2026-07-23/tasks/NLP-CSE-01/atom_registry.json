{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "NLP-CSE-01",
  "atoms": [
    {
      "atom_id": "a_372317f2516d13d3",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 485,
        "byte_end": 568,
        "split_index": 0
      },
      "rendered_text": "Implement `context_aware_sentence_scoring` through `solve(case)` for this bounded objective: Compute registered context-aware sentence scores from supplied sentence embeddings, masks, and neighborhood context without invoking an encoder model.",
      "rendered_text_sha256": "cc775588a7b0e59fda6da607f27d3b8e19987e450ec4ff0f3f124726b8bef91d"
    },
    {
      "atom_id": "a_a0157ef5e3e30418",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 485,
        "byte_end": 568,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Sentence-level contextual scoring with frozen embeddings; representation-model training is excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "9eb388eedc5174f206438dcc6b003637ff89c87124b5a2c3ce6cd9af1e7b7253"
    },
    {
      "atom_id": "a_743a8230cbf64e7c",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 485,
        "byte_end": 568,
        "split_index": 2
      },
      "rendered_text": "Compute cosine similarity between each sentence vector and the query.",
      "rendered_text_sha256": "ea879b929ee912cab5f61027f83c7df8bf211ef67c40e5aacaa03c94f3697ece"
    },
    {
      "atom_id": "a_0c73fb99477f0164",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 485,
        "byte_end": 568,
        "split_index": 3
      },
      "rendered_text": "Use zero similarity if either norm is zero.",
      "rendered_text_sha256": "337b6e9b4b73a619889018f8d72d4fa53969ed120b8b69f76aa2f7ed1b0ce655"
    },
    {
      "atom_id": "a_daf86713c4f1cfa4",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 485,
        "byte_end": 568,
        "split_index": 4
      },
      "rendered_text": "For each position average the available immediate-neighbor similarities.",
      "rendered_text_sha256": "77e784027978ddbcb7b4d5c87ff65300502a650de487836d91dec2e8501e533d"
    },
    {
      "atom_id": "a_d02293a1fd06dc7b",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 485,
        "byte_end": 568,
        "split_index": 5
      },
      "rendered_text": "Blend own and neighbor scores using the registered context weight.",
      "rendered_text_sha256": "13310a9fa095a2634cc74cb0c27d873d79c63c156ffa372ce46f917407fedde3"
    },
    {
      "atom_id": "a_cbaf8f1db0ef788b",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 585,
        "byte_end": 656,
        "split_index": 6
      },
      "rendered_text": "Round scores and rank by descending score then source index.",
      "rendered_text_sha256": "db787d52b812278dfa4ca4ccf166f258fb92ce4cd248555a4d5b992979d6bbe5"
    },
    {
      "atom_id": "a_9cc1843547a6d264",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 585,
        "byte_end": 656,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: context_aggregation, mask_integrity, finite_scores, deterministic_tolerance.",
      "rendered_text_sha256": "c1b421837651624b222517574b5c17388817258101adf9981430d9e164035c00"
    },
    {
      "atom_id": "a_e667ffec7b7e3d32",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 585,
        "byte_end": 656,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_93d4a5dfbd9cadd8",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 585,
        "byte_end": 656,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_1c3e8351b22e7376",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 585,
        "byte_end": 656,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_92f31f6d161a5ffe",
      "source_locator": {
        "document_sha256": "0d6d0ea5d75a8dcc8f588131f6d2f92f7dd30d4c1c9d8615c372d1dac033ef10",
        "byte_start": 585,
        "byte_end": 656,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
