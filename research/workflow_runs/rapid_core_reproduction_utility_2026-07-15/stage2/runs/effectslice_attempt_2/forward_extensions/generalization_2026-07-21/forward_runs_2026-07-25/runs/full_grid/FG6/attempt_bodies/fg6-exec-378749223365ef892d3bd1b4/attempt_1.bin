 seg in segments]\n    sum_mins = sum(mins)\n    sum_caps = sum(caps)\n    if budget < sum_mins or budget > sum_caps:\n        raise ValueError(\"Budget infeasible\")\n    alloc = mins[:]  # copy\n    allocated = sum_mins\n    while allocated < budget:\n        best_idx = -1\n        best_num = -1\n        best_den = 1  # placeholder\n        best_ratio = None\n        # find best segment\n        for i in range(n):\n            if alloc[i] >= caps[i]:\n                continue\n            # compare importance/(alloc[i]+1) with current best\n            # using cross multiplication\n            num = imp[i]\n            den = alloc[i] + 1\n            if best_idx == -1:\n                best_idx = i\n                best_num = num\n                best_den = den\n            else:\n                # compare num/den vs best_num/best_den\n                # actual comparison: num * best_den > best_num * den\n                if num * best_den > best_num * den:\n                    best_idx = i\n                    best_num = num\n                    best_den = den\n                elif num * best_den == best_num * den:\n                    # tie break by original order: if i < best_idx, then i is earlier\n                    if i < best_idx:\n                        best_idx = i\n                        best_num = num\n                        best_den = den\n        # allocate one to best_idx\n        alloc[best_idx] += 1\n        allocated += 1\n    by_name = {}\n    for i, name in enumerate(names):\n        by_name[name] = alloc[i]\n    return {\n        'allocations': alloc,\n        'by_name': by_name,\n        'total': allocated\n    }\n\nCheck: total should equal budget. allocated after loop equals budget.\n\nEdge: if budget == sum_mins, loop doesn't execute and alloc = mins, total = sum_mins which is budget.\n\nTest with given fixtures? Not needed.\n\nNow encode as JSON string. We'll write the code inside a triple-quoted string? Actually the JSON value must be a