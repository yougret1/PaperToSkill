e or 'calls' not in case:\n        raise ValueError(\"missing threshold or calls\")\n    threshold = case['threshold']\n    if not isinstance(threshold, (int, float)):\n        raise ValueError(\"threshold must be numeric\")\n    calls = case['calls']\n    if not isinstance(calls, list):\n        raise ValueError(\"calls must be list\")\n    diagnostics = []\n    accepted_call_ids = []\n    for call in calls:\n        if not isinstance(call, dict):\n            raise ValueError(\"each call must be dict\")\n        needed = ['call_id','loss_without_call','loss_with_call','prediction_tokens','parseable']\n        for key in needed:\n            if key not in call:\n                raise ValueError(f\"missing {key} in call\")\n        call_id = call['call_id']\n        loss_without = call['loss_without_call']\n        loss_with = call['loss_with_call']\n        pred_tokens = call['prediction_tokens']\n        parseable = call['parseable']\n        # Validate types\n        if not isinstance(loss_without, (int, float)):\n            raise ValueError(\"loss_without_call must be numeric\")\n        if not isinstance(loss_with, (int, float)):\n            raise ValueError(\"loss_with_call must be numeric\")\n        if not isinstance(pred_tokens, (int, float)) or pred_tokens == 0:\n            raise ValueError(\"prediction_tokens must be non-zero number\")\n        if not isinstance(parseable, bool):\n            raise ValueError(\"parseable must be boolean\")\n        gain = loss_without - loss_with\n        normalized_gain = gain / pred_tokens\n        accepted = parseable and normalized_gain >= threshold\n        diagnostics.append({\n            \"accepted\": accepted,\n            \"call_id\": call_id,\n            \"normalized_gain\": normalized_gain\n        })\n        if accepted:\n            accepted_call_ids.append(call_id)\n    return {\n        \"accepted_call_ids\": accepted_call_ids,\n        \"diagnostics\": diagnostics\n    }\n\nWe need to ensure that nor