 edges = case.get('edges')\n    communities = case.get('communities')\n    resolution = case.get('resolution')\n    if not all([edges, communities, resolution is not None]):\n        raise ValueError(\"Missing required fields\")\n    # Build adjacency\n    adj = {}\n    deg = {}\n    nodes = sorted(communities.keys())\n    for u,v,w in edges:\n        adj.setdefault(u, {})[v] = adj[u].get(v,0) + w\n        adj.setdefault(v, {})[u] = adj[v].get(u,0) + w\n    # Compute degrees\n    for node in nodes:\n        deg[node] = sum(adj.get(node, {}).values())\n    total_m = sum(deg.values()) / 2.0  # because each edge counted twice\n    gamma = float(resolution)\n\n    # Community data\n    # Use dict mapping community label to set of nodes and sum_tot\n    # Also maintain a dict node->community\n    node_comm = {node: communities[node] for node in nodes}\n    comm_nodes = {}\n    comm_sum_tot = {}\n    for node, comm in node_comm.items():\n        comm_nodes.setdefault(comm, set()).add(node)\n        comm_sum_tot[comm] = comm_sum_tot.get(comm, 0) + deg[node]\n\n    moves = []\n\n    for node in nodes:\n        curr_comm = node_comm[node]\n        deg_i = deg[node]\n        # Compute w_iC for each neighbor community\n        w_c = {}\n        for neighbor, weight in adj.get(node, {}).items():\n            comm_n = node_comm[neighbor]\n            w_c[comm_n] = w_c.get(comm_n, 0) + weight\n        # Include current community? Already included if neighbor in same community.\n        # Evaluate gain for each encountered community plus current community\n        current_gain = (w_c.get(curr_comm, 0) / total_m) - gamma * (deg_i * comm_sum_tot[curr_comm]) / (2.0 * total_m * total_m)\n        best_comm = curr_comm\n        best_net = 0.0\n        # We'll check all communities that appear in w_c, and also consider staying? Actually we need to consider moving to any community, even if no direct edge? Gain to a community"},"logprobs":null,"finish_reason":"length"}],"usage":{"prompt_to