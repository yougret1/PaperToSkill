83,6:0.627,7:0.111\nforced=2. Need 5 more. Top: 3(0.927),5(0.783),6(0.627),0(0.464),1(0.363). So selected = {2,3,5,6,0,1} sorted: [0,1,2,3,5,6]\nRound1: eligible {0,1,2,3,5,6}. Scores:\n0:0.749,1:0.316,2:0.265,3:0.777,5:0.034,6:0.633\nNeed 4. Top: 0(0.749),3(0.777),6(0.633),1(0.316) or 2(0.265)? Actually 3 is highest 0.777, then 0 0.749, then 6 0.633, then 1 0.316 > 2 0.265. So selected [0,1,3,6] sorted: [0,1,3,6].\nHistory = [[0,1,2,3,5,6], [0,1,3,6]].\nretained = [0,1,3,6].\n\nCase 2: forced=[3]\nRound0: scores:\n0:0.521,1:0.388,2:0.134,3:0.954,4:0.023,5:0.656,6:0.610,7:0.697\nforced=3. Need 5 more. Top: 7(0.697),5(0.656),6(0.610),0(0.521),1(0.388). So selected = {3,7,5,6,0,1} sorted: [0,1,3,5,6,7]\nRound1: eligible {0,1,3,5,6,7}. Scores:\n0:0.421,1:0.241,3:0.949,5:0.631,6:0.190,7:0.273\nNeed 4. Top: 3(0.949),5(0.631),0(0.421),7(0.273) (since 1 is 0.241,6 is 0.190). So selected = [0,3,5,7] sorted.\nHistory = [[0,1,3,5,6,7], [0,3,5,7]].\nretained = [0,3,5,7].\n\nThese outputs seem plausible. The algorithm likely matches the intended task. However, we must confirm that the forced list applies only to first round and that we sort indices ascending in history and retained_indices. Also note that the forced list might contain indices that are only forced for that round? Could be but given examples, it's one index per case.\n\nWe'll implement accordingly.\n\nNow we need to output Python source code as JSON string under key \"implementation\". The function solve(case) should import nothing, use only standard library. We'll write the function.\n\nAlso note: The input case is the payload directly; it may contain _case_nonce but we ignore.\n\nImplementation steps:\n- def solve(case):\n    round_scores = case[\"round_scores\"]\n    round_targets = case[\"round_targets\"]\n    forced = case.get(\"forced\", [])  # assume present\n    n_rounds = len(round_scores)\n    history = []\n    # selected indices for current round; initially none? We'll set for round 0.\n    # Actually we need to carry forward selected set.\n    selected = None\n    for r in range(n_rounds):\n        scores = round_scores[r]\n        target = round_targets[r]\n        if r == 0:\n            eligible = set(range(len(scores)))\n            forced_set = set(forced)\n        else:\n            eligible = selected  # selected from previous round\n            forced_set = set()\n        # Ensure forced indices are in eligible\n        if not forced_set.issubset(eligible):\n            # This shouldn't happen based on data, but handle\n            forced_set = forced_set & eligible\n        # Start with forced indices\n        chosen = set(forced_set)\n        # Determine remaining eligible indices not yet chosen\n        remaining = eligible - chosen\n        # Sort remaining by score descending\n        # Possibly need to break ties? Use index as tiebreaker? Not needed.\n        sorted_remaining = sorted(remaining, key=lambda i: scores[i], reverse=True)\n        # Take as many as needed\n        needed = target - len(chosen)\n        if needed > 0:\n            chosen.update(sorted_remaining[:needed])\n        # Convert to list sorted ascending for consistency\n        chosen_list = sorted(chosen)\n        history.append(chosen_list)\n        selected = set(chosen_list)  # for next round\n    retained_indices = history[-1]  # last round selections\n    return {\"history\": history, \"retained_indices\": retained_indices}\n\nBut careful: In the first round, eligible is all indices. After first round, selected is the set of indices chosen. Then for second round, eligible is exactly that set. So we are selecting from those indices.\n\nWe should also handle the case where forced indices might be more than target? Not in fixtures.\n\nNow produce the JSON output.\n\nWe need to write the implementation as a JSON object with key \"implementation\" whose value is a string containing Python code. Escape newlines, quotes, backslashes.\n\nWe'll produce the code as a single line string with proper escapes.\n\nLet's write the code:\n\ndef solve(case):\n    round_scores = case['round_scores']\n    round_targets = case['round_targets']\n    forced = case.get('forced', [])\n    history = []\n    selected = None\n    for r, (scores, target) in enumerate(zip(round_scores, round_targets)):\n        if r == 0:\n            eligible = set(range(len(scores)))\n            forced_set = set(forced)\n        else:\n            eligible = selected\n            forced_set = set()\n        # ensure forced are in eligible\n        forced_set = forced_set & eligible\n        chosen = set(forced_set)\n        remaining = eligible - chosen\n        # sort remaining by score descending, then by index ascending for stability\n        sorted_remaining = sorted(remaining, key=lambda i: (-scores[i], i))\n        needed = target - len(chosen)\n        if needed > 0:\n            chosen.update(sorted_remaining[:needed])\n        chosen_list = sorted(chosen)\n        history.append(chosen_list)\n        selected = set(chosen_list)\n    retained_indices = history[-1]\n    return {'history': history, 'retained_indices': retained_indices}\n\nWe added secondary sort by index for stability. But not required.\n\nNow we need to enclose in JSON string. We'll produce the implementation string with proper escapes.\n\nWe'll write the entire response as a JSON object. Let's do it."},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":1206,"completion_tokens":4096,"total_tokens":5302,"prompt_tokens_details":{"cached_tokens":1152},"completion_tokens_details":{"reasoning_tokens":3837},"prompt_cache_hit_tokens":1152,"prompt_cache_miss_tokens":54},"system_fingerprint":"fp_8b330d02d0_prod0820_fp8_kvcache_20260402"}