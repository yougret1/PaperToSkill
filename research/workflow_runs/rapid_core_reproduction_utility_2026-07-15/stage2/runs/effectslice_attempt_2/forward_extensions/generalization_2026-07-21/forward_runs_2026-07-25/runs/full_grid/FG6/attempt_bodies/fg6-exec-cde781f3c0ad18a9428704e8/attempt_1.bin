 raise ValueError('Infeasible budget')\n    remaining = budget - total_min\n    while remaining > 0:\n        best_idx = -1\n        best_num = None\n        best_den = None\n        for i, seg in enumerate(segments):\n            if allocations[i] < seg['capacity']:\n                current_num = seg['importance']\n                current_den = allocations[i] + 1\n                if best_idx == -1:\n                    best_idx = i\n                    best_num = current_num\n                    best_den = current_den\n                else:\n                    # compare current with best\n                    if current_num * best_den > best_num * current_den:\n                        best_idx = i\n                        best_num = current_num\n                        best_den = current_den\n                    elif current_num * best_den == best_num * current_den:\n                        if i < best_idx:\n                            best_idx = i\n                            best_num = current_num\n                            best_den = current_den\n        if best_idx == -1:\n            raise ValueError('Infeasible: capacity exhausted')\n        allocations[best_idx] += 1\n        remaining -= 1\n    total = sum(allocations)\n    by_name = {segments[i]['name']: allocations[i] for i in range(n)}\n    return {\"allocations\": allocations, \"by_name\": by_name, \"total\": total}\n```\n\nNow we need to convert this to a JSON string. We'll escape appropriately. Note that the code contains single quotes in raise statements and in dict keys like `key in seg` etc. Those single quotes are fine; no need to escape. Only double quotes in the return dict need escaping.\n\nWe'll produce the final JSON.\n\nOne more thing: The schema's \"allocations\" is an array of integers. Our allocations list is integers. Good.\n\nWe'll output exactly one JSON object with key \"implementation\" and value the source string.\n\nNow write the final response."},"logprobs":null,"finish_reason":