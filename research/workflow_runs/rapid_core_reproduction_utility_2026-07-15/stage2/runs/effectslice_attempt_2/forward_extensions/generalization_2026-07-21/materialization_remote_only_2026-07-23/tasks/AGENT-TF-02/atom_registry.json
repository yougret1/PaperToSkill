{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "AGENT-TF-02",
  "atoms": [
    {
      "atom_id": "a_d57358ceac2a03ea",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 436,
        "byte_end": 527,
        "split_index": 0
      },
      "rendered_text": "Implement `accepted_call_interleaving` through `solve(case)` for this bounded objective: Apply accepted API calls to text while preserving registered span order, rejecting overlaps, and keeping all eligible calls.",
      "rendered_text_sha256": "68efe6b58a9ed6225e547d94a499463c90d1ba91026049a03998fb684c9222ce"
    },
    {
      "atom_id": "a_b3cc4923d4346be7",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 436,
        "byte_end": 527,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Post-filter call interleaving and serialization; API execution outputs are supplied by fixtures. Validate every required field before computing a result.",
      "rendered_text_sha256": "4170385434d5c773dd87253096fd3375547b6c9cd5d9e1b655733e36ef955f80"
    },
    {
      "atom_id": "a_3fd2727e43597dbc",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 436,
        "byte_end": 527,
        "split_index": 2
      },
      "rendered_text": "Rank candidates by descending score, start position, then call ID.",
      "rendered_text_sha256": "4ee02daeeffa471363aa5f6fee3d6a2e06aa08c4f44fe2e3e1d4c4e98600c3b2"
    },
    {
      "atom_id": "a_ae0014940d796c96",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 436,
        "byte_end": 527,
        "split_index": 3
      },
      "rendered_text": "Greedily reject any span overlapping an already selected span.",
      "rendered_text_sha256": "ff8503056f2e53661561eb98cb55dc10aa16150cb0ccd34032c8028c12a00a94"
    },
    {
      "atom_id": "a_36bd6680b390b333",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 436,
        "byte_end": 527,
        "split_index": 4
      },
      "rendered_text": "Order accepted calls by source start for reporting.",
      "rendered_text_sha256": "0da370779c5134570f803c6d30593118ff60ce2db31fc8a4c7eec9e8f0eb552d"
    },
    {
      "atom_id": "a_45ef614635fc4030",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 436,
        "byte_end": 527,
        "split_index": 5
      },
      "rendered_text": "Apply replacements from right to left so earlier offsets do not shift.",
      "rendered_text_sha256": "7181f09705be4730cbe33365c7e3258b58247ae0c2b0210ed0e2062a1d83d2fb"
    },
    {
      "atom_id": "a_5087c5542bde3a22",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 544,
        "byte_end": 635,
        "split_index": 6
      },
      "rendered_text": "Return selected IDs and the exact interleaved token stream.",
      "rendered_text_sha256": "e2e59fae3af41d5f3f411dcb490637cf058eaddd4471412534bdf24270536c62"
    },
    {
      "atom_id": "a_c424ceb86709ac51",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 544,
        "byte_end": 635,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: no_overlap, all_eligible_calls, stable_offsets, valid_serialization.",
      "rendered_text_sha256": "af549c9a0166d30c72439ecd104892e4cbdc074e685390364275ecb38514f34d"
    },
    {
      "atom_id": "a_16c5d2489442eec5",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 544,
        "byte_end": 635,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_14102b21bc48896d",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 544,
        "byte_end": 635,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_db2afb72f7d7fd25",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 544,
        "byte_end": 635,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_9ae7986955b3d222",
      "source_locator": {
        "document_sha256": "01b2652d62e35a035e5f5a84a9b0ca09c92effa0b3d41a920fdd02415e153680",
        "byte_start": 544,
        "byte_end": 635,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
