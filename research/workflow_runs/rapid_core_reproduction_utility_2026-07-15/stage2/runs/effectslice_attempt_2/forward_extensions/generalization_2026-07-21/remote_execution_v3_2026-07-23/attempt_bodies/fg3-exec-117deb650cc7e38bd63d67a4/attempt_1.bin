red = [\"word_token_indices\", \"word_scores\", \"forced_words\", \"token_budget\"]\n    for field in required:\n        if field not in payload:\n            return {\"error\": f\"missing field {field}\"}\n    word_token_indices = payload[\"word_token_indices\"]\n    word_scores = payload[\"word_scores\"]\n    forced_words = payload[\"forced_words\"]\n    token_budget = payload[\"token_budget\"]\n    # validate types\n    if not (isinstance(word_token_indices, list) and isinstance(word_scores, list) and isinstance(forced_words, list) and isinstance(token_budget, int)):\n        return {\"error\": \"invalid types\"}\n    N = len(word_token_indices)\n    if len(word_scores) != N:\n        return {\"error\": \"length mismatch\"}\n    # validate forced_words indices\n    for idx in forced_words:\n        if not (0 <= idx < N):\n            return {\"error\": f\"forced word index {idx} out of range\"}\n    # compute forced tokens\n    forced_set = set(forced_words)\n    forced_tokens = sum(len(word_token_indices[i]) for i in forced_set)\n    if forced_tokens > token_budget:\n        return {\"words\": [], \"tokens\": [], \"budget_used\": 0, \"feasible\": False}\n    # select forced words first (they are automatically selected)\n    selected = set(forced_set)\n    remaining_budget = token_budget - forced_tokens\n    # candidates: indices not in forced_set\n    candidates = [(i, word_scores[i], len(word_token_indices[i])) for i in range(N) if i not in forced_set]\n    # sort by descending score, then ascending index (source position)\n    candidates.sort(key=lambda x: (-x[1], x[0]))\n    for i, score, tok_len in candidates:\n        if tok_len <= remaining_budget:\n            selected.add(i)\n            remaining_budget -= tok_len\n    # now build output: words in original order\n    selected_words = sorted(selected)  # ascending index order\n    tokens = []\n    for idx in selected_words:\n        tokens.extend(word_token_indices[idx])\n    # tokens are already in orde