alls must be a list\\\\\\\")\\\\n    accepted = []\\\\n    diagnostics = []\\\\n    for call in calls:\\\\n        if not isinstance(call, dict):\\\\n            raise ValueError(\\\\\\\"Invalid call: not a dict\\\\\\\")\\\\n        required = ['call_id', 'loss_without_call', 'loss_with_call', 'prediction_tokens', 'parseable']\\\\n        for key in required:\\\\n            if key not in call:\\\\n                raise ValueError(f\\\\\\\"Missing field {key} in call\\\\\\\")\\\\n        call_id = call['call_id']\\\\n        loss_without = call['loss_without_call']\\\\n        loss_with = call['loss_with_call']\\\\n        pred_tokens = call['prediction_tokens']\\\\n        parseable = call['parseable']\\\\n        if not isinstance(loss_without, (int, float)):\\\\n            raise ValueError(\\\\\\\"loss_without_call must be numeric\\\\\\\")\\\\n        if not isinstance(loss_with, (int, float)):\\\\n            raise ValueError(\\\\\\\"loss_with_call must be numeric\\\\\\\")\\\\n        if not isinstance(pred_tokens, int) or pred_tokens < 1:\\\\n            raise ValueError(\\\\\\\"prediction_tokens must be positive integer\\\\\\\")\\\\n        if not isinstance(parseable, bool):\\\\n            raise ValueError(\\\\\\\"parseable must be boolean\\\\\\\")\\\\n        gain = loss_without - loss_with\\\\n        normalized_gain = gain / pred_tokens\\\\n        accepted_flag = parseable and normalized_gain >= threshold\\\\n        gain_rounded = round(gain, 8)\\\\n        norm_gain_rounded = round(normalized_gain, 8)\\\\n        diagnostics.append({\\\\n            'call_id': call_id,\\\\n            'gain': gain_rounded,\\\\n            'normalized_gain': norm_gain_rounded,\\\\n            'accepted': accepted_flag\\\\n        })\\\\n        if accepted_flag:\\\\n            accepted.append(call_id)\\\\n    return {\\\\n        'accepted': accepted,\\\\n        'diagnostics': diagnostics\\\\n    }\"}\n\nWe need to ensure there is no trailing whitespace. Also ensure 