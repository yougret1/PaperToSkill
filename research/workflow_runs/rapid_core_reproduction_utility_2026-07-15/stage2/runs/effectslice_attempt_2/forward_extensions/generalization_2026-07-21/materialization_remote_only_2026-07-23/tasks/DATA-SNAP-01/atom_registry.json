{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "DATA-SNAP-01",
  "atoms": [
    {
      "atom_id": "a_6fc6faf7a0196fc2",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 457,
        "byte_end": 535,
        "split_index": 0
      },
      "rendered_text": "Implement `idf_normalization_and_degree` through `solve(case)` for this bounded objective: Apply the registered sparse IDF scaling, row normalization, self-similarity removal, and degree construction without dense materialization.",
      "rendered_text_sha256": "a5c755a15fae2b03c119d3c72759ddf6f5563b63650fed66622cefdcc0a8e987"
    },
    {
      "atom_id": "a_947caf0c2182f027",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 457,
        "byte_end": 535,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: SnapATAC2 spectral preprocessing through degree construction; eigensolving is excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "effc102579d9e3496804bd5fc9728e57375b861b9b22a98a5020eb9be63651e0"
    },
    {
      "atom_id": "a_57756c33c5908d94",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 457,
        "byte_end": 535,
        "split_index": 2
      },
      "rendered_text": "Validate a nonempty rectangular matrix.",
      "rendered_text_sha256": "0a576b815327fc00f0e2e15289130ee7d00c0f17cc9bccd88bc87d47f15762b2"
    },
    {
      "atom_id": "a_c75464c321f024c2",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 457,
        "byte_end": 535,
        "split_index": 3
      },
      "rendered_text": "For each feature count rows with a nonzero entry.",
      "rendered_text_sha256": "319db2a32c84bcd80c5e4ad84ac5b489b56d0969219c6c822d197318936d064a"
    },
    {
      "atom_id": "a_e76b2785154759ef",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 457,
        "byte_end": 535,
        "split_index": 4
      },
      "rendered_text": "Compute IDF as log(1 + number_of_rows / (1 + document_frequency)).",
      "rendered_text_sha256": "5df19f6297c3ab4cd8d6ec5fcde6b0b0fbba97484b2bc3e6cf52f7fef6e14abf"
    },
    {
      "atom_id": "a_bbe48dcebfc97fd3",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 457,
        "byte_end": 535,
        "split_index": 5
      },
      "rendered_text": "Multiply every entry by its feature IDF and sum weighted rows for degree.",
      "rendered_text_sha256": "6263232effe8755b995f2561e97a2cde84d834a82dc9b215ec1b851b2200b0ef"
    },
    {
      "atom_id": "a_544f39ccafe07e30",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 552,
        "byte_end": 642,
        "split_index": 6
      },
      "rendered_text": "Round and return IDF, weighted matrix, and row degrees.",
      "rendered_text_sha256": "70c295d5888b4c1af36eea23adf5c466e8cb06a3d8ac62cf978fb361c8774869"
    },
    {
      "atom_id": "a_40ae7258e7d98536",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 552,
        "byte_end": 642,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: sparse_only, self_similarity_removed, finite_degree, numeric_tolerance.",
      "rendered_text_sha256": "46020a81be6967eee6e4e449fb9defe7975eae1abffb89888a395b47f038e719"
    },
    {
      "atom_id": "a_ed810319b9de5bb3",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 552,
        "byte_end": 642,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_143aed4392467a89",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 552,
        "byte_end": 642,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_5c238ded1b2797cb",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 552,
        "byte_end": 642,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_964effc8ffa9c680",
      "source_locator": {
        "document_sha256": "f791d597e6cebab63ddb9c3659b452002591dc9f5db9f3cf0addc36b5d860c21",
        "byte_start": 552,
        "byte_end": 642,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
