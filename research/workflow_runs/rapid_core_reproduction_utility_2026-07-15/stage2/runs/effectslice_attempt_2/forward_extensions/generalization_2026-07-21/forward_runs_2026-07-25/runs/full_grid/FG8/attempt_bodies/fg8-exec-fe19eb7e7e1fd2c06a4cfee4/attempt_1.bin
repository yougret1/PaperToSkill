(all_ids, key=lambda nid: (-node_map[nid]['depth'], nid))\n    queue = collections.deque(queue)\n    retained = set(all_ids)\n    visit_order = []\n    while queue:\n        nid = queue.popleft()\n        if nid not in retained:\n            continue\n        visit_order.append(nid)\n        node = node_map[nid]\n        is_leaf = True\n        for child_id in children.get(nid, []):\n            if child_id in retained:\n                is_leaf = False\n                break\n        if not is_leaf:\n            continue\n        if node.get('removable') and node.get('utility', 0) <= threshold:\n            retained.remove(nid)\n            parent_id = node.get('parent')\n            if parent_id is not None and parent_id in retained:\n                queue.append(parent_id)\n    retained_node_ids = [n['id'] for n in nodes if n['id'] in retained]\n    return {\n        \"retained_node_ids\": retained_node_ids,\n        \"visit_order\": visit_order\n    }\n\nNow, escape for JSON: replace backslash with double backslash, double quotes with \\\", newline with \\n.\n\nWe'll produce the JSON string.\n\nWe must ensure no trailing spaces.\n\nI'll write the final answer."},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":2127,"completion_tokens":6816,"total_tokens":8943,"prompt_tokens_details":{"cached_tokens":2048},"completion_tokens_details":{"reasoning_tokens":6397},"prompt_cache_hit_tokens":2048,"prompt_cache_miss_tokens":79},"system_fingerprint":"fp_8b330d02d0_prod0820_fp8_kvcache_20260402"}