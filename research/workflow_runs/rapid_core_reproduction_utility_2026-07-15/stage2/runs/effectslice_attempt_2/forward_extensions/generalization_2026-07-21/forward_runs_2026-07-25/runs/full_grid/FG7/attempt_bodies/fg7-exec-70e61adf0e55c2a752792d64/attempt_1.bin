 dict):\n            raise ValueError(\"each call must be dict\")\n        for key in ['call_id', 'start', 'end', 'score', 'replacement_tokens']:\n            if key not in c:\n                raise ValueError(f\"call missing {key}\")\n        if not isinstance(c['call_id'], str):\n            raise ValueError(\"call_id must be string\")\n        if not isinstance(c['start'], int) or not isinstance(c['end'], int):\n            raise ValueError(\"start and end must be ints\")\n        if c['start'] < 0 or c['end'] > len(tokens) or c['start'] >= c['end']:\n            raise ValueError(\"invalid span\")\n        if not isinstance(c['score'], (int, float)):\n            raise ValueError(\"score must be numeric\")\n        if not isinstance(c['replacement_tokens'], list) or not all(isinstance(t, str) for t in c['replacement_tokens']):\n            raise ValueError(\"replacement_tokens must be list of strings\")\n\n    # sort calls by descending score, ascending start, ascending call_id\n    sorted_calls = sorted(calls, key=lambda c: (-c['score'], c['start'], c['call_id']))\n    # greedy selection of non-overlapping spans\n    selected = []  # list of calls in order of selection? We'll store intervals as (start, end, call)\n    for call in sorted_calls:\n        s, e = call['start'], call['end']\n        # check overlap with already selected\n        overlap = False\n        for sel_call in selected:\n            ss, se = sel_call['start'], sel_call['end']\n            if s < se and e > ss:  # standard overlap condition\n                overlap = True\n                break\n        if not overlap:\n            selected.append(call)\n    # order accepted calls by source start\n    selected.sort(key=lambda c: c['start'])\n    # apply replacements from right to left\n    interleaved = list(tokens)\n    for call in reversed(selected):  # descending start order\n        s, e = call['start'], call['end']\n        repl = call['replacement_tokens']\n        interleaved[s:e] = repl  # slice assignment works\n    # generate output\n    selected_call_ids = [c['call_id'] for c in selected]\n    return {\n        \"selected_call_ids\": selected_call_ids,\n        \"tokens\": interleaved\n    }\n\nBut note: The output schema expects \"tokens\" as array of strings. Yes.\n\nNow we must output a JSON object with single key \"implementation\" containing Python source as string. Need to escape properly.\n\nAlso note: The function should not mutate case, we are not mutating.\n\nNow we produce final answer."},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":1654,"completion_tokens":2419,"total_tokens":4073,"prompt_tokens_details":{"cached_tokens":1536},"completion_tokens_details":{"reasoning_tokens":1789},"prompt_cache_hit_tokens":1536,"prompt_cache_miss_tokens":118},"system_fingerprint":"fp_8b330d02d0_prod0820_fp8_kvcache_20260402"}