{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "SE-PE-01",
  "atoms": [
    {
      "atom_id": "a_1b1886e02e07bd35",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 429,
        "byte_end": 519,
        "split_index": 0
      },
      "rendered_text": "Implement `grammar_guided_node_reduction` through `solve(case)` for this bounded objective: Reduce a registered parse tree through grammar-valid deletion and replacement candidates while preserving an interestingness oracle.",
      "rendered_text_sha256": "f51679ed252a3ba63aa00be9c42097256db51bd4fec015857140a080f03b2dab"
    },
    {
      "atom_id": "a_9fce5d8a70efc3ed",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 429,
        "byte_end": 519,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Perses syntax-guided reduction on a miniature grammar; parser generation and real compiler execution are excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "e1a4bc30c383aa0ec1549f3409d65dfdeed4a80003bd170ee16cdf7673854810"
    },
    {
      "atom_id": "a_1c10b5e0ec1653a2",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 429,
        "byte_end": 519,
        "split_index": 2
      },
      "rendered_text": "Consider deeper parse-tree nodes before shallower nodes.",
      "rendered_text_sha256": "65564ab9b647d15a102a1a833429ac8f31e9ba160e4226d2b4b16b2479c06ac0"
    },
    {
      "atom_id": "a_ec3c36c26587310f",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 429,
        "byte_end": 519,
        "split_index": 3
      },
      "rendered_text": "Never remove the root, a required symbol, or a node with retained children.",
      "rendered_text_sha256": "572170b3281207b10429dc16f2c4c57a7ec3d6b1fda2ece1d2ffcd9ad3159ef0"
    },
    {
      "atom_id": "a_0f7d5692075695e9",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 429,
        "byte_end": 519,
        "split_index": 4
      },
      "rendered_text": "Tentatively remove a node only if all required symbols remain represented.",
      "rendered_text_sha256": "48d942c263abb0baa0114e5c4a2b8f3939b4a341f9d2d7f5654928a6e5d2e23d"
    },
    {
      "atom_id": "a_ff2040fbed15a94f",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 429,
        "byte_end": 519,
        "split_index": 5
      },
      "rendered_text": "Use node ID as the stable tie break at equal depth.",
      "rendered_text_sha256": "dae22407c5c89b134b1f5127cadd32636d9ec147e2df3e3626a12e44cc0e5888"
    },
    {
      "atom_id": "a_269073ecbdad93bb",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 536,
        "byte_end": 613,
        "split_index": 6
      },
      "rendered_text": "Return sorted retained IDs and the actual removal order.",
      "rendered_text_sha256": "1721375c97ba64805e8a7b6704c32695cef35d09277894cc07fa691974f72c0e"
    },
    {
      "atom_id": "a_04f146b11c38407d",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 536,
        "byte_end": 613,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: grammar_valid, interestingness_preserved, registered_candidate_order, stable_ties.",
      "rendered_text_sha256": "1b70a79d33fb521a8749a5a787c9945f8ffe772cc347e93d6b8a1da6d52d6b64"
    },
    {
      "atom_id": "a_fe8ddfc5fcd41acf",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 536,
        "byte_end": 613,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_bd768b9769b482d4",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 536,
        "byte_end": 613,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_1a0c44331d856713",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 536,
        "byte_end": 613,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_2789c20edaf16fcb",
      "source_locator": {
        "document_sha256": "29a272182b97bf069ae0edb4180eda0bc7cc3655c3ddc120674088231cfc87ce",
        "byte_start": 536,
        "byte_end": 613,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
