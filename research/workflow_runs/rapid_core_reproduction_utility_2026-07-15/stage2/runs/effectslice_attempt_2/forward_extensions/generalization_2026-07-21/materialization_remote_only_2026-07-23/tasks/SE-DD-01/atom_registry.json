{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "SE-DD-01",
  "atoms": [
    {
      "atom_id": "a_48fcc19803b9382d",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 454,
        "byte_end": 538,
        "split_index": 0
      },
      "rendered_text": "Implement `ddmin_with_unresolved` through `solve(case)` for this bounded objective: Minimize a failure-inducing ordered configuration using the registered PASS, FAIL, and UNRESOLVED semantics and exact subset/complement schedule.",
      "rendered_text_sha256": "db7adeeb3ce5a4b7066d230500fe07d3b9ea119c316591608be33411b8a25833"
    },
    {
      "atom_id": "a_598fd5efa8641f31",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 454,
        "byte_end": 538,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: The ddmin procedure and outcome semantics; external test execution is replaced by a deterministic oracle fixture. Validate every required field before computing a result.",
      "rendered_text_sha256": "87ab106a634a3cb3404d4952747feb5b0bd5d50b8d2d1bfe5ddf0a1ebd6da0d3"
    },
    {
      "atom_id": "a_d1359e9ca1e44e54",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 454,
        "byte_end": 538,
        "split_index": 2
      },
      "rendered_text": "Require the initial configuration to produce FAIL.",
      "rendered_text_sha256": "681f002d866a3be87d8e72b571eab010e8fa03aca15846e9a0056910276697e8"
    },
    {
      "atom_id": "a_ccbe82f565ee480f",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 454,
        "byte_end": 538,
        "split_index": 3
      },
      "rendered_text": "Partition at the current granularity and test subsets before complements.",
      "rendered_text_sha256": "b272472319be2cfeb7364fbbfba973cf4824444474868fbe7866bf687f22d22f"
    },
    {
      "atom_id": "a_bc87bc79f35ea140",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 454,
        "byte_end": 538,
        "split_index": 4
      },
      "rendered_text": "Only FAIL permits reduction; PASS and UNRESOLVED do not.",
      "rendered_text_sha256": "d2e4df8c454bff669422f5efe7a1d19d30b72f8084ab394c741be77b23850ae0"
    },
    {
      "atom_id": "a_fcbc056b4a135769",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 454,
        "byte_end": 538,
        "split_index": 5
      },
      "rendered_text": "Decrease granularity after reduction and otherwise double it up to current size.",
      "rendered_text_sha256": "8424f73760e2bbbf5355d29ea941f4f01f6c0a4b312d4d2af3b4b0dc95083e82"
    },
    {
      "atom_id": "a_0e7aee9b867f2aa0",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 555,
        "byte_end": 641,
        "split_index": 6
      },
      "rendered_text": "Return the 1-minimal failure, test count, and terminal outcome.",
      "rendered_text_sha256": "999bce8fdc1ac211ca7912a268bf21c0da2a6e6d30f525b64bd46d285020f9a8"
    },
    {
      "atom_id": "a_4ad762f74d21756c",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 555,
        "byte_end": 641,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: one_minimal_result, unresolved_semantics, registered_call_order, termination.",
      "rendered_text_sha256": "1005cfd81942ff0ade229f60a8e6e577c21a3f86d229a4640e257b20db752d49"
    },
    {
      "atom_id": "a_d62ab5d7d6178296",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 555,
        "byte_end": 641,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_af08149d28dd2921",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 555,
        "byte_end": 641,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_fe29f73c2e2e4ed1",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 555,
        "byte_end": 641,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_af7677da06b74a36",
      "source_locator": {
        "document_sha256": "0a94297e4062f4f529df7bf2e9654ea7335bf47ee8fb4b5d39c05a7008d5c771",
        "byte_start": 555,
        "byte_end": 641,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
