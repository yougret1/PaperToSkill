         if forced[child_id]:\n                f = True\n        forced[node_id] = f\n    compute_forced(root_id)\n    # Symbol mapping\n    sym_to_bit = {sym: i for i, sym in enumerate(required_symbols)}\n    num_req = len(required_symbols)\n    full_mask = (1 << num_req) - 1\n    # DP storage\n    node_dp = {}\n    # DP recursion\n    def dp_node(node_id):\n        node = node_dict[node_id]\n        self_mask = 1 << sym_to_bit[node['symbol']] if node['symbol'] in sym_to_bit else 0\n        self_utility = node['utility']\n        # initialize dp\n        dp = {self_mask: (self_utility, tuple([None]*len(children[node_id])))}\n        # process children in order\n        child_list = children[node_id]\n        for idx, child_id in enumerate(child_list):\n            child_dp = dp_node(child_id)  # returns dp dict for child retained\n            new_dp = {}\n            child_forced = forced[child_id]\n            for mask, (val, dec_tuple) in dp.items():\n                if not child_forced:\n                    # prune option\n                    new_val = val\n                    new_dec = list(dec_tuple)\n                    new_dec[idx] = None  # already None but explicit\n                    new_mask = mask\n                    key = new_mask\n                    if key not in new_dp or new_val > new_dp[key][0]:\n                        new_dp[key] = (new_val"},"logprobs":null,"finish_reason":"length"}],"usage":{"prompt_tokens":1928,"completion_tokens":8192,"total_tokens":10120,"prompt_tokens_details":{"cached_tokens":1920},"completion_tokens_details":{"reasoning_tokens":8192},"prompt_cache_hit_tokens":1920,"prompt_cache_miss_tokens":8},"system_fingerprint":"fp_8b330d02d0_prod0820_fp8_kvcache_20260402"}