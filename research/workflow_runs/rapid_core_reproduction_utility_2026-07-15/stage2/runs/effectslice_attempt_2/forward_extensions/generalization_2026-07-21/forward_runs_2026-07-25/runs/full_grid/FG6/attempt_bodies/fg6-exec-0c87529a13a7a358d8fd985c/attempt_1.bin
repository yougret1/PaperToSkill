ter than sum of capacities {total_cap}\")\n    allocations = [seg['minimum'] for seg in segments]\n    remaining = budget - total_min\n    while remaining > 0:\n        best_idx = None\n        best_score = -float('inf')\n        for i, seg in enumerate(segments):\n            if allocations[i] < seg['capacity']:\n                score = seg['importance'] / (allocations[i] + 1)\n                if score > best_score:\n                    best_score = score\n                    best_idx = i\n        if best_idx is None:\n            raise ValueError(\"Cannot allocate further due to capacity constraints\")\n        allocations[best_idx] += 1\n        remaining -= 1\n    by_name = {segments[i]['name']: allocations[i] for i in range(n)}\n    total = sum(allocations)\n    return {'allocations': allocations, 'by_name': by_name, 'total': total}\n\nThat is the core. Need to handle case where segments might be empty? Not given, but could be; then budget must be 0. The code will work: if n=0, total_min=0, total_cap=0, budget must be 0, allocations empty list, by_name empty dict, total=0. That's fine.\n\nNow, we need to include the function definition and nothing else. The solve function must be defined.\n\nNow, produce the JSON.\n\nI will write:\n\n{\"implementation\": \"def solve(case):\\n    segments = case['segments']\\n    budget = case['budget']\\n    n = len(segments)\\n    if not isinstance(budget, int) or budget < 0:\\n        raise ValueError(\\\"Budget must be non-negative integer\\\")\\n    for seg in segments:\\n        for key in ('name', 'importance', 'minimum', 'capacity'):\\n            if key not in seg:\\n                raise ValueError(f\\\"Missing key {key} in segment\\\")\\n            if not isinstance(seg[key], int):\\n                raise ValueError(f\\\"{key} must be integer\\\")\\n        if seg['minimum'] < 0 or seg['capacity'] < 0:\\n            raise ValueError(\\\"Minimum and capacity must be non-negative\\\")\\n        if seg['minimum'] > seg[