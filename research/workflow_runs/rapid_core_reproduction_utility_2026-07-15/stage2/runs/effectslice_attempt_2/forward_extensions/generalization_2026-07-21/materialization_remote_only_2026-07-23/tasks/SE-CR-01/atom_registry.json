{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "SE-CR-01",
  "atoms": [
    {
      "atom_id": "a_586a74da3307af88",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 421,
        "byte_end": 492,
        "split_index": 0
      },
      "rendered_text": "Implement `pass_scheduler_fixed_point` through `solve(case)` for this bounded objective: Run an ordered transformation-pass schedule to a fixed point with registered restart, cache, and interestingness rules over a miniature program state.",
      "rendered_text_sha256": "4290122d8f825cec57fe93de5683ed3d2ee73b3490ef5781bb9563d2b2d8d9c5"
    },
    {
      "atom_id": "a_24455894c57fafe5",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 421,
        "byte_end": 492,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: C-Reduce pass orchestration; real compilers and external reducers are excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "23f571d41716ec0a46fadd9acfcdc2ecdb0984e86b8690a2fdec1614d1dec44f"
    },
    {
      "atom_id": "a_8c54b8926227f443",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 421,
        "byte_end": 492,
        "split_index": 2
      },
      "rendered_text": "Apply passes in their registered order.",
      "rendered_text_sha256": "21999d75aa2472f346f7241d5e961e0c3af60ad38784f547260ecc832106f332"
    },
    {
      "atom_id": "a_012eb86bfee25ff8",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 421,
        "byte_end": 492,
        "split_index": 3
      },
      "rendered_text": "Each pass performs at most its first eligible rewrite per sweep.",
      "rendered_text_sha256": "c119c1b440ac6a9388a22b3ab70a748a268450a5fd4af38f02854fdfb5ec6363"
    },
    {
      "atom_id": "a_fed6b12ea84f6e2f",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 421,
        "byte_end": 492,
        "split_index": 4
      },
      "rendered_text": "Record only passes that change the artifact.",
      "rendered_text_sha256": "d6724539461d5d5dceb74743e0d096ec331808e4734f8a71df92524701b77335"
    },
    {
      "atom_id": "a_6f2a7bf4e8ecc2e5",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 421,
        "byte_end": 492,
        "split_index": 5
      },
      "rendered_text": "Repeat full sweeps until none changes or the round budget is consumed.",
      "rendered_text_sha256": "ad39e58beb5f9b58a8788fa6d8c4768c6ef271d7763f337a5c0651b057d28eea"
    },
    {
      "atom_id": "a_4183198943d6b358",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 509,
        "byte_end": 583,
        "split_index": 6
      },
      "rendered_text": "Return the artifact, application trace, and fixed-point flag.",
      "rendered_text_sha256": "3d19be6d24caf26c4dac17f2f7b1a26bef73e24abd2caf69a08d0d4c823db9f2"
    },
    {
      "atom_id": "a_1c3485333e99e962",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 509,
        "byte_end": 583,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: interestingness_preserved, restart_policy, cache_semantics, fixed_point.",
      "rendered_text_sha256": "4ca2b99efba0154a71e5797bc3ce29757841045771370b7b72d4f6ee4b1dd436"
    },
    {
      "atom_id": "a_5ccb1f6dba9e2bb1",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 509,
        "byte_end": 583,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_4d71716d7b1bc574",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 509,
        "byte_end": 583,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_228dbda89cc203da",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 509,
        "byte_end": 583,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_19a5ece6ac960ee4",
      "source_locator": {
        "document_sha256": "6b66f6bd89d11561bea51f946f8e5221fb115bc74beefe807d53e3ddc8e79ca3",
        "byte_start": 509,
        "byte_end": 583,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
