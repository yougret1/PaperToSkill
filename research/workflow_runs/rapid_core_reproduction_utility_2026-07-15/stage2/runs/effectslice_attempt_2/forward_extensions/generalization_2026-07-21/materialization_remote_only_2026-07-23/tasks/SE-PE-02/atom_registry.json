{
  "schema_version": "effectslice-fg1-atom-registry.v1",
  "task_id": "SE-PE-02",
  "atoms": [
    {
      "atom_id": "a_d51cc49298ee4b65",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 429,
        "byte_end": 503,
        "split_index": 0
      },
      "rendered_text": "Implement `parse_tree_reduction_queue` through `solve(case)` for this bounded objective: Maintain and update the syntax-guided reduction work queue across accepted and rejected tree rewrites without revisiting invalidated nodes.",
      "rendered_text_sha256": "32e192a096469e9ff089f1a8f635f426d3f4f282b20043d869bab5b2245f1c19"
    },
    {
      "atom_id": "a_fb553545b5c5ea47",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 429,
        "byte_end": 503,
        "split_index": 1
      },
      "rendered_text": "Stay inside this mechanism boundary: Queue, invalidation, and normalization behavior around grammar-guided reduction; external build systems are excluded. Validate every required field before computing a result.",
      "rendered_text_sha256": "cec2dbe9c2cf9ff9364c37b3d2dfd66de31f20541b06dcc2fe31f19ef95c5b18"
    },
    {
      "atom_id": "a_62d0e413865b6aae",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 429,
        "byte_end": 503,
        "split_index": 2
      },
      "rendered_text": "Initialize a queue in descending depth and stable node-ID order.",
      "rendered_text_sha256": "d1ec430b3ff789e8ef44c865125244afd39f3ce90977b70f000c76902820517f"
    },
    {
      "atom_id": "a_353f8266351d92ae",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 429,
        "byte_end": 503,
        "split_index": 3
      },
      "rendered_text": "Skip nodes already removed.",
      "rendered_text_sha256": "179b5d4e01193423cdd74cb0c1616083778bc1cda513c60ffe229b597c2786b2"
    },
    {
      "atom_id": "a_ffd07b07bb2270a9",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 429,
        "byte_end": 503,
        "split_index": 4
      },
      "rendered_text": "Remove only a removable leaf whose utility is at most the threshold.",
      "rendered_text_sha256": "1745d8fd9eea870933fd4325ef2dd8da3d560908ff48ad5bf0fb62dbe353beca"
    },
    {
      "atom_id": "a_9e3b1f4ca3da877b",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 429,
        "byte_end": 503,
        "split_index": 5
      },
      "rendered_text": "After removal enqueue its retained parent for reconsideration.",
      "rendered_text_sha256": "74af9abc980d9d3380ca68412f8508455eb1d3260df515a034831b50e1fe488a"
    },
    {
      "atom_id": "a_e835590599b9ab03",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 520,
        "byte_end": 603,
        "split_index": 6
      },
      "rendered_text": "Return retained IDs and the complete visit order.",
      "rendered_text_sha256": "492ffa6ae3aa9415b36cf25c914e6e3502e0d797b87ef97cfa7023ed372bb3c0"
    },
    {
      "atom_id": "a_da90cbd778f76b45",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 520,
        "byte_end": 603,
        "split_index": 7
      },
      "rendered_text": "Treat these registered properties as hard contracts rather than soft preferences: no_invalidated_revisit, queue_order, normalized_output, termination.",
      "rendered_text_sha256": "24a78218f4a8d2471aa490b4498d106dcf691542ca3b75818465bf91c8198744"
    },
    {
      "atom_id": "a_aab5e5dc87627257",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 520,
        "byte_end": 603,
        "split_index": 8
      },
      "rendered_text": "Use only quantities present in the case payload. Do not call a language model, network service, random generator, wall clock, or environment-dependent resource.",
      "rendered_text_sha256": "bb651964decf660706e6b02a72268f4df8c9cfde1515a5b2325af47505fa92df"
    },
    {
      "atom_id": "a_693431abc1d103cc",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 520,
        "byte_end": 603,
        "split_index": 9
      },
      "rendered_text": "Preserve every source identifier needed to audit the decision, and compute aggregate values from the returned primitive decisions rather than from a second approximation.",
      "rendered_text_sha256": "d6b67e3cd654a61b271920e037938dc07550072b2334416f32ed86b0bd787362"
    },
    {
      "atom_id": "a_dfb6e333c936209a",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 520,
        "byte_end": 603,
        "split_index": 10
      },
      "rendered_text": "Do not mutate the input. All ranking and traversal ties use the source position or identifier specified above; never depend on hash-map iteration.",
      "rendered_text_sha256": "67186a43fcf39ec73132c8ab7ad1387670a6fd7d5e511075a50faf835be9e19a"
    },
    {
      "atom_id": "a_12a01dad541c808e",
      "source_locator": {
        "document_sha256": "41ba2872b4f837f8a14cd149f95924b5f751b470d3f2283df260930adeaaced1",
        "byte_start": 520,
        "byte_end": 603,
        "split_index": 11
      },
      "rendered_text": "Return only JSON-serializable values with the exact named fields. Raise ValueError for an infeasible or structurally invalid case instead of silently repairing it.",
      "rendered_text_sha256": "5f164e6574e6f249d67514f65fc480435c9b737c31ea45311cd04552b1d13fcb"
    }
  ]
}
