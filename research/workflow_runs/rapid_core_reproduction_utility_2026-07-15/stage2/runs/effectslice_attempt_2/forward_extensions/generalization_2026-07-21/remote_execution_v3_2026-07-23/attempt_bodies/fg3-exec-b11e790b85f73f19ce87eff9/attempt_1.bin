actly one JSON object with key \"implementation\". No extra text.\n\nLet's write the code."},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":1153,"completion_tokens":1312,"total_tokens":2465,"prompt_tokens_details":{"cached_tokens":1152},"completion_tokens_details":{"reasoning_tokens":842},"prompt_cache_hit_tokens":1152,"prompt_cache_miss_tokens":1},"system_fingerprint":"fp_8b330d02d0_prod0820_fp8_kvcache_20260402"}