ng > 0:\\\\n        best_idx = -1\\\\n        best_priority = -1.0\\\\n        for i, seg in enumerate(segments):\\\\n            if alloc[i] >= seg['capacity']:\\\\n                continue\\\\n            priority = seg['importance'] / (alloc[i] + 1)\\\\n            if priority > best_priority:\\\\n                best_priority = priority\\\\n                best_idx = i\\\\n            elif priority == best_priority and best_idx != -1 and i < best_idx:\\\\n                best_idx = i\\\\n        if best_idx == -1:\\\\n            raise ValueError('Cannot allocate remaining budget (capacity exhausted)')\\\\n        alloc[best_idx] += 1\\\\n        remaining -= 1\\\\n    by_name = {}\\\\n    for i, seg in enumerate(segments):\\\\n        by_name[seg['name']] = alloc[i]\\\\n    total = sum(alloc)\\\\n    return {'allocations': alloc, 'by_name': by_name, 'total': total}\"\n\nNow we need to put this inside {\"implementation\": \"...\"}. So the final JSON object.\n\nLet me verify: The source contains single quotes. In the JSON string, we have single quotes, which are fine. We have \\n sequences that are now \\\\n. Good.\n\nNow output.\n\nI'll write the whole JSON response.\n\nNote: The response must be exactly one JSON object, no extra whitespace."},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":1499,"completion_tokens":5822,"total_tokens":7321,"prompt_tokens_details":{"cached_tokens":1408},"completion_tokens_details":{"reasoning_tokens":5232},"prompt_cache_hit_tokens":1408,"prompt_cache_miss_tokens":91},"system_fingerprint":"fp_8b330d02d0_prod0820_fp8_kvcache_20260402"}