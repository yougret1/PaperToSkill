
{"id":"b6b307e7-1e3e-407a-8c09-08c6d2b62a08","object":"chat.completion","created":1784810478,"model":"deepseek-v4-flash","choices":[{"index":0,"message":{"role":"assistant","content":"{\n  \"implementation\": \"def solve(case):\\n    if not isinstance(case, dict) or 'capacity' not in case or 'trials' not in case:\\n        raise ValueError(\\\"Invalid case: missing required fields\\\")\\n    capacity = case['capacity']\\n    if not isinstance(capacity, int) or capacity < 0:\\n        raise ValueError(\\\"Capacity must be a non-negative integer\\\")\\n    trials = case['trials']\\n    if not isinstance(trials, list):\\n        raise ValueError(\\\"Trials must be a list\\\")\\n    memory = []  # each entry: dict with index, signature, reflection, success\\n    for idx, trial in enumerate(trials):\\n        if not isinstance(trial, dict) or 'signature' not in trial or 'reflection' not in trial or 'success' not in trial:\\n            raise ValueError(f\\\"Trial {idx} missing required fields\\\")\\n        sig = trial['signature']\\n        ref = trial['reflection']\\n        succ = trial['success']\\n        if not succ:  # failure\\n            found = False\\n            for entry in memory:\\n                if entry['signature'] == sig and not entry['success']:\\n                    entry['reflection'] = ref\\n                    entry['index'] = idx\\n                    found = True\\n                    break\\n            if not found:\\n                memory.append({'index': idx, 'signature': sig, 'reflection': ref, 'success': False})\\n        else:  # success\\n            memory.append({'index': idx, 'signature': sig, 'reflection': ref, 'success': True})\\n        # enforce capacity\\n        if len(memory) > capacity:\\n            memory.sort(key=lambda e: (e['success'], -e['index'], e['signature']))\\n            memory = memory[:capacity]\\n    # restore chronological order\\n    memory.sort(key=lambda e: e['index'])\\n    # return only signature and 