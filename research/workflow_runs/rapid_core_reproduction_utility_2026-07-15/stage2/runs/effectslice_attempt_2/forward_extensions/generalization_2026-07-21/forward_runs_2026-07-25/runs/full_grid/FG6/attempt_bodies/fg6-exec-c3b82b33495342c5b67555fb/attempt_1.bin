xcept standard library. We may use math? Not needed.\n\nWe'll include validation.\n\nLet's write the code.\n\nImportant: The function signature: solve(case) returns a dict.\n\nImplementation:\n\n```python\ndef solve(case):\n    # Validate top-level keys\n    if 'threshold' not in case:\n        raise ValueError(\"Missing 'threshold' in case\")\n    if 'calls' not in case:\n        raise ValueError(\"Missing 'calls' in case\")\n    threshold = case['threshold']\n    if not isinstance(threshold, (int, float)):\n        raise ValueError(\"threshold must be a number\")\n    calls = case['calls']\n    if not isinstance(calls, list):\n        raise ValueError(\"calls must be a list\")\n    accepted_ids = []\n    diagnostics = []\n    for call in calls:\n        if not isinstance(call, dict):\n            raise ValueError(\"each call must be a dict\")\n        required = ['call_id', 'loss_without_call', 'loss_with_call', 'prediction_tokens', 'parseable']\n        for key in required:\n            if key not in call:\n                raise ValueError(f\"Missing '{key}' in call\")\n        call_id = call['call_id']\n        if not isinstance(call_id, str):\n            raise ValueError(\"call_id must be string\")\n        loss_without = call['loss_without_call']\n        loss_with = call['loss_with_call']\n        if not isinstance(loss_without, (int, float)):\n            raise ValueError(\"loss_without_call must be number\")\n        if not isinstance(loss_with, (int, float)):\n            raise ValueError(\"loss_with_call must be number\")\n        tokens = call['prediction_tokens']\n        if not isinstance(tokens, int) or tokens < 1:\n            raise ValueError(\"prediction_tokens must be a positive integer\")\n        parseable = call['parseable']\n        if not isinstance(parseable, bool):\n            raise ValueError(\"parseable must be boolean\")\n        gain = loss_without - loss_with\n        normalized_gain = gain / tokens\n        accepted = parseable and 