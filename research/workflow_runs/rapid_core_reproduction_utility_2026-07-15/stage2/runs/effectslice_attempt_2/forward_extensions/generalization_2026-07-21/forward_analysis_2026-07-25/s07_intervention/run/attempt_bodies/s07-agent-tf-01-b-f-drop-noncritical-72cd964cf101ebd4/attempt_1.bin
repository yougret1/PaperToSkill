not in case:\n        raise ValueError(\"case missing threshold or calls\")\n    threshold = case['threshold']\n    if not isinstance(threshold, (int, float)):\n        raise ValueError(\"threshold must be numeric\")\n    calls = case['calls']\n    if not isinstance(calls, list):\n        raise ValueError(\"calls must be a list\")\n    \n    accepted_call_ids = []\n    diagnostics = []\n    \n    for call in calls:\n        if not isinstance(call, dict):\n            raise ValueError(\"each call must be a dict\")\n        required_keys = ['call_id', 'loss_without_call', 'loss_with_call', 'prediction_tokens', 'parseable']\n        for k in required_keys:\n            if k not in call:\n                raise ValueError(f\"call missing key {k}\")\n        call_id = call['call_id']\n        if not isinstance(call_id, str):\n            raise ValueError(\"call_id must be string\")\n        loss_without = call['loss_without_call']\n        loss_with = call['loss_with_call']\n        prediction_tokens = call['prediction_tokens']\n        parseable = call['parseable']\n        # Validate types\n        if not isinstance(loss_without, (int, float)):\n            raise ValueError(\"loss_without_call must be numeric\")\n        if not isinstance(loss_with, (int, float)):\n            raise ValueError(\"loss_with_call must be numeric\")\n        if not isinstance(prediction_tokens, int) or prediction_tokens <= 0:\n            raise ValueError(\"prediction_tokens must be positive int\")\n        if not isinstance(parseable, bool):\n            raise ValueError(\"parseable must be bool\")\n        \n        gain = loss_without - loss_with\n        normalized_gain = gain / prediction_tokens\n        accepted = parseable and (normalized_gain >= threshold)\n        if accepted:\n            accepted_call_ids.append(call_id)\n        diagnostics.append({\n            \"accepted\": accepted,\n            \"call_id\": call_id,\n            \"normalized_gain\": normalized_gain\n        